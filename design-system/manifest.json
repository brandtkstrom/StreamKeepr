  "libraries": [],
  "components": [
    {
      "name": "AppShell",
      "group": "Layout",
      "summary": "The full StreamKeepr screen: top app bar, library drawer on the left, and the player column with the stats panel and recording details stacked beneath the play…"
    },
    {
      "name": "Buttons",
      "group": "Actions",
      "summary": "Material 3 buttons, icon buttons and filter chips used across StreamKeepr."
    },
    {
      "name": "LibraryDrawer",
      "group": "Navigation",
      "summary": "The left pane listing recordings grouped by streamer, newest first at every level."
    },
    {
      "name": "RecordingDetails",
      "group": "Playback",
      "summary": "A collapsible card under the stats panel with the recording's title, streamer, category, size and the actions for it."
    },
    {
      "name": "StatsPanel",
      "group": "Playback",
      "summary": "A collapsible \"Stats for nerds\" panel directly under the player, showing playback (video) and network statistics side by side."
    },
    {
      "name": "StatusChip",
      "group": "Status",
      "summary": "Small uppercase chips that state a recording's condition in words, with colour as a second cue."
    },
    {
      "name": "TopAppBar",
      "group": "Layout",
      "summary": "The 64px bar across the top: menu (drawer) toggle, the StreamKeepr wordmark, recording search, disk space, schedule, settings and the Twitch auth control."
    },
    {
      "name": "TwitchAuthButton",
      "group": "Actions",
      "summary": "The control that connects a Twitch account, enabling features that need it (following list, live notifications, auto-record of followed channels, subscriber-on…"
    },
    {
      "name": "VideoPlayer",
      "group": "Playback",
      "summary": "The primary component: a 16:9 HLS player with an overlay title strip and a control bar."
    }
  ],
