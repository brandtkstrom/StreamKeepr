  "manifestVersion": 3,
  "name": "StreamKeepr",
  "namespace": "StreamKeepr",
  "files": [
    "components/AppShell/README.md",
    "components/Buttons/README.md",
    "components/LibraryDrawer/README.md",
    "components/RecordingDetails/README.md",
