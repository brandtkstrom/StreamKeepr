{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Twitch": {
    "PollIntervalSeconds": 30,
    "PollIntervalWithEventSubSeconds": 300,
    "EventSubTransport": "WebSocket",
    "Channels": []
  },
  "Recorder": {
    "Quality": "best",
    "SegmentSeconds": 6,
    "HealthyPartSeconds": 30
  },
  "Chat": {
    "Enabled": false,
    "LeadInSeconds": 12,
    "BucketMinutes": 10,
    "MaxChannels": 100,
    "JoinIntervalMs": 600,
    "MaxBytesPerSession": 536870912,
    "PurgeDeletedText": "Off"
  },
  "Storage": {
    "RecordingsRoot": "/recordings",
    "MinFreeGb": 10
  },
  "Auth": {
    "AllowedTwitchLogins": []
  },
  "Hosting": {
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
