{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "File": {
      "Enabled": true,
      "FileSizeLimitBytes": 50000000,
      "RetainedFileCountLimit": 7
    },
    "Destructure": [
      { "Name": "ToMaximumDepth", "Args": { "maximumDestructuringDepth": 4 } },
      { "Name": "ToMaximumStringLength", "Args": { "maximumStringLength": 1024 } },
      { "Name": "ToMaximumCollectionCount", "Args": { "maximumCollectionCount": 32 } }
    ]
  },
  "Telemetry": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Links": {
    "GitHub": "https://github.com/brandtkstrom/StreamKeepr",
    "Twitch": "https://www.twitch.tv/"
  },
  "Twitch": {
    "PollIntervalSeconds": 30,
    "PollIntervalWithEventSubSeconds": 300,
    "EventSubTransport": "WebSocket",
    "Channels": []
  },
  "Recorder": {
    "Quality": "best",
    "SegmentSeconds": 6,
    "HealthyPartSeconds": 30
  },
  "Chat": {
    "Enabled": false,
    "LeadInSeconds": 12,
    "BucketMinutes": 10,
    "MaxChannels": 100,
    "JoinIntervalMs": 600,
    "MaxBytesPerSession": 536870912,
    "PurgeDeletedText": "Off",
    "Emotes": {
      "Bttv": {
        "Enabled": false
      }
    }
  },
  "Storage": {
    "RecordingsRoot": "/recordings",
    "MinFreeGb": 10
  },
  "Auth": {
    "AllowedTwitchLogins": []
  },
  "Hosting": {
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
