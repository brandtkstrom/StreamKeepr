{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Twitch": {
    "PollIntervalSeconds": 30,
    "PollIntervalWithEventSubSeconds": 300,
    "Channels": []
  },
  "Recorder": {
    "Quality": "best",
    "SegmentSeconds": 6,
    "HealthyPartSeconds": 30
  },
  "Storage": {
    "RecordingsRoot": "/recordings",
    "MinFreeGb": 10
  },
  "Auth": {
    "AllowedTwitchLogins": []
  },
  "Hosting": {
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
