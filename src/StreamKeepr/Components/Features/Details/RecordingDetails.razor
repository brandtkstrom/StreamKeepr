@using System.Globalization
@using StreamKeepr.Infrastructure.Storage
@using System.Security.Claims
@implements IAsyncDisposable
@inject UiPreferences Preferences
@inject ViewerClock Clock
@inject SnackbarService Snackbars
@inject PlayerBridge Bridge
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<RecordingDetails> Logger
@inject IExportService Exports
@inject IChannelsView Channels
@inject IRecordingAdmin Admin

@* Spec: docs/details-auth-settings-contract.md §§2–4; player contract §11. The same
   component instance survives recording swaps because Home keeps it in one slot. *@
<Collapsible Open="@Preferences.DetailsOpen"
             OnToggle="ToggleAsync"
             data-recording-details="true">
    <Header>
        <h2>Recording details</h2>
        <span class="hint" data-details-date>@StartLabel</span>
    </Header>
    <ChildContent>
        <div class="sk-details-body">
            <div class="sk-details-title">
                <h3 data-details-title>@Recording.Title</h3>
                <div class="sk-actions">
                    @if (IsLive)
                    {
                        <RequiresTwitch>
                            <Button Variant="ButtonVariant.Outlined"
                                    Disabled="@_stopping"
                                    OnClick="OpenStopDialog"
                                    data-stop-recording="true">
                                <Icon Name="pause" Size="IconSize.Small" />
                                Stop recording
                            </Button>
                        </RequiresTwitch>
                    }
                    <Button Variant="ButtonVariant.Outlined"
                            OnClick="CopyPlaylistAsync"
                            data-copy-playlist="true">
                        <Icon Name="content_copy" Size="IconSize.Small" />
                        Copy playlist URL
                    </Button>
                    <RequiresTwitch>
                        @if (ExportBlockedReason is { } reason)
                        {
                            <Tooltip Text="@reason" tabindex="0">
                                <Button Variant="ButtonVariant.Tonal" Disabled="true" data-export="true">
                                    <Icon Name="movie" Size="IconSize.Small" />
                                    Export MP4
                                </Button>
                            </Tooltip>
                        }
                        else
                        {
                            <Button Variant="ButtonVariant.Tonal"
                                    Disabled="@(_job?.IsActive == true || _starting)"
                                    OnClick="StartExportAsync"
                                    data-export="true">
                                <Icon Name="movie" Size="IconSize.Small" />
                                Export MP4
                            </Button>
                        }
                    </RequiresTwitch>
                    <RequiresTwitch>
                        @if (DeleteBlockedReason is { } deleteReason)
                        {
                            <Tooltip Text="@deleteReason" tabindex="0" data-delete-blocked>
                                <IconButton Icon="delete"
                                            Label="Delete recording"
                                            Disabled="true"
                                            data-delete />
                            </Tooltip>
                        }
                        else
                        {
                            <IconButton Icon="delete"
                                        Label="Delete recording"
                                        OnClick="OpenDeleteDialog"
                                        data-delete />
                        }
                    </RequiresTwitch>
                </div>
            </div>

            <div class="sk-details-meta">
                <span class="who">
                    <Avatar Name="@Recording.StreamerLogin" Tone="AvatarTone.Tertiary" />
                    <span data-details-streamer>@Recording.StreamerLogin</span>
                </span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-category>@CategoryLabel</span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-start>@StartLabel</span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-counts>
                    <span data-details-segments>@Count(Recording.SegmentCount, "segment")</span>
                    <span aria-hidden="true"> · </span>
                    <span data-details-parts>@Count(Recording.PartCount, "part")</span>
                    @if (ShowSize)
                    {
                        <span aria-hidden="true"> · </span>
                        <span data-details-size>@Format.Bytes(Recording.SizeBytes)</span>
                    }
                </span>
            </div>

            @if (_job is { } job)
            {
                int percent = (int)Math.Round(Math.Clamp(job.Progress, 0, 1) * 100);
                <div class="sk-export-row" data-export-row="@job.State">
                    <Icon Name="@ExportIcon(job.State)" Size="IconSize.Small" />
                    @* State changes are announced; per-percent changes are not. *@
                    <span class="text" role="status">@ExportText(job)</span>
                    @if (job.State == ExportState.Running)
                    {
                        <span class="pct" aria-hidden="true">@percent%</span>
                        <div class="sk-export-progress"
                             role="progressbar"
                             aria-label="Export progress"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@percent"
                             aria-valuetext="@($"{percent}%")">
                            <i style="width:@(percent)%"></i>
                        </div>
                    }
                    @if (job.IsActive)
                    {
                        <RequiresTwitch>
                            <Button Variant="ButtonVariant.Text"
                                    Disabled="@_cancelling"
                                    OnClick="CancelExportAsync"
                                    data-export-cancel="true">
                                Cancel
                            </Button>
                        </RequiresTwitch>
                    }
                    @if (CanRetry(job))
                    {
                        <RequiresTwitch>
                            <Button Variant="ButtonVariant.Text"
                                    Disabled="@_starting"
                                    OnClick="StartExportAsync"
                                    data-export-retry="true">
                                <Icon Name="refresh" Size="IconSize.Small" />
                                Retry
                            </Button>
                        </RequiresTwitch>
                    }
                    @if (job.State == ExportState.Succeeded)
                    {
                        <RequiresTwitch>
                            <a class="sk-btn tonal"
                               href="@StreamKeepr.Hosting.ExportDownloadEndpoint.For(job.Id)"
                               download="@(job.FileName ?? "")"
                               data-enhance-nav="false"
                               data-export-download="true">
                                <Icon Name="download" Size="IconSize.Small" />
                                Download
                            </a>
                        </RequiresTwitch>
                    }
                </div>
            }

            @{
                IReadOnlyList<Chapter> chapters = VisibleChapters;
            }
            @if (chapters.Count > 0)
            {
                <div class="sk-chapters" role="group" aria-label="Chapters">
                    @for (int index = 0; index < chapters.Count; index++)
                    {
                        Chapter chapter = chapters[index];
                        <button type="button"
                                class="sk-chapter"
                                @key="ChapterKey(index, chapter)"
                                data-chapter="@ChapterOffset(chapter)"
                                data-chapter-key="@ChapterKey(index, chapter)"
                                @onclick="() => SeekToChapterAsync(chapter)">
                            <span class="sk-visually-hidden">Seek to </span>
                            <span class="time">@Format.Timecode(chapter.StartSeconds)</span>
                            <span class="title">@chapter.Title</span>
                            @if (!string.IsNullOrWhiteSpace(chapter.Game))
                            {
                                <span class="game">@chapter.Game</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </ChildContent>
</Collapsible>

<Dialog Open="@_stopOpen"
        OpenChanged="OnStopOpenChanged"
        Title="@($"Stop recording for {Recording.StreamerLogin}?")"
        aria-busy="@(_stopping ? "true" : null)"
        data-stop-dialog>
    <ChildContent>
        <p>The current capture is finalized, and the channel stays paused until you resume.</p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Text"
                Disabled="@_stopping"
                OnClick="CancelStop"
                data-stop-cancel>Cancel</Button>
        <Button Variant="ButtonVariant.Danger"
                Disabled="@_stopping"
                OnClick="ConfirmStopAsync"
                data-stop-confirm>Stop recording</Button>
    </Actions>
</Dialog>
<Dialog Open="@_deleteOpen"
        OpenChanged="OnDeleteOpenChanged"
        Title="Delete recording?"
        aria-busy="@(_deleting ? "true" : null)"
        data-delete-dialog>
    <ChildContent>
        <p class="sk-error-banner"
           role="@(_deleteError is null ? null : "alert")"
           data-delete-banner>
            <b>@Recording.Title — @Recording.StreamerLogin</b><br />
            @(_deleteError ?? "The files and watch progress are removed permanently.")
        </p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Text"
                Disabled="@_deleting"
                OnClick="CancelDelete"
                data-delete-cancel>
            Cancel
        </Button>
        <Button Variant="ButtonVariant.Danger"
                Disabled="@(_deleting || DeleteBlockedReason is not null)"
                OnClick="ConfirmDeleteAsync"
                data-delete-confirm>
            Delete
        </Button>
    </Actions>
</Dialog>

@code {
    private const string ModulePath = "./Components/Features/Details/RecordingDetails.razor.js";

    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Jobs this card started or saw active; each finished one raises one snackbar, even after
    // the card has moved on to another recording.
    private readonly HashSet<string> _watching = new(StringComparer.Ordinal);
    private ExportJob? _job;
    private string? _jobRecordingId;
    private const string DeleteSessionEnded =
        "Your Twitch session ended. Reconnect to delete recordings.";

    private bool _starting;
    private bool _cancelling;
    private bool _stopOpen;
    private bool _stopping;
    private string? _stopRecordingId;
    private bool _deleteOpen;
    private bool _deleting;
    private string? _deleteError;
    private string? _deleteRecordingId;

    private bool IsLive =>
        Recording.State is RecordingState.Recording or RecordingState.Reconnecting;

    private bool IsIncompatible =>
        _job is { State: ExportState.Failed, Error: ExportService.IncompatibleParts };

    // Why Export MP4 is disabled with a tooltip; null when the button is live.
    private string? ExportBlockedReason =>
        IsLive ? "Available when the recording finishes"
        : IsIncompatible ? "Its parts use different video settings, so one MP4 is not possible"
        : null;

    // Why Delete is disabled with a tooltip; null when the icon button is live.
    private string? DeleteBlockedReason =>
        IsLive ? "Available when the recording finishes"
        : _job?.IsActive == true ? "Cancel the export before deleting"
        : null;

    private bool ShowSize =>
        Recording.State is RecordingState.Partial or RecordingState.Saved;

    private string CategoryLabel =>
        string.IsNullOrWhiteSpace(Recording.Category) ? "No category" : Recording.Category;

    private string StartLabel =>
        Clock.ToLocal(Recording.StartedAt)
            .ToString("ddd, MMM d, yyyy · h:mm tt", CultureInfo.InvariantCulture);

    private string AbsolutePlaylistUrl =>
        new Uri(new Uri(Navigation.BaseUri), Recording.PlaylistUrl).AbsoluteUri;

    private IReadOnlyList<Chapter> VisibleChapters =>
        Recording.Chapters
            .Where(chapter =>
                double.IsFinite(chapter.StartSeconds) &&
                chapter.StartSeconds >= 0 &&
                (Recording.DurationSec <= 0 || chapter.StartSeconds <= Recording.DurationSec))
            .ToArray();

    protected override void OnInitialized()
    {
        Preferences.Changed += OnPreferencesChanged;
        Clock.Changed += OnClockChanged;
        Exports.Changed += OnExportsChanged;
    }

    protected override void OnParametersSet()
    {
        if (_stopRecordingId != Recording.Id)
        {
            _stopRecordingId = Recording.Id;
            _stopOpen = false;
        }

        if (!IsLive)
            _stopOpen = false;

        // A different recording never keeps the previous recording's confirm dialog open.
        if (_deleteRecordingId != Recording.Id)
        {
            _deleteRecordingId = Recording.Id;
            _deleteOpen = false;
            _deleteError = null;
        }

        // A different recording never shows the previous recording's job.
        if (_jobRecordingId != Recording.Id)
            RefreshExport();
    }

    private void RefreshExport()
    {
        _jobRecordingId = Recording.Id;
        _job = Exports.FindByRecording(Recording.Id);
        if (_job is { IsActive: true })
            _watching.Add(_job.Id);
    }

    private void AnnounceFinishedExports()
    {
        foreach (string id in _watching.ToArray())
        {
            if (Exports.Find(id) is not { } job)
            {
                _watching.Remove(id);
                continue;
            }

            if (job.IsActive)
                continue;

            _watching.Remove(id);
            if (job.State == ExportState.Succeeded)
                Snackbars.Show("Export ready");
            else if (job.State == ExportState.Failed)
                Snackbars.Show("Export failed");
        }
    }

    private async Task StartExportAsync()
    {
        if (_starting || AuthenticationState is null)
            return;

        _starting = true;
        try
        {
            ClaimsPrincipal user = (await AuthenticationState).User;
            ExportJob job = Exports.Start(Recording.Id, user, CancellationToken.None);
            _watching.Add(job.Id);
            _job = job;
            _jobRecordingId = Recording.Id;
        }
        catch (Exception ex) when (IsUserSafe(ex))
        {
            // The service messages are user-safe; the disabled button is never the only guard.
            Snackbars.Show(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Starting an export for {RecordingId} failed.", Recording.Id);
            Snackbars.Show("Could not start the export. Try again.");
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task CancelExportAsync()
    {
        if (_cancelling || _job is not { IsActive: true } job || AuthenticationState is null)
            return;

        _cancelling = true;
        try
        {
            // No confirmation: Retry is right there.
            Exports.Cancel(job.Id, (await AuthenticationState).User);
        }
        catch (Exception ex) when (IsUserSafe(ex))
        {
            // Usually the job finished first; re-read it and only report a job still running.
            RefreshExport();
            if (_job is { IsActive: true })
                Snackbars.Show(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Cancelling export {ExportId} failed.", job.Id);
            RefreshExport();
            if (_job is { IsActive: true })
                Snackbars.Show("Could not cancel the export. Try again.");
        }
        finally
        {
            _cancelling = false;
        }
    }

    private void OpenDeleteDialog()
    {
        if (DeleteBlockedReason is not null)
            return;

        _deleteError = null;
        _deleteOpen = true;
    }

    private void OnDeleteOpenChanged(bool open)
    {
        // A native Esc/close must not hide the dialog while the server call is in flight.
        if (!open && _deleting)
            return;

        _deleteOpen = open;
        if (!open)
            _deleteError = null;
    }

    private void CancelDelete()
    {
        if (_deleting)
            return;

        _deleteOpen = false;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting || AuthenticationState is null)
            return;

        _deleting = true;
        _deleteError = null;
        try
        {
            ClaimsPrincipal user = (await AuthenticationState).User;
            await Admin.DeleteAsync(Recording.Id, user, CancellationToken.None);
            _deleteOpen = false;
        }
        catch (KeyNotFoundException)
        {
            _deleteOpen = false;
            Snackbars.Show("Recording was already deleted");
        }
        catch (UnauthorizedAccessException)
        {
            _deleteOpen = false;
            Snackbars.Show(DeleteSessionEnded);
        }
        catch (InvalidOperationException ex)
        {
            // Live or leased: the dialog stays open and the server's user-safe text replaces
            // the permanence copy. A concurrent export may have started in another tab.
            _deleteError = ex.Message;
            RefreshExport();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Deleting recording {RecordingId} failed.", Recording.Id);
            _deleteError = "Could not delete the recording. Try again.";
        }
        finally
        {
            _deleting = false;
        }
    }

    // The export service's expected failures, whose messages may be shown as they are.
    private static bool IsUserSafe(Exception ex) =>
        ex is InvalidOperationException or KeyNotFoundException or UnauthorizedAccessException;

    // Retrying an incompatible recording would fail the same way.
    private static bool CanRetry(ExportJob job) =>
        job.State == ExportState.Cancelled
        || job is { State: ExportState.Failed, Error: not ExportService.IncompatibleParts };

    private static string ExportText(ExportJob job) => job.State switch
    {
        ExportState.Queued => "Queued — waiting for another export",
        ExportState.Running => "Exporting…",
        ExportState.Succeeded => job.FileName is { } name ? $"MP4 ready · {name}" : "MP4 ready",
        ExportState.Cancelled => "Export cancelled",
        _ when job.Error == ExportService.IncompatibleParts => "This recording's parts cannot be joined into one MP4.",
        _ => job.Error ?? "Export failed",
    };

    private static string ExportIcon(ExportState state) => state switch
    {
        ExportState.Queued => "schedule",
        ExportState.Running => "hourglass_top",
        ExportState.Succeeded => "check_circle",
        ExportState.Cancelled => "cancel",
        _ => "error",
    };


    private void OpenStopDialog()
    {
        if (!IsLive || _stopping)
            return;

        _stopOpen = true;
    }

    private void OnStopOpenChanged(bool open)
    {
        if (!open && _stopping)
            return;

        _stopOpen = open;
    }

    private void CancelStop()
    {
        if (!_stopping)
            _stopOpen = false;
    }

    private async Task ConfirmStopAsync()
    {
        if (_stopping || !IsLive)
            return;

        _stopping = true;
        try
        {
            // The recorder's stop budget bounds finalization; no client timeout.
            await Channels.StopAsync(Recording.StreamerLogin, CancellationToken.None);
            _stopOpen = false;
            Snackbars.Show("Channel paused");
        }
        catch (UnauthorizedAccessException)
        {
            _stopOpen = false;
            Snackbars.Show("Your Twitch session ended. Reconnect to manage channels.");
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            _stopOpen = false;
            Snackbars.Show(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex, "Stopping the recording for {Login} failed.", Recording.StreamerLogin);
            _stopOpen = false;
            Snackbars.Show("Could not stop the recording. Try again.");
        }
        finally
        {
            _stopping = false;
        }
    }

    private void OnExportsChanged() => _ = InvokeAsync(() =>
    {
        AnnounceFinishedExports();
        RefreshExport();
        StateHasChanged();
    });

    private async Task ToggleAsync(bool open)
    {
        Preferences.SetDetailsOpen(open);
        await Preferences.PersistAsync();
    }

    private async Task SeekToChapterAsync(Chapter chapter) =>
        await Bridge.SeekAsync(chapter.StartSeconds);

    private async Task CopyPlaylistAsync()
    {
        bool copied = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            copied = await _module.InvokeAsync<bool>("copyText", AbsolutePlaylistUrl);
        }
        catch (JSDisconnectedException ex)
        {
            // The circuit is gone; the failure snackbar cannot reach the page anyway.
            Logger.LogDebug(ex, "The playlist URL was not copied because the circuit disconnected.");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "The playlist URL could not be copied.");
        }

        Snackbars.Show(copied ? "Playlist URL copied" : "Could not copy playlist URL");
    }

    private static string Count(int value, string singular) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{value:N0} {(value == 1 ? singular : singular + "s")}");

    private static string ChapterOffset(Chapter chapter) =>
        chapter.StartSeconds.ToString("0.###", CultureInfo.InvariantCulture);

    // Offsets are not unique (two metadata changes can land in one segment); the index
    // keeps sibling keys unique while preserving the offset for stable data attributes.
    private static string ChapterKey(int index, Chapter chapter) =>
        $"{ChapterOffset(chapter)}:{index}";

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Clock.Changed -= OnClockChanged;
        Exports.Changed -= OnExportsChanged;

        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser is gone; there is no module state left to release.
        }
    }
}
