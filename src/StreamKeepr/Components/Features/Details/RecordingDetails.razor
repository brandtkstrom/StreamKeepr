@* Spec: docs/details-auth-settings-contract.md §§2–4; player contract §2. The title block
   under the player, Md and up (design system: RecordingDetails): the title, meta line and
   actions on the page ground, outside any panel, then the export row. The chapters are their
   own panel (ChaptersPanel). The same instance survives recording swaps because Home keeps it
   in one slot. Below Breakpoint.Md Home renders the summary and export row itself (#175). *@
<div class="sk-details" data-recording-details="true">
    <RecordingDetailsSummary Recording="Recording" AvatarUrl="@AvatarUrl" />
    <RecordingDetailsBody Recording="Recording" />
</div>

@code {
    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    /// <summary>The channel's Twitch profile image for the title block's avatar.</summary>
    [Parameter] public string? AvatarUrl { get; set; }
}
