@using System.Globalization
@using StreamKeepr.Infrastructure.Storage
@using System.Security.Claims
@implements IAsyncDisposable
@inject UiPreferences Preferences
@inject ViewerClock Clock
@inject SnackbarService Snackbars
@inject PlayerBridge Bridge
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<RecordingDetails> Logger
@inject IExportService Exports

@* Spec: docs/details-auth-settings-contract.md §§2–4; player contract §11. The same
   component instance survives recording swaps because Home keeps it in one slot. *@
<Collapsible Open="@Preferences.DetailsOpen"
             OnToggle="ToggleAsync"
             data-recording-details="true">
    <Header>
        <h2>Recording details</h2>
        <span class="hint" data-details-date>@StartLabel</span>
    </Header>
    <ChildContent>
        <div class="sk-details-body">
            <div class="sk-details-title">
                <h3 data-details-title>@Recording.Title</h3>
                <div class="sk-actions">
                    <Button Variant="ButtonVariant.Outlined"
                            OnClick="CopyPlaylistAsync"
                            data-copy-playlist="true">
                        <Icon Name="content_copy" Size="IconSize.Small" />
                        Copy playlist URL
                    </Button>
                    <RequiresTwitch>
                        @if (IsLive)
                        {
                            <Tooltip Text="Available when the recording finishes" tabindex="0">
                                <Button Variant="ButtonVariant.Tonal" Disabled="true" data-export="true">
                                    <Icon Name="movie" Size="IconSize.Small" />
                                    Export MP4
                                </Button>
                            </Tooltip>
                        }
                        else
                        {
                            <Button Variant="ButtonVariant.Tonal"
                                    Disabled="@(_job?.IsActive == true || _starting)"
                                    OnClick="StartExportAsync"
                                    data-export="true">
                                <Icon Name="movie" Size="IconSize.Small" />
                                Export MP4
                            </Button>
                        }
                    </RequiresTwitch>
                </div>
            </div>

            <div class="sk-details-meta">
                <span class="who">
                    <Avatar Name="@Recording.StreamerLogin" Tone="AvatarTone.Tertiary" />
                    <span data-details-streamer>@Recording.StreamerLogin</span>
                </span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-category>@CategoryLabel</span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-start>@StartLabel</span>
                <span class="sep" aria-hidden="true"></span>
                <span data-details-counts>
                    <span data-details-segments>@Count(Recording.SegmentCount, "segment")</span>
                    <span aria-hidden="true"> · </span>
                    <span data-details-parts>@Count(Recording.PartCount, "part")</span>
                    @if (ShowSize)
                    {
                        <span aria-hidden="true"> · </span>
                        <span data-details-size>@Format.Bytes(Recording.SizeBytes)</span>
                    }
                </span>
            </div>

            @if (_job is { } job)
            {
                int percent = (int)Math.Round(Math.Clamp(job.Progress, 0, 1) * 100);
                <div class="sk-export-row" data-export-row="@job.State">
                    <Icon Name="@ExportIcon(job.State)" Size="IconSize.Small" />
                    @* State changes are announced; per-percent changes are not. *@
                    <span class="text" role="status">@ExportText(job)</span>
                    @if (job.State == ExportState.Running)
                    {
                        <span class="pct" aria-hidden="true">@percent%</span>
                        <div class="sk-export-progress"
                             role="progressbar"
                             aria-label="Export progress"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@percent"
                             aria-valuetext="@($"{percent}%")">
                            <i style="width:@(percent)%"></i>
                        </div>
                    }
                    @if (job.State == ExportState.Succeeded)
                    {
                        <RequiresTwitch>
                            <a class="sk-btn tonal"
                               href="@StreamKeepr.Hosting.ExportDownloadEndpoint.For(job.Id)"
                               download="@(job.FileName ?? "")"
                               data-enhance-nav="false"
                               data-export-download="true">
                                <Icon Name="download" Size="IconSize.Small" />
                                Download
                            </a>
                        </RequiresTwitch>
                    }
                </div>
            }

            @{
                IReadOnlyList<Chapter> chapters = VisibleChapters;
            }
            @if (chapters.Count > 0)
            {
                <div class="sk-chapters" role="group" aria-label="Chapters">
                    @for (int index = 0; index < chapters.Count; index++)
                    {
                        Chapter chapter = chapters[index];
                        <button type="button"
                                class="sk-chapter"
                                @key="ChapterKey(index, chapter)"
                                data-chapter="@ChapterOffset(chapter)"
                                data-chapter-key="@ChapterKey(index, chapter)"
                                @onclick="() => SeekToChapterAsync(chapter)">
                            <span class="sk-visually-hidden">Seek to </span>
                            <span class="time">@Format.Timecode(chapter.StartSeconds)</span>
                            <span class="title">@chapter.Title</span>
                            @if (!string.IsNullOrWhiteSpace(chapter.Game))
                            {
                                <span class="game">@chapter.Game</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </ChildContent>
</Collapsible>

@code {
    private const string ModulePath = "./Components/Features/Details/RecordingDetails.razor.js";

    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Jobs this card started or saw active; each finished one raises one snackbar, even after
    // the card has moved on to another recording.
    private readonly HashSet<string> _watching = new(StringComparer.Ordinal);
    private ExportJob? _job;
    private string? _jobRecordingId;
    private bool _starting;

    private bool IsLive =>
        Recording.State is RecordingState.Recording or RecordingState.Reconnecting;

    private bool ShowSize =>
        Recording.State is RecordingState.Partial or RecordingState.Saved;

    private string CategoryLabel =>
        string.IsNullOrWhiteSpace(Recording.Category) ? "No category" : Recording.Category;

    private string StartLabel =>
        Clock.ToLocal(Recording.StartedAt)
            .ToString("ddd, MMM d, yyyy · h:mm tt", CultureInfo.InvariantCulture);

    private string AbsolutePlaylistUrl =>
        new Uri(new Uri(Navigation.BaseUri), Recording.PlaylistUrl).AbsoluteUri;

    private IReadOnlyList<Chapter> VisibleChapters =>
        Recording.Chapters
            .Where(chapter =>
                double.IsFinite(chapter.StartSeconds) &&
                chapter.StartSeconds >= 0 &&
                (Recording.DurationSec <= 0 || chapter.StartSeconds <= Recording.DurationSec))
            .ToArray();

    protected override void OnInitialized()
    {
        Preferences.Changed += OnPreferencesChanged;
        Clock.Changed += OnClockChanged;
        Exports.Changed += OnExportsChanged;
    }

    protected override void OnParametersSet()
    {
        // A different recording never shows the previous recording's job.
        if (_jobRecordingId != Recording.Id)
            RefreshExport();
    }

    private void RefreshExport()
    {
        _jobRecordingId = Recording.Id;
        _job = Exports.FindByRecording(Recording.Id);
        if (_job is { IsActive: true })
            _watching.Add(_job.Id);
    }

    private void AnnounceFinishedExports()
    {
        foreach (string id in _watching.ToArray())
        {
            if (Exports.Find(id) is not { } job)
            {
                _watching.Remove(id);
                continue;
            }

            if (job.IsActive)
                continue;

            _watching.Remove(id);
            if (job.State == ExportState.Succeeded)
                Snackbars.Show("Export ready");
            else if (job.State == ExportState.Failed)
                Snackbars.Show("Export failed");
        }
    }

    private async Task StartExportAsync()
    {
        if (_starting || AuthenticationState is null)
            return;

        _starting = true;
        try
        {
            ClaimsPrincipal user = (await AuthenticationState).User;
            ExportJob job = Exports.Start(Recording.Id, user, CancellationToken.None);
            _watching.Add(job.Id);
            _job = job;
            _jobRecordingId = Recording.Id;
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException
            or UnauthorizedAccessException)
        {
            // The service messages are user-safe; the disabled button is never the only guard.
            Snackbars.Show(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Starting an export for {RecordingId} failed.", Recording.Id);
            Snackbars.Show("Could not start the export. Try again.");
        }
        finally
        {
            _starting = false;
        }
    }

    private static string ExportText(ExportJob job) => job.State switch
    {
        ExportState.Queued => "Queued — waiting for another export",
        ExportState.Running => "Exporting…",
        ExportState.Succeeded => job.FileName is { } name ? $"MP4 ready · {name}" : "MP4 ready",
        _ => job.Error ?? "Export failed",
    };

    private static string ExportIcon(ExportState state) => state switch
    {
        ExportState.Queued => "schedule",
        ExportState.Running => "hourglass_top",
        ExportState.Succeeded => "check_circle",
        _ => "error",
    };

    private void OnExportsChanged() => _ = InvokeAsync(() =>
    {
        AnnounceFinishedExports();
        RefreshExport();
        StateHasChanged();
    });

    private async Task ToggleAsync(bool open)
    {
        Preferences.SetDetailsOpen(open);
        await Preferences.PersistAsync();
    }

    private async Task SeekToChapterAsync(Chapter chapter) =>
        await Bridge.SeekAsync(chapter.StartSeconds);

    private async Task CopyPlaylistAsync()
    {
        bool copied = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            copied = await _module.InvokeAsync<bool>("copyText", AbsolutePlaylistUrl);
        }
        catch (JSDisconnectedException ex)
        {
            // The circuit is gone; the failure snackbar cannot reach the page anyway.
            Logger.LogDebug(ex, "The playlist URL was not copied because the circuit disconnected.");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "The playlist URL could not be copied.");
        }

        Snackbars.Show(copied ? "Playlist URL copied" : "Could not copy playlist URL");
    }

    private static string Count(int value, string singular) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{value:N0} {(value == 1 ? singular : singular + "s")}");

    private static string ChapterOffset(Chapter chapter) =>
        chapter.StartSeconds.ToString("0.###", CultureInfo.InvariantCulture);

    // Offsets are not unique (two metadata changes can land in one segment); the index
    // keeps sibling keys unique while preserving the offset for stable data attributes.
    private static string ChapterKey(int index, Chapter chapter) =>
        $"{ChapterOffset(chapter)}:{index}";

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Clock.Changed -= OnClockChanged;
        Exports.Changed -= OnExportsChanged;

        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser is gone; there is no module state left to release.
        }
    }
}
