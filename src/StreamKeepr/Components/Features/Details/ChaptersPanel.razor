@implements IDisposable
@inject UiPreferences Preferences

@* The Chapters panel under the title block, Md and up (design system: Chapters). It replaces
   the old Recording details panel and keeps its open state (UiPreferences.DetailsOpen). Not a
   MudExpansionPanel: MudBlazor 9.12's panel header is a focusable div with no button role or
   aria-expanded, and this header must stay a disclosure button. No chapters, no panel. *@
@if (ChapterList.Visible(Recording).Count is > 0 and var count)
{
    <MudBlazor.MudPaper Outlined="true"
                        Elevation="0"
                        Class="sk-disclosure"
                        data-chapters-panel
                        data-expanded="@(Preferences.DetailsOpen ? "true" : "false")">
        <button type="button"
                class="sk-disclosure-head"
                data-collapsible-toggle
                aria-expanded="@(Preferences.DetailsOpen ? "true" : "false")"
                aria-controls="@_bodyId"
                @onclick="() => ToggleAsync(!Preferences.DetailsOpen)">
            <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Toc" Size="MudBlazor.Size.Small" />
            <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h2">Chapters</MudBlazor.MudText>
            <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="hint" data-chapter-count>@ChapterList.CountLabel(count)</MudBlazor.MudText>
            <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.ExpandMore" Class="chev" />
        </button>
        <MudBlazor.MudCollapse Expanded="@Preferences.DetailsOpen">
            <div id="@_bodyId" class="sk-disclosure-body" inert="@(!Preferences.DetailsOpen)">
                <ChapterList Recording="Recording" />
            </div>
        </MudBlazor.MudCollapse>
    </MudBlazor.MudPaper>
}

@code {
    private readonly string _bodyId = $"sk-chapters-body-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    protected override void OnInitialized() => Preferences.Changed += OnPreferencesChanged;

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleAsync(bool open)
    {
        Preferences.SetDetailsOpen(open);
        await Preferences.PersistAsync();
    }

    public void Dispose() => Preferences.Changed -= OnPreferencesChanged;
}
