@using StreamKeepr.Infrastructure.Twitch
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject AdminSessionState Session
@inject IJSRuntime JS
@inject ILogger<TwitchAccount> Logger

@* Top-bar Twitch control (details/auth/settings contract §7). Every state is plain markup that
   works without the circuit: the login link is a full-page navigation and Disconnect posts a
   real antiforgery form. TwitchAccount.razor.js only adds the brief connecting state. *@
@if (Session.Expired)
{
    <span class="sk-auth-expired" data-auth-state="expired">
        <span class="sk-status failed" role="status">
            <span class="sk-icon" aria-hidden="true">warning</span>Twitch session expired
        </span>
        <a class="sk-btn text" href="@LoginHref" data-enhance-nav="false">
            <span class="sk-icon" aria-hidden="true">refresh</span>Reconnect
        </a>
    </span>
}
else
{
    <AuthorizeView>
        <Authorized>
            @* Avatar only (design system: TwitchAccount): the name is in the menu, and in the
               activator's accessible name. Opening the menu needs the circuit; the logout form is a
               real form either way. *@
            <MudBlazor.MudMenu AnchorOrigin="MudBlazor.Origin.BottomRight"
                               TransformOrigin="MudBlazor.Origin.TopRight"
                               Class="sk-account"
                               data-auth-state="connected">
                <ActivatorContent Context="menu">
                    <span class="sk-account-trigger" data-account-trigger @onclick="menu.ToggleAsync">
                        <span class="sk-visually-hidden" data-account-label>Twitch account: @DisplayName(context.User)</span>
                        <MudBlazor.MudBadge Dot="true" Overlap="true" Bordered="true"
                                            Color="MudBlazor.Color.Success"
                                            Origin="MudBlazor.Origin.BottomRight"
                                            BadgeClass="sk-account-badge"
                                            aria-hidden="true"
                                            data-auth-dot>
                            <MudBlazor.MudAvatar Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Tertiary" data-account-avatar>
                                @Initial(context.User)
                            </MudBlazor.MudAvatar>
                        </MudBlazor.MudBadge>
                    </span>
                </ActivatorContent>
                <ChildContent>
                    <div class="sk-account-header" role="presentation" data-account-header>
                        <MudBlazor.MudAvatar Color="MudBlazor.Color.Tertiary" aria-hidden="true">@Initial(context.User)</MudBlazor.MudAvatar>
                        <div class="who">
                            <div class="name">@DisplayName(context.User)</div>
                            @if (DistinctLogin(context.User) is { } login)
                            {
                                <div class="login" data-account-login>@login</div>
                            }
                            <div class="status"><span class="sk-auth-dot" data-auth-dot aria-hidden="true"></span>Connected to Twitch</div>
                        </div>
                    </div>
                    <MudBlazor.MudDivider />
                    <MudBlazor.MudMenuItem Icon="@MudBlazor.Icons.Material.Rounded.ManageAccounts" Href="/settings#twitch">Manage Twitch connection</MudBlazor.MudMenuItem>
                    <MudBlazor.MudMenuItem Icon="@MudBlazor.Icons.Material.Rounded.Settings" Href="/settings">Settings</MudBlazor.MudMenuItem>
                    <MudBlazor.MudMenuItem Icon="@MudBlazor.Icons.Material.Rounded.Logout" OnClick="DisconnectAsync">Disconnect</MudBlazor.MudMenuItem>
                </ChildContent>
            </MudBlazor.MudMenu>
            <form id="@LogoutFormId" method="post" action="@AdminAuth.LogoutPath" hidden>
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            </form>
        </Authorized>
        <NotAuthorized>
            <a class="sk-twitch"
               href="@LoginHref"
               data-enhance-nav="false"
               data-twitch-connect
               data-auth-state="disconnected">
                <span class="sk-icon" aria-hidden="true">link</span>
                <span class="lbl">Connect with Twitch</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    public const string LogoutFormId = "sk-logout";

    private IJSObjectReference? _module;
    private bool _disposed;

    private string ReturnUrl => AuthLinks.ReturnUrl(Navigation.Uri);

    private string LoginHref => AuthLinks.LoginHref(Navigation.Uri);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Session.Changed += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Features/Auth/TwitchAccount.razor.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }
            await _module.InvokeVoidAsync("init");
        }
        catch (JSException ex)
        {
            // The link still signs in; only the connecting feedback is lost.
            Logger.LogDebug(ex, "The Twitch account module could not be initialized.");
        }
    }

    internal static string DisplayName(ClaimsPrincipal user) =>
        user.FindFirst(AdminAuth.DisplayNameClaim)?.Value is { Length: > 0 } display
            ? display
            : Login(user);

    internal static string Login(ClaimsPrincipal user) => user.Identity?.Name ?? "Twitch";

    // Shown beside the display name only when it adds something (contract: login, and the
    // display name when available).
    internal static string? DistinctLogin(ClaimsPrincipal user) =>
        string.Equals(DisplayName(user), Login(user), StringComparison.OrdinalIgnoreCase)
            ? null
            : Login(user);

    // The menu shows the account's first letter until account images arrive.
    internal static string Initial(ClaimsPrincipal user) =>
        DisplayName(user) is { Length: > 0 } name ? char.ToUpperInvariant(name[0]).ToString() : "?";

    // MudMenuItem renders a div, not a submit button, so the module submits the real form.
    private async Task DisconnectAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("submitForm", LogoutFormId);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not submit the Twitch logout form.");
        }
    }

    // The return URLs follow the current page and query.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        Session.Changed -= OnSessionChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no module left to release.
            }
        }
    }
}
