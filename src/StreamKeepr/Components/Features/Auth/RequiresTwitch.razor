@* Keeps the protected control visible. Signed out, the control is inert and
   explained by the tooltip; the service layer still enforces authorization. *@
<AuthorizeView>
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <Tooltip Text="@Message" tabindex="0" data-requires-twitch>
            <span class="sk-requires-twitch" inert>@ChildContent</span>
        </Tooltip>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Why a control is inert while signed out; the library row's Delete uses it too.</summary>
    public const string SignedOutMessage = "Connect Twitch to use this";

    [Parameter] public string Message { get; set; } = SignedOutMessage;
}
