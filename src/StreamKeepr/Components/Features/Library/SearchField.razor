@using StreamKeepr.Ui
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<SearchField> Logger

@* The value is prerendered from the URL; after that SearchField.razor.js owns the field and
   the debounce, and URL changes from elsewhere are mirrored in through setValue. *@
<input type="search"
       data-search-input
       placeholder="Search recordings, streamers, categories"
       aria-label="Search recordings"
       aria-keyshortcuts="/"
       autocomplete="off"
       value="@_initial"
       @ref="_input" />

@code {
    private const string ModulePath = "./Components/Features/Library/SearchField.razor.js";

    private ElementReference _input;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SearchField>? _self;
    private string? _initial;
    private string? _current;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _initial = _current = LibraryUrl.Parse(Navigation.Uri).Search;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_disposed)
            {
                // DisposeAsync ran during the import: release the module, never attach listeners.
                await _module.DisposeAsync();
                return;
            }
            await _module.InvokeVoidAsync("init", _input, _self);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "The search field module could not be initialized.");
        }
    }

    [JSInvokable]
    public Task Search(string? query)
    {
        string? search = string.IsNullOrWhiteSpace(query) ? null : query.Trim();
        _current = search;

        LibraryQuery current = LibraryUrl.Parse(Navigation.Uri);
        if (current.Search != search)
            Navigation.NavigateTo(LibraryUrl.With(Navigation.Uri, current with { Search = search }), replace: true);

        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        string? search = LibraryUrl.Parse(args.Location).Search;
        if (search == _current)
            return;

        _current = search;
        _ = InvokeAsync(SetValueAsync);
    }

    private async Task SetValueAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("setValue", _input, _current ?? "");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not mirror the URL into the search field.");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _input);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "Could not dispose the search field module.");
            }
        }

        _self?.Dispose();
    }
}
