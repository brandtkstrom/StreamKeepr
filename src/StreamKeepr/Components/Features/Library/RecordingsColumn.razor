@using StreamKeepr.Ui

@* The selected channel's recordings (design system: LibraryDrawer, recordings column): a 64px
   header with the channel and a way back, then its recordings by day, newest first. Md and up it
   opens to the right of the channels, over the page; below Md it drills in over the list. *@
<section class="sk-rec-col @(Compact ? "drill" : null)"
         aria-labelledby="@HeadingId"
         data-recordings-column="@Streamer.Login">
    <div class="sk-rec-col-head">
        @if (Compact)
        {
            <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.ArrowBack"
                                     aria-label="All channels"
                                     OnClick="OnClose"
                                     data-column-close />
        }
        <ChannelAvatar Login="@Streamer.Login"
                       Name="@Streamer.DisplayName"
                       ImageUrl="@Streamer.AvatarUrl"
                       Live="@Streamer.IsRecording"
                       Size="MudBlazor.Size.Medium"
                       Decorative="true" />
        <span class="who">
            <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h3" id="@HeadingId">@Streamer.DisplayName</MudBlazor.MudText>
            <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="meta" data-column-meta>@Meta</MudBlazor.MudText>
        </span>
        @if (!Compact)
        {
            <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Close"
                                     aria-label="@($"Close {Streamer.DisplayName}'s recordings")"
                                     OnClick="OnClose"
                                     data-column-close />
        }
    </div>
    <div class="sk-rec-col-body" role="list" aria-labelledby="@HeadingId" data-column-body>
        @{
            DateTime? previousDay = null;
        }
        @foreach (RecordingView recording in Recordings)
        {
            DateTime day = TimeZoneInfo.ConvertTime(recording.StartedAt, TimeZone).Date;
            if (previousDay != day)
            {
                previousDay = day;
                <div class="sk-day" role="presentation" data-day-header>@Format.DayHeader(recording.StartedAt, Now, TimeZone)</div>
            }

            <RecordingRow @key="recording.Id"
                          Recording="recording"
                          Selected="@string.Equals(recording.Id, SelectedId, StringComparison.Ordinal)"
                          Search="@Search"
                          ViewQuery="@ViewQuery"
                          TimeZone="TimeZone"
                          DeleteBlockedReason="@DeleteBlockedReason(recording)"
                          OnDelete="OnDelete" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public StreamerView Streamer { get; set; } = null!;

    [Parameter] public IReadOnlyList<RecordingView> Recordings { get; set; } = [];

    [Parameter] public string? SelectedId { get; set; }

    [Parameter] public string? Search { get; set; }

    [Parameter] public string ViewQuery { get; set; } = "";

    [Parameter] public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;

    [Parameter] public DateTimeOffset Now { get; set; }

    /// <summary>Below Md: the column drills in over the channels, with a way back.</summary>
    [Parameter] public bool Compact { get; set; }

    [Parameter] public Func<RecordingView, string?> DeleteBlockedReason { get; set; } = _ => null;

    [Parameter] public EventCallback<RecordingView> OnDelete { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string HeadingId => $"sk-col-{Streamer.Login}";

    private string Meta
    {
        get
        {
            string count = Recordings.Count == 1 ? "1 recording" : $"{Recordings.Count} recordings";
            return Streamer.IsRecording ? $"Recording now · {count}" : count;
        }
    }
}
