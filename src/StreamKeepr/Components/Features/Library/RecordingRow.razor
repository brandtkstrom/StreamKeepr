@using System.Globalization
@using StreamKeepr.Ui

@* One library row (design system: RecordingRow): a list item holding the row, a real link so
   selection and deep links work without the circuit, and its Delete button beside it, never
   inside the link. The button is plain markup with a CSS tooltip, not a MudIconButton in a
   MudTooltip, because a channel's column can hold a thousand rows. *@
<div class="sk-row-item" role="listitem" data-row-item>
<a class="sk-row"
   href="@Href"
   aria-current="@(Selected ? "true" : null)"
   data-recording-id="@Recording.Id"
   data-state="@Recording.State.Hook()">
    <span class="sk-thumb @(IsRecording ? "live" : null)">
        @if (Recording.ThumbnailUrl is string thumbnail)
        {
            @* Decorative: the title next to it names the recording. Lazy, so a long library
               only fetches the images scrolled into view. *@
            <img src="@thumbnail" alt="" loading="lazy" decoding="async" />
        }
        else
        {
            <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Movie" data-icon="movie" />
        }
        <span class="dur">@Format.Timecode(Recording.DurationSec)</span>
        @if (Recording.ResumeSec is double resume)
        {
            <span class="prog" data-progress aria-hidden="true"><i style="width:@Format.Percent(resume, Recording.DurationSec)"></i></span>
        }
        else if (IsRecording)
        {
            <span class="prog" data-progress aria-hidden="true"><i style="width:100%"></i></span>
        }
    </span>
    <span class="sk-row-text">
        <MudBlazor.MudText Typo="MudBlazor.Typo.subtitle2" HtmlTag="span" Class="sk-row-title" data-row-title>
            <MudBlazor.MudHighlighter Text="@Recording.Title" HighlightedText="@Search" Class="sk-mark" />
        </MudBlazor.MudText>
        <span class="sk-row-meta">@Meta</span>
        @if (Status is StatusChipKind status)
        {
            <StatusChip Status="status" />
        }
    </span>
</a>
@* Disabled with aria-disabled, not disabled, so it stays focusable and its reason is read. *@
<button type="button"
        class="sk-row-del"
        aria-label="@($"Delete recording: {Recording.Title}")"
        aria-disabled="@(DeleteBlockedReason is null ? null : "true")"
        aria-describedby="@(DeleteBlockedReason is null ? null : ReasonId)"
        data-tip="@(DeleteBlockedReason ?? "Delete recording")"
        data-row-delete
        @onclick="DeleteAsync">@IslandIcon.Svg("Delete")</button>
@if (DeleteBlockedReason is { } reason)
{
    <span id="@ReasonId" class="sk-visually-hidden" data-delete-blocked>@reason</span>
}
</div>

@code {
    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    [Parameter] public bool Selected { get; set; }

    [Parameter] public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;

    [Parameter] public string? Search { get; set; }

    /// <summary>The library view's query string ("" or "?q=…"), kept so selecting a row
    /// does not reset the filter, sort, or drawer scroll.</summary>
    [Parameter] public string ViewQuery { get; set; } = "";

    /// <summary>Why Delete is unavailable (live, exporting, signed out); null when it is.</summary>
    [Parameter] public string? DeleteBlockedReason { get; set; }

    /// <summary>Opens "Delete recording?" for this row.</summary>
    [Parameter] public EventCallback<RecordingView> OnDelete { get; set; }

    private RecordingView? _lastRecording;
    private string? _lastSearch;
    private string _lastViewQuery = "";
    private bool _lastSelected;
    private string? _lastTimeZoneId;
    private string? _lastBlocked;

    private string ReasonId => $"sk-del-reason-{Recording.Id}";

    private Task DeleteAsync() =>
        DeleteBlockedReason is null ? OnDelete.InvokeAsync(Recording) : Task.CompletedTask;

    private string Href => $"/r/{Uri.EscapeDataString(Recording.Id)}{ViewQuery}";

    private bool IsRecording => Recording.State == RecordingState.Recording;

    private StatusChipKind? Status => RecordingStatusChip.For(Recording.State);

    private string Meta
    {
        get
        {
            string time = TimeZoneInfo.ConvertTime(Recording.StartedAt, TimeZone)
                .ToString("h:mm tt", CultureInfo.InvariantCulture);
            string duration = Format.Duration(Recording.DurationSec);

            return Recording.State switch
            {
                RecordingState.Recording => $"Started {time} · {duration} so far",
                RecordingState.Partial => $"{time} · {duration} · gaps in capture",
                _ => $"{time} · {duration}",
            };
        }
    }

    protected override bool ShouldRender()
    {
        bool changed = !ReferenceEquals(_lastRecording, Recording) ||
            _lastSelected != Selected ||
            _lastTimeZoneId != TimeZone.Id ||
            _lastSearch != Search ||
            _lastViewQuery != ViewQuery ||
            _lastBlocked != DeleteBlockedReason;

        _lastBlocked = DeleteBlockedReason;
        _lastRecording = Recording;
        _lastSearch = Search;
        _lastViewQuery = ViewQuery;
        _lastSelected = Selected;
        _lastTimeZoneId = TimeZone.Id;
        return changed;
    }
}
