@using StreamKeepr.Ui
@implements IAsyncDisposable
@inject ILibraryView Library
@inject IJSRuntime JS
@inject ILogger<LibraryDrawer> Logger
@inject UiPreferences Preferences
@inject ViewerClock Clock
@inject NavigationManager Navigation

@* The layout owns the drawer, so it survives navigation and keeps its scroll position. *@
@if (Rail)
{
    @* The rail opens with Home, then the streamers (design system: LibraryDrawer, mini rail). *@
    <div class="sk-rail-home">
        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Home" Href="/" aria-label="Home" />
        <MudBlazor.MudDivider />
    </div>
}

<div class="sk-drawer-head">
    <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h2">Library</MudBlazor.MudText>
    <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="sk-sort"
                       data-sort="@_query.Sort" data-sort-icon="@CurrentSort.IconName">
        @if (CurrentSort.Glyph is { } icon)
        {
            <MudBlazor.MudIcon Icon="@icon" Size="MudBlazor.Size.Small" aria-hidden="true" />
        }
        @CurrentSort.Label
    </MudBlazor.MudText>
    @* In the rail the menu opens rightward, over the main column; expanded, it opens leftward. *@
    <MudBlazor.MudMenu OpenChanged="OnSortMenuOpenChanged"
                       Icon="@MudBlazor.Icons.Material.Rounded.MoreVert"
                       Size="MudBlazor.Size.Small"
                       AriaLabel="Library options"
                       AnchorOrigin="@(Rail ? MudBlazor.Origin.BottomLeft : MudBlazor.Origin.BottomRight)"
                       TransformOrigin="@(Rail ? MudBlazor.Origin.TopLeft : MudBlazor.Origin.TopRight)"
                       Class="sk-sort-menu">
        @foreach (SortChoice choice in SortChoices)
        {
            bool current = choice == CurrentSort;
            <MudBlazor.MudMenuItem Icon="@(current ? MudBlazor.Icons.Material.Rounded.Check : null)"
                                   OnClick="@(() => SetSort(choice.Key))"
                                   data-sort-option="@choice.Key"
                                   aria-current="@(current ? "true" : null)"
                                   data-selected="@(current ? "true" : null)">@choice.Label</MudBlazor.MudMenuItem>
        }
    </MudBlazor.MudMenu>
</div>

@* Shown by CSS from body[data-sk-reconnect] while the circuit reconnects, because the
   circuit cannot render anything while it is down. *@
<UpdatesPausedAlert Class="sk-drawer-note" data-updates-paused />

<MudBlazor.MudChipSet T="string"
                      SelectionMode="MudBlazor.SelectionMode.SingleSelection"
                      SelectedValue="@(_query.State ?? "all")"
                      SelectedValueChanged="OnFilterChanged"
                      SelectedColor="MudBlazor.Color.Primary"
                      Variant="MudBlazor.Variant.Outlined"
                      Size="MudBlazor.Size.Small"
                      CheckMark="true"
                      Class="sk-filters"
                      role="group"
                      aria-label="Filter recordings">
    @foreach ((string key, string label, string icon) in Filters)
    {
        bool pressed = (_query.State ?? "all") == key;
        <MudBlazor.MudChip T="string"
                           Value="@key"
                           Icon="@icon"
                           role="button"
                           aria-pressed="@(pressed ? "true" : "false")"
                           data-filter="@key">@label</MudBlazor.MudChip>
    }
</MudBlazor.MudChipSet>

<div class="sk-drawer-list"
     data-drawer-list
     @ref="_list"
     aria-busy="@(Library.IsLoaded ? null : "true")">
    @if (!Library.IsLoaded)
    {
        @for (int index = 0; index < 6; index++)
        {
            <div class="sk-row" data-library-skeleton aria-hidden="true">
                <MudBlazor.MudSkeleton SkeletonType="MudBlazor.SkeletonType.Rectangle" Class="sk-thumb" />
                <span class="sk-row-text">
                    <MudBlazor.MudSkeleton Width="80%" />
                    <MudBlazor.MudSkeleton Width="50%" />
                </span>
            </div>
        }
    }
    else
    {
        IReadOnlyList<StreamerView> streamers = Library.Streamers(_query);
        if (streamers.Count == 0)
        {
            <p class="body-medium" data-library-empty>@(Filtered ? "No recordings match" : "No recordings yet")</p>
        }
        else
        {
            <div role="tree" aria-label="Recordings">
            @foreach (StreamerView streamer in streamers)
            {
                <StreamerGroup @key="streamer.Login"
                               Streamer="streamer"
                               Recordings="Library.Recordings(streamer.Login, _query)"
                               Search="@_query.Search"
                               ViewQuery="@ViewQuery"
                               Expanded="@(!Preferences.IsCollapsed(streamer.Login))"
                               SelectedId="@SelectedId"
                               TimeZone="@Clock.TimeZone"
                               Now="@Clock.Now"
                               OnToggle="@(() => ToggleGroupAsync(streamer.Login))" />
            }
            </div>
        }
    }
</div>

<div class="sk-drawer-foot">
    <StorageMeter FreeBytes="@Library.Storage.FreeBytes"
                  TotalBytes="@Library.Storage.TotalBytes"
                  Rail="@Rail"
                  OnOpen="ExpandFromRailAsync" />
</div>

@code {
    private const string TreeModule = "./js/tree-nav.js";
    private const string DrawerModule = "./Components/Features/Library/LibraryDrawer.razor.js";

    // One row per sort: its URL key, the header and menu label, and the header arrow (named for
    // the data-sort-icon hook, drawn as a MudBlazor glyph). The first is the default.
    private sealed record SortChoice(string Key, string Label, string? IconName, string? Glyph);

    private static readonly SortChoice[] SortChoices =
    [
        new("newest", "Newest first", "arrow_downward", MudBlazor.Icons.Material.Rounded.ArrowDownward),
        new("oldest", "Oldest first", "arrow_upward", MudBlazor.Icons.Material.Rounded.ArrowUpward),
        new("az", "A–Z by streamer", null, null),
    ];

    private static readonly (string Key, string Label, string Icon)[] Filters =
    [
        ("all", "All", MudBlazor.Icons.Material.Rounded.ViewList),
        ("recording", "Recording", MudBlazor.Icons.Material.Rounded.FiberManualRecord),
        ("saved", "Saved", MudBlazor.Icons.Material.Rounded.Inventory2),
    ];

    /// <summary>True while the shell shows the desktop rail (set by <c>AppShell</c>).</summary>
    [CascadingParameter(Name = "LibraryRail")] public bool Rail { get; set; }

    private ElementReference _list;
    private bool _focusSortMenu;
    private IJSObjectReference? _drawerModule;
    private IJSObjectReference? _tree;
    private bool _resetScroll;
    private string? _scrollToKey;
    private LibraryQuery _query = new();
    private string? _selectedId;
    private bool _disposed;

    private string? SelectedId => _selectedId;

    protected override void OnInitialized()
    {
        _selectedId = ParseSelectedId(Navigation.Uri);
        _query = LibraryUrl.Parse(Navigation.Uri);
        Library.Changed += OnLibraryChanged;
        Clock.Changed += OnClockChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender)
        {
            try
            {
                _tree = await JS.InvokeAsync<IJSObjectReference>("import", TreeModule);
                if (_disposed)
                {
                    // DisposeAsync ran during the import: release the module, never attach listeners.
                    await _tree.DisposeAsync();
                    return;
                }
                await _tree.InvokeVoidAsync("init", _list);
                await _tree.InvokeVoidAsync("revealCurrent", _list);
            }
            catch (JSException ex)
            {
                // Without the module rows stay ordinary links; group heads then work by pointer only.
                Logger.LogDebug(ex, "The library tree module could not be initialized.");
            }

            return;
        }

        if (_focusSortMenu)
        {
            // MudMenu leaves focus on its trigger after a pointer open, and then spends the first
            // Escape moving focus into the list. The menu-button pattern puts focus on the current
            // choice when the menu opens, so one Escape closes it, as it always has here.
            _focusSortMenu = false;
            await FocusSortChoiceAsync();
        }

        if (_resetScroll)
        {
            _resetScroll = false;
            await InvokeTreeAsync("scrollToTop", _list);
        }

        if (_scrollToKey is { } key)
        {
            _scrollToKey = null;
            await InvokeTreeAsync("scrollToKey", _list, key);
        }
    }

    private async Task ToggleGroupAsync(string login)
    {
        bool watching = LibraryUrl.RecordingId(Navigation.Uri) is not null;
        if (Preferences.DrawerFor(watching) == DrawerMode.Rail && await IsRailAsync())
        {
            // In the rail an avatar is a jump: open the drawer at that streamer's recordings.
            Preferences.SetDrawer(DrawerMode.Expanded, watching);
            Preferences.SetCollapsed(login, false);
            _scrollToKey = $"g:{login}";
        }
        else
        {
            Preferences.SetCollapsed(login, !Preferences.IsCollapsed(login));
        }

        await Preferences.PersistAsync();
    }

    private async Task<bool> IsRailAsync()
    {
        if (_tree is null)
            return true;

        try
        {
            return await _tree.InvokeAsync<bool>("isRail", _list);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not read the drawer mode.");
            return true;
        }
    }

    private async Task InvokeTreeAsync(string identifier, params object[] args)
    {
        if (_tree is null)
            return;

        try
        {
            await _tree.InvokeVoidAsync(identifier, args);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Library tree call {Identifier} failed.", identifier);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
    }

    private void OnLibraryChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        string? selected = ParseSelectedId(args.Location);
        LibraryQuery query = LibraryUrl.Parse(args.Location);
        if (string.Equals(selected, _selectedId, StringComparison.Ordinal) && query == _query)
            return;

        _resetScroll |= query != _query;
        _selectedId = selected;
        _query = query;
        _ = InvokeAsync(StateHasChanged);
    }

    private string ViewQuery => LibraryUrl.With("/", _query)[1..];

    private bool Filtered => _query.Search is not null || _query.State is not null;

    private SortChoice CurrentSort =>
        Array.Find(SortChoices, choice => choice.Key == _query.Sort) ?? SortChoices[0];

    private void SetState(string? state) => Navigate(_query with { State = state });

    private void OnSortMenuOpenChanged(bool open) => _focusSortMenu = open;

    private async Task FocusSortChoiceAsync()
    {
        try
        {
            _drawerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DrawerModule);
            await _drawerModule.InvokeAsync<bool>("focusWhenPresent", $"[data-sort-option='{CurrentSort.Key}']");
        }
        catch (JSException ex)
        {
            // Without the module the menu still works; only the first Escape moves focus instead.
            Logger.LogDebug(ex, "Could not focus the sort menu's current choice.");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnFilterChanged(string? key) => SetState(key is null or "all" ? null : key);

    private async Task ExpandFromRailAsync()
    {
        Preferences.SetDrawer(DrawerMode.Expanded, LibraryUrl.RecordingId(Navigation.Uri) is not null);
        await Preferences.PersistAsync();
    }

    private void SetSort(string sort) => Navigate(_query with { Sort = sort });

    // Filtering replaces the history entry so the back button skips view tweaks.
    private void Navigate(LibraryQuery query) =>
        Navigation.NavigateTo(LibraryUrl.With(Navigation.Uri, query), replace: true);

    private string? ParseSelectedId(string uri)
    {
        string relative = Navigation.ToBaseRelativePath(uri);
        if (!relative.StartsWith("r/", StringComparison.Ordinal))
            return null;

        string id = relative[2..];
        int query = id.IndexOf('?', StringComparison.Ordinal);
        if (query >= 0)
            id = id[..query];

        return id.Length == 0 ? null : Uri.UnescapeDataString(id);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Library.Changed -= OnLibraryChanged;
        Clock.Changed -= OnClockChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_drawerModule is not null)
        {
            try
            {
                await _drawerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_tree is not null)
        {
            try
            {
                await _tree.InvokeVoidAsync("dispose", _list);
                await _tree.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "Could not dispose the library tree module.");
            }
        }
    }
}
