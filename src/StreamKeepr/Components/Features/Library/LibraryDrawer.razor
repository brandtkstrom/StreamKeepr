@using StreamKeepr.Infrastructure.Storage
@using StreamKeepr.Ui
@implements IAsyncDisposable
@inject ILibraryView Library
@inject IJSRuntime JS
@inject ILogger<LibraryDrawer> Logger
@inject UiPreferences Preferences
@inject ViewerClock Clock
@inject NavigationManager Navigation
@inject IExportService Exports
@inject MudBlazor.ISnackbar Snackbars

@* The layout owns the drawer, so it survives navigation and keeps its scroll position. *@
@if (Rail)
{
    @* The rail opens with Home, then the streamers (design system: LibraryDrawer, mini rail). *@
    <div class="sk-rail-home">
        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Home" Href="/" aria-label="Home" />
        <MudBlazor.MudDivider />
    </div>
}

<div class="sk-drawer-head">
    <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h2">Library</MudBlazor.MudText>
    <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="sk-sort"
                       data-sort="@_query.Sort" data-sort-icon="@CurrentSort.IconName">
        @if (CurrentSort.Glyph is { } icon)
        {
            <MudBlazor.MudIcon Icon="@icon" Size="MudBlazor.Size.Small" aria-hidden="true" />
        }
        @CurrentSort.Label
    </MudBlazor.MudText>
    @* In the rail the menu opens rightward, over the main column; expanded, it opens leftward. *@
    <MudBlazor.MudMenu OpenChanged="OnSortMenuOpenChanged"
                       Icon="@MudBlazor.Icons.Material.Rounded.MoreVert"
                       Size="MudBlazor.Size.Small"
                       AriaLabel="Library options"
                       AnchorOrigin="@(Rail ? MudBlazor.Origin.BottomLeft : MudBlazor.Origin.BottomRight)"
                       TransformOrigin="@(Rail ? MudBlazor.Origin.TopLeft : MudBlazor.Origin.TopRight)"
                       Class="sk-sort-menu">
        @foreach (SortChoice choice in SortChoices)
        {
            bool current = choice == CurrentSort;
            <MudBlazor.MudMenuItem Icon="@(current ? MudBlazor.Icons.Material.Rounded.Check : null)"
                                   OnClick="@(() => SetSort(choice.Key))"
                                   data-sort-option="@choice.Key"
                                   aria-current="@(current ? "true" : null)"
                                   data-selected="@(current ? "true" : null)">@choice.Label</MudBlazor.MudMenuItem>
        }
    </MudBlazor.MudMenu>
</div>

@* Shown by CSS from body[data-sk-reconnect] while the circuit reconnects, because the
   circuit cannot render anything while it is down. *@
<UpdatesPausedAlert Class="sk-drawer-note" data-updates-paused />

<MudBlazor.MudChipSet T="string"
                      SelectionMode="MudBlazor.SelectionMode.SingleSelection"
                      SelectedValue="@(_query.State ?? "all")"
                      SelectedValueChanged="OnFilterChanged"
                      SelectedColor="MudBlazor.Color.Primary"
                      Variant="MudBlazor.Variant.Outlined"
                      Size="MudBlazor.Size.Small"
                      CheckMark="true"
                      Class="sk-filters"
                      role="group"
                      aria-label="Filter recordings">
    @foreach ((string key, string label, string icon) in Filters)
    {
        bool pressed = (_query.State ?? "all") == key;
        <MudBlazor.MudChip T="string"
                           Value="@key"
                           Icon="@icon"
                           role="button"
                           aria-pressed="@(pressed ? "true" : "false")"
                           data-filter="@key">@label</MudBlazor.MudChip>
    }
</MudBlazor.MudChipSet>

<div class="sk-drawer-list"
     data-drawer-list
     @ref="_list"
     aria-busy="@(Library.IsLoaded ? null : "true")">
    @if (!Library.IsLoaded)
    {
        @for (int index = 0; index < 6; index++)
        {
            <div class="sk-channel" data-library-skeleton aria-hidden="true">
                <MudBlazor.MudSkeleton SkeletonType="MudBlazor.SkeletonType.Circle" Width="40px" Height="40px" />
                <span class="who">
                    <MudBlazor.MudSkeleton Width="70%" />
                    <MudBlazor.MudSkeleton Width="40%" />
                </span>
            </div>
        }
    }
    else
    {
        IReadOnlyList<StreamerView> streamers = Library.Streamers(_query);
        if (streamers.Count == 0)
        {
            if (!Filtered)
            {
                <p class="body-medium" data-library-empty>No recordings yet</p>
            }
            else
            {
                @* Design system: EmptyStates, no match. One icon, one headline, one sentence, one way out. *@
                NoMatchState noMatch = NoMatch;
                <div class="sk-empty-state" data-library-no-match data-empty-icon="search">
                    <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Search" aria-hidden="true" />
                    <MudBlazor.MudText Typo="MudBlazor.Typo.subtitle1" HtmlTag="p" data-library-empty>@noMatch.Headline</MudBlazor.MudText>
                    <MudBlazor.MudText Typo="MudBlazor.Typo.body2">@noMatch.Line</MudBlazor.MudText>
                    <MudBlazor.MudButton Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Primary" OnClick="noMatch.OnAction">@noMatch.Action</MudBlazor.MudButton>
                </div>
            }
        }
        else
        {
            @* The channels (design system: LibraryDrawer): a single-select listbox. Picking one opens
               its recordings column; in the rail each option is an avatar that opens the drawer
               on that channel. library-keys.js moves through the options and into the column. *@
            <div class="sk-channels" role="listbox" aria-label="Channels" data-channel-list>
                @foreach (StreamerView streamer in streamers)
                {
                    IReadOnlyList<RecordingView> recordings = Library.Recordings(streamer.Login, _query);
                    bool selected = !Rail && streamer.Login == _selectedChannel;
                    bool tabStop = selected || (_selectedChannel is null || Rail ? streamer == streamers[0] : false);
                    <ChannelOption @key="streamer.Login"
                                   Streamer="streamer"
                                   Count="recordings.Count"
                                   Meta="@ChannelMeta(streamer, recordings)"
                                   Selected="selected"
                                   Current="@(streamer.Login == CurrentChannel)"
                                   TabStop="tabStop"
                                   Rail="Rail"
                                   Search="@_query.Search"
                                   OnSelect="() => SelectChannelAsync(streamer.Login)" />
                }
            </div>
        }
    }
</div>

@if (!Rail && Library.IsLoaded && SelectedStreamer is { } open)
{
    <RecordingsColumn @key="open.Login"
                      Streamer="open"
                      Recordings="Library.Recordings(open.Login, _query)"
                      SelectedId="@SelectedId"
                      Search="@_query.Search"
                      ViewQuery="@ViewQuery"
                      TimeZone="@Clock.TimeZone"
                      Now="@Clock.Now"
                      Compact="@Compact"
                      DeleteBlockedReason="DeleteBlockedReason"
                      OnDelete="OpenDelete"
                      OnClose="CloseColumnAsync" />
}

<DeleteRecordingDialog Recording="_deleteTarget"
                       Visible="@_deleteOpen"
                       VisibleChanged="OnDeleteOpenChanged"
                       BlockedReason="@(_deleteTarget is { } target ? DeleteBlockedReason(target) : null)"
                       OnDeleted="OnDeletedAsync" />

<div class="sk-drawer-foot">
    <StorageMeter FreeBytes="@Library.Storage.FreeBytes"
                  TotalBytes="@Library.Storage.TotalBytes"
                  Rail="@Rail"
                  OnOpen="ExpandFromRailAsync" />
</div>

@code {
    private const string KeysModule = "./js/library-keys.js";
    private const string DrawerModule = "./Components/Features/Library/LibraryDrawer.razor.js";

    // One row per sort: its URL key, the header and menu label, and the header arrow (named for
    // the data-sort-icon hook, drawn as a MudBlazor glyph). The first is the default.
    private sealed record SortChoice(string Key, string Label, string? IconName, string? Glyph);

    private static readonly SortChoice[] SortChoices =
    [
        new("newest", "Newest first", "arrow_downward", MudBlazor.Icons.Material.Rounded.ArrowDownward),
        new("oldest", "Oldest first", "arrow_upward", MudBlazor.Icons.Material.Rounded.ArrowUpward),
        new("az", "A–Z by streamer", null, null),
    ];

    private static readonly (string Key, string Label, string Icon)[] Filters =
    [
        ("all", "All", MudBlazor.Icons.Material.Rounded.ViewList),
        ("recording", "Recording", MudBlazor.Icons.Material.Rounded.FiberManualRecord),
        ("saved", "Saved", MudBlazor.Icons.Material.Rounded.Inventory2),
    ];

    // What the drawer says when a search or filter matches nothing, and its one way out.
    private sealed record NoMatchState(string Headline, string Line, string Action, Func<Task> OnAction);

    /// <summary>True while the shell shows the desktop rail (set by <c>AppShell</c>).</summary>
    [CascadingParameter(Name = "LibraryRail")] public bool Rail { get; set; }

    /// <summary>Below Md the drawer is temporary and the recordings column drills in.</summary>
    [CascadingParameter(Name = AppShell.CompactCascade)] public bool Compact { get; set; }

    /// <summary>True while the library is open, at every width (set by <c>AppShell</c>).</summary>
    [CascadingParameter(Name = AppShell.LibraryOpenCascade)] public bool Open { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The shell, which opens the library over the page (absent in isolated tests).</summary>
    [CascadingParameter] public AppShell? Shell { get; set; }

    private ElementReference _list;
    private bool _focusSortMenu;
    private IJSObjectReference? _drawerModule;
    private IJSObjectReference? _keys;
    private string? _selectedChannel;
    private string? _awaitingWatched;
    private bool _wasOpen;
    private bool _scrollToCurrent;
    private bool _signedIn;
    private Task<AuthenticationState>? _authState;
    private RecordingView? _deleteTarget;
    private bool _deleteOpen;
    private (int Index, string Id)? _focusAfterDelete;
    private bool _resetScroll;
    private LibraryQuery _query = new();
    private string? _selectedId;
    private bool _disposed;

    private string? SelectedId => _selectedId;

    protected override void OnInitialized()
    {
        _selectedId = ParseSelectedId(Navigation.Uri);
        _query = LibraryUrl.Parse(Navigation.Uri);
        ResetChannel();
        Library.Changed += OnLibraryChanged;
        Clock.Changed += OnClockChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    // The shell re-renders the drawer on every preference change (a chat sync step, say), so
    // read the sign-in only when the state itself changes; otherwise each re-render would await
    // and render the drawer twice, and the extra renders slowed rapid input elsewhere.
    protected override async Task OnParametersSetAsync()
    {
        // The library is temporary: closing it forgets the channel picked in it.
        if (_wasOpen && !Open)
            ResetChannel();
        // Opening shows the watched recording's row, however long its channel's list is.
        _scrollToCurrent |= Open && !_wasOpen;
        _wasOpen = Open;

        if (ReferenceEquals(_authState, AuthenticationState))
            return;

        _authState = AuthenticationState;
        _signedIn = AuthenticationState is not null
            && (await AuthenticationState).User.Identity?.IsAuthenticated == true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender)
        {
            try
            {
                _keys = await JS.InvokeAsync<IJSObjectReference>("import", KeysModule);
                if (_disposed)
                {
                    // DisposeAsync ran during the import: release the module, never attach listeners.
                    await _keys.DisposeAsync();
                    return;
                }
                await _keys.InvokeVoidAsync("init", _list);
            }
            catch (JSException ex)
            {
                // Without the module the options and rows still work by pointer and Tab.
                Logger.LogDebug(ex, "The library keys module could not be initialized.");
            }

            return;
        }

        if (_focusSortMenu)
        {
            // MudMenu leaves focus on its trigger after a pointer open, and then spends the first
            // Escape moving focus into the list. The menu-button pattern puts focus on the current
            // choice when the menu opens, so one Escape closes it, as it always has here.
            _focusSortMenu = false;
            await FocusSortChoiceAsync();
        }

        if (_resetScroll)
        {
            _resetScroll = false;
            await InvokeKeysAsync("scrollToTop", _list);
        }

        if (_scrollToCurrent)
        {
            _scrollToCurrent = false;
            await InvokeKeysAsync("scrollCurrentIntoView", _list);
        }

        if (_focusAfterDelete is var (index, deletedId))
        {
            _focusAfterDelete = null;
            await InvokeKeysAsync("focusAfterDelete", _list, index, deletedId);
        }
    }

    // The watched recording's channel, ringed in the rail.
    private string? CurrentChannel => ChannelOf(_selectedId);

    private string? ChannelOf(string? recordingId) =>
        recordingId is not null && Library.IsLoaded ? Library.Find(recordingId)?.StreamerLogin : null;

    // The open column's channel; a channel the search or filter dropped closes it.
    private StreamerView? SelectedStreamer =>
        _selectedChannel is null
            ? null
            : Library.Streamers(_query).FirstOrDefault(streamer => streamer.Login == _selectedChannel);

    // "Recording now", or the day of the channel's latest matching recording.
    private string ChannelMeta(StreamerView streamer, IReadOnlyList<RecordingView> recordings) =>
        streamer.IsRecording ? "Recording now"
        : streamer.IsPaused ? "Paused"
        : recordings.Count > 0 ? Format.DayHeader(recordings.Max(r => r.StartedAt), Clock.Now, Clock.TimeZone)
        : "";

    private async Task SelectChannelAsync(string login)
    {
        if (Rail)
        {
            // In the rail an avatar opens the library on that channel, its recordings showing.
            _selectedChannel = login;
            Shell?.OpenLibrary();
            await Task.CompletedTask;
            return;
        }

        _selectedChannel = login;
    }

    private async Task CloseColumnAsync()
    {
        string? login = _selectedChannel;
        _selectedChannel = null;
        // BL0012 assumes the framework's post-callback render is soon enough. It is not:
        // the focus below queries the DOM, so the column must collapse first. Remove when
        // BL0012 stops treating an intentional render before a DOM read as redundant.
#pragma warning disable BL0012
        StateHasChanged();
#pragma warning restore BL0012
        if (login is not null)
            await FocusAsync($"[data-library-channel='{login}']");
    }

    // Why a row's Delete is unavailable: signed out, then the title block's rules.
    private string? DeleteBlockedReason(RecordingView recording) =>
        !_signedIn ? RequiresTwitch.SignedOutMessage
        : RecordingDelete.BlockedReason(recording, Exports.FindByRecording(recording.Id) is { IsActive: true });

    private async Task OpenDelete(RecordingView recording)
    {
        if (DeleteBlockedReason(recording) is not null)
            return;

        _deleteTarget = recording;
        _deleteOpen = true;
        // The row collapses out once the library drops it (library-keys.js).
        await InvokeKeysAsync("armRowCollapse", _list, recording.Id);
    }

    private async Task OnDeleteOpenChanged(bool open)
    {
        _deleteOpen = open;
        if (!open && _deleteTarget is { } target && Library.Find(target.Id) is not null)
        {
            // Cancelled: back to the row's own Delete button.
            _deleteTarget = null;
            await InvokeKeysAsync("disarmRowCollapse", _list);
            await FocusAsync($"[data-recording-id='{target.Id}'] ~ [data-row-delete]");
        }
    }

    private Task OnDeletedAsync(string recordingId)
    {
        RecordingView? target = _deleteTarget;
        _deleteTarget = null;
        if (target is not null)
        {
            // Focus moves to the row that took its place, or the one before it, or Close.
            IReadOnlyList<RecordingView> rows = Library.Recordings(target.StreamerLogin, _query);
            int index = 0;
            for (; index < rows.Count; index++)
            {
                if (rows[index].Id == recordingId)
                    break;
            }
            _focusAfterDelete = (index, recordingId);
        }

        // Deleting the watched recording is announced by the watch page, which also moves on.
        if (!string.Equals(recordingId, _selectedId, StringComparison.Ordinal))
            Snackbars.Show("Recording deleted");

        return Task.CompletedTask;
    }

    private async Task InvokeKeysAsync(string identifier, params object[] args)
    {
        if (_keys is null)
            return;

        try
        {
            await _keys.InvokeVoidAsync(identifier, args);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Library keys call {Identifier} failed.", identifier);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
    }

    private void OnLibraryChanged() => _ = InvokeAsync(() =>
    {
        // A deep link can arrive before the library has loaded; pick its channel once it has.
        if (_awaitingWatched is { } id && ChannelOf(id) is { } channel)
        {
            _selectedChannel = channel;
            _awaitingWatched = null;
            _scrollToCurrent = true;
        }

        StateHasChanged();
    });

    // What the library opens on (design system: LibraryDrawer): the watched recording's channel
    // on a watch page, or no channel elsewhere. A deep link can arrive before the library knows
    // the recording; OnLibraryChanged picks its channel once it does.
    private void ResetChannel()
    {
        _selectedChannel = null;
        _awaitingWatched = null;
        if (_selectedId is null)
            return;

        if (ChannelOf(_selectedId) is { } channel)
            _selectedChannel = channel;
        else
            _awaitingWatched = _selectedId;
    }

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        string? selected = ParseSelectedId(args.Location);
        LibraryQuery query = LibraryUrl.Parse(args.Location);
        if (string.Equals(selected, _selectedId, StringComparison.Ordinal) && query == _query)
            return;

        _resetScroll |= query != _query;
        bool pageChanged = !string.Equals(selected, _selectedId, StringComparison.Ordinal);
        _selectedId = selected;
        _query = query;
        // Picking a recording closes the library (the shell does that, which resets the channel
        // too). A closed library follows the page, so it opens on the right channel; an open one
        // keeps what is shown while only the query changes.
        if (pageChanged && !Open)
            ResetChannel();
        _ = InvokeAsync(StateHasChanged);
    }

    private string ViewQuery => LibraryUrl.With("/", _query)[1..];

    private bool Filtered => _query.Search is not null || _query.State is not null;

    // Search wins when both are set: clearing it is the smaller step, and the filter's own
    // no-match message follows if the filter still matches nothing. LibraryUrl normalizes
    // state to recording, saved or null, and null with no search is not a no-match.
    private NoMatchState NoMatch => _query.Search is { } search
        ? new($"No recordings match “{search}”", "Try another title, streamer or category.", "Clear search", ClearSearchAsync)
        : new(
            "No recordings match",
            _query.State == "recording" ? "Nothing is recording right now." : "No saved recordings.",
            "Show all recordings",
            ShowAllAsync);

    // The button that was pressed disappears, so focus moves to the control that now holds the state.
    private async Task ShowAllAsync()
    {
        SetState(null);
        await FocusAsync("[data-filter='all']");
    }

    private async Task ClearSearchAsync()
    {
        Navigate(_query with { Search = null });
        await FocusAsync("[data-search-input]");
    }

    private SortChoice CurrentSort =>
        Array.Find(SortChoices, choice => choice.Key == _query.Sort) ?? SortChoices[0];

    private void SetState(string? state) => Navigate(_query with { State = state });

    private void OnSortMenuOpenChanged(bool open) => _focusSortMenu = open;

    // Without the module the menu still works; only the first Escape moves focus instead.
    private Task FocusSortChoiceAsync() => FocusAsync($"[data-sort-option='{CurrentSort.Key}']");

    private async Task FocusAsync(string selector)
    {
        try
        {
            _drawerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DrawerModule);
            await _drawerModule.InvokeAsync<bool>("focusWhenPresent", selector);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not focus {Selector}.", selector);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnFilterChanged(string? key) => SetState(key is null or "all" ? null : key);

    private async Task ExpandFromRailAsync()
    {
        Shell?.OpenLibrary();
        await Task.CompletedTask;
    }

    private void SetSort(string sort) => Navigate(_query with { Sort = sort });

    // Filtering replaces the history entry so the back button skips view tweaks.
    private void Navigate(LibraryQuery query) =>
        Navigation.NavigateTo(LibraryUrl.With(Navigation.Uri, query), replace: true);

    private string? ParseSelectedId(string uri)
    {
        string relative = Navigation.ToBaseRelativePath(uri);
        if (!relative.StartsWith("r/", StringComparison.Ordinal))
            return null;

        string id = relative[2..];
        int query = id.IndexOf('?', StringComparison.Ordinal);
        if (query >= 0)
            id = id[..query];

        return id.Length == 0 ? null : Uri.UnescapeDataString(id);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Library.Changed -= OnLibraryChanged;
        Clock.Changed -= OnClockChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_drawerModule is not null)
        {
            try
            {
                await _drawerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_keys is not null)
        {
            try
            {
                await _keys.InvokeVoidAsync("dispose", _list);
                await _keys.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "Could not dispose the library keys module.");
            }
        }
    }
}
