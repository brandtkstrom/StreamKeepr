@using StreamKeepr.Ui
@implements IDisposable
@inject ILibraryView Library
@inject UiPreferences Preferences
@inject ViewerClock Clock
@inject NavigationManager Navigation

@* The layout owns the drawer, so it survives navigation and keeps its scroll position. *@
<div class="sk-drawer-head">
    <h2>Library</h2>
    <span class="sk-sort">
        <Icon Name="arrow_downward" Size="IconSize.Small" />
        Newest first
    </span>
</div>

<div class="sk-drawer-list"
     aria-busy="@(Library.IsLoaded ? null : "true")">
    @if (!Library.IsLoaded)
    {
        @for (int index = 0; index < 6; index++)
        {
            <div class="sk-row" data-library-skeleton aria-hidden="true">
                <span class="sk-thumb">
                    <Icon Name="movie" />
                    <span class="dur">--:--</span>
                </span>
                <span class="sk-row-text">
                    <span class="sk-row-title">Loading recording</span>
                    <span class="sk-row-meta">Loading library</span>
                </span>
            </div>
        }
    }
    else
    {
        IReadOnlyList<StreamerView> streamers = Library.Streamers(Query);
        if (streamers.Count == 0)
        {
            <p class="body-medium" data-library-empty>No recordings yet</p>
        }
        else
        {
            @foreach (StreamerView streamer in streamers)
            {
                <StreamerGroup @key="streamer.Login"
                               Streamer="streamer"
                               Recordings="Library.Recordings(streamer.Login, Query)"
                               Expanded="@(!Preferences.IsCollapsed(streamer.Login))"
                               SelectedId="@SelectedId"
                               TimeZone="@Clock.TimeZone"
                               Now="@Clock.Now"
                               OnToggle="@(() => ToggleGroupAsync(streamer.Login))" />
            }
        }
    }
</div>

@code {
    private static readonly LibraryQuery Query = new();

    private string? _selectedId;
    private bool _disposed;

    private string? SelectedId => _selectedId;

    protected override void OnInitialized()
    {
        _selectedId = ParseSelectedId(Navigation.Uri);
        Library.Changed += OnLibraryChanged;
        Clock.Changed += OnClockChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async Task ToggleGroupAsync(string login)
    {
        Preferences.SetCollapsed(login, !Preferences.IsCollapsed(login));
        await Preferences.PersistAsync();
    }

    private void OnLibraryChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        string? selected = ParseSelectedId(args.Location);
        if (string.Equals(selected, _selectedId, StringComparison.Ordinal))
            return;

        _selectedId = selected;
        _ = InvokeAsync(StateHasChanged);
    }

    private string? ParseSelectedId(string uri)
    {
        string relative = Navigation.ToBaseRelativePath(uri);
        if (!relative.StartsWith("r/", StringComparison.Ordinal))
            return null;

        string id = relative[2..];
        int query = id.IndexOf('?', StringComparison.Ordinal);
        if (query >= 0)
            id = id[..query];

        return id.Length == 0 ? null : Uri.UnescapeDataString(id);
    }

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        Library.Changed -= OnLibraryChanged;
        Clock.Changed -= OnClockChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
