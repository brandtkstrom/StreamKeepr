@using StreamKeepr.Infrastructure.Runtime
@implements IDisposable
@inject IChannelsView Channels
@inject SnackbarService Snackbars
@inject ILogger<ChannelSettings> Logger

@* Rendered only for a signed-in admin. ChannelsView enforces the same rule on every call. *@
<section class="sk-panel sk-settings-section" aria-labelledby="sk-settings-push">
    <h2 id="sk-settings-push">Push status</h2>
    <p class="body-medium" role="status" data-push-status>@PushStatusText</p>
</section>

<section class="sk-panel sk-settings-section" aria-labelledby="sk-settings-channels">
    <h2 id="sk-settings-channels">Channels</h2>

    @if (_channels.Count == 0)
    {
        <p class="sk-settings-empty" data-channels-empty>No channels watched.</p>
    }
    else
    {
        <ul class="sk-channel-list" data-channel-list>
            @foreach (ChannelView channel in _channels)
            {
                bool removing = _removing.Contains(channel.Login);
                bool busy = removing || IsBusy(channel.Login);
                <li class="sk-channel-row" @key="channel.Login" data-channel="@channel.Login" aria-busy="@(busy ? "true" : null)">
                    <Avatar Name="@channel.DisplayName" ImageUrl="@channel.AvatarUrl" aria-hidden="true" />
                    <span class="who">
                        <b>@channel.DisplayName</b>
                        <span class="login">@channel.Login</span>
                    </span>
                    <StatusChip Status="@ChipKind(channel.State)" Label="@StateLabel(channel.State)" Icon="@StateIcon(channel.State)" data-channel-state="@channel.State" />
                    <StatusChip Status="StatusChipKind.Saved"
                                Label="@(channel.PushConnected ? "Push" : "Polling")"
                                Icon="@(channel.PushConnected ? null : "schedule")"
                                title="@channel.PushReason"
                                data-push="@(channel.PushConnected ? "connected" : "polling")" />
                    <span class="grow"></span>
                    @if (busy)
                    {
                        <span class="sk-channel-busy" role="status">@BusyLabel(channel.Login)</span>
                    }
                    else
                    {
                        @if (IsPaused(channel))
                        {
                            <Button Variant="ButtonVariant.Text"
                                    OnClick="() => ResumeAsync(channel)"
                                    aria-label="@($"Resume recording for {channel.DisplayName}")"
                                    data-channel-resume>
                                Resume recording
                            </Button>
                        }
                        else
                        {
                            <Button Variant="ButtonVariant.Text"
                                    OnClick="() => AskStop(channel)"
                                    aria-label="@($"{StopLabel(channel)} for {channel.DisplayName}")"
                                    data-channel-stop>
                                @StopLabel(channel)
                            </Button>
                        }
                        <Button Variant="ButtonVariant.Text"
                                OnClick="() => AskRemove(channel)"
                                aria-label="@($"Remove {channel.DisplayName}")"
                                data-channel-remove>
                            Remove
                        </Button>
                    }
                    @if (_rowErrors.TryGetValue(channel.Login, out string? rowError))
                    {
                        <p class="sk-field-error" role="alert">@rowError</p>
                    }
                </li>
            }
        </ul>
    }

    <div class="sk-channel-add">
        <label for="sk-channel-login">Add channel</label>
        <div class="row">
            <input id="sk-channel-login"
                   type="text"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Twitch login"
                   aria-describedby="@(_addError is null ? null : "sk-channel-add-error")"
                   aria-invalid="@(_addError is null ? null : "true")"
                   @bind="_login"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDownAsync"
                   @ref="_input"
                   data-channel-login />
            <button type="button"
                    class="sk-btn filled"
                    disabled="@(!CanAdd)"
                    aria-busy="@(_adding ? "true" : null)"
                    @onclick="AddAsync"
                    data-channel-add>
                @if (_adding)
                {
                    <span class="sk-spin" aria-hidden="true"></span>
                    <span>Adding…</span>
                }
                else
                {
                    <span>Add</span>
                }
            </button>
        </div>
        @if (_addError is not null)
        {
            <p class="sk-field-error" id="sk-channel-add-error" role="alert" data-channel-add-error>@_addError</p>
        }
    </div>
</section>

<Dialog Open="@(_confirm is not null)"
        OpenChanged="OnConfirmOpenChanged"
        Title="@($"Remove {_confirm?.DisplayName}?")"
        data-channel-remove-dialog>
    <ChildContent>
        <p>Recordings are kept. An open capture is finalized first.</p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Text" OnClick="CancelRemove">Cancel</Button>
        <Button Variant="ButtonVariant.Danger" OnClick="ConfirmRemoveAsync" data-channel-remove-confirm>Remove</Button>
    </Actions>
</Dialog>

<Dialog Open="@(_stop is not null)"
        OpenChanged="OnStopOpenChanged"
        Title="@StopTitle"
        data-channel-stop-dialog>
    <ChildContent>
        <p>@StopBody</p>
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Text" OnClick="CancelStop" data-channel-stop-cancel>Cancel</Button>
        <Button Variant="ButtonVariant.Danger"
                Disabled="@(_stop is not null && IsBusy(_stop.Login))"
                OnClick="ConfirmStopAsync"
                data-channel-stop-confirm>
            @StopActionLabel
        </Button>
    </Actions>
</Dialog>

@code {
    private const string SessionEnded = "Your Twitch session ended. Reconnect to manage channels.";

    private readonly HashSet<string> _removing = new(StringComparer.Ordinal);
    private readonly HashSet<string> _stopping = new(StringComparer.Ordinal);
    private readonly HashSet<string> _resuming = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rowErrors = new(StringComparer.Ordinal);
    private IReadOnlyList<ChannelView> _channels = [];
    private ElementReference _input;
    private string _login = "";
    private string? _addError;
    private bool _adding;
    private ChannelView? _confirm;
    private ChannelView? _stop;

    private bool CanAdd => !_adding && !string.IsNullOrWhiteSpace(_login);

    private string PushStatusText
    {
        get
        {
            if (_channels.Count == 0)
                return "No channels watched.";

            string? reason = _channels
                .FirstOrDefault(channel => !channel.PushConnected)?.PushReason;
            if (reason is null)
                return "Push notifications on";

            return $"Polling only — {reason}";
        }
    }

    private bool IsBusy(string login) =>
        _stopping.Contains(login) || _resuming.Contains(login);

    private static bool IsPaused(ChannelView channel) =>
        channel.State == ChannelRuntimeState.Paused;

    private static bool IsLive(ChannelView channel) =>
        channel.State is ChannelRuntimeState.Recording or ChannelRuntimeState.Reconnecting;

    private static string StopLabel(ChannelView channel) =>
        IsLive(channel) ? "Stop recording" : "Pause channel";

    private string BusyLabel(string login) =>
        _removing.Contains(login) ? "Removing…"
        : _stopping.Contains(login) ? "Stopping…"
        : "Resuming…";

    private string StopTitle =>
        _stop is null ? "Stop recording?"
        : IsLive(_stop) ? $"Stop recording for {_stop.DisplayName}?"
        : $"Pause {_stop.DisplayName}?";

    private string StopBody =>
        _stop is not null && IsLive(_stop)
            ? "The current capture is finalized, and the channel stays paused until you resume."
            : "The channel stays paused until you resume.";

    private string StopActionLabel =>
        _stop is not null && IsLive(_stop) ? "Stop recording" : "Pause channel";

    protected override void OnInitialized()
    {
        Channels.Changed += OnChannelsChanged;
        Refresh();
    }

    internal static StatusChipKind ChipKind(ChannelRuntimeState state) => state switch
    {
        ChannelRuntimeState.Recording => StatusChipKind.Rec,
        ChannelRuntimeState.Reconnecting => StatusChipKind.Reconnecting,
        ChannelRuntimeState.CoolingDown => StatusChipKind.Processing,
        _ => StatusChipKind.Saved,
    };

    // Neutral states reuse the outlined chip without its "saved" check mark.
    internal static string? StateIcon(ChannelRuntimeState state) => state switch
    {
        ChannelRuntimeState.Paused => "pause",
        ChannelRuntimeState.Watching => "visibility",
        _ => null,
    };

    internal static string StateLabel(ChannelRuntimeState state) => state switch
    {
        ChannelRuntimeState.Recording => "Rec",
        ChannelRuntimeState.Reconnecting => "Reconnecting",
        ChannelRuntimeState.Paused => "Paused",
        ChannelRuntimeState.CoolingDown => "Cooling down",
        _ => "Watching",
    };

    private void Refresh()
    {
        try
        {
            _channels = Channels.All;
        }
        catch (UnauthorizedAccessException ex)
        {
            // The session ended under the page; the shell re-renders the signed-out branch.
            Logger.LogDebug(ex, "Channel list hidden: the circuit is no longer signed in.");
            _channels = [];
        }

        if (_stop is not null && _channels.All(channel => channel.Login != _stop.Login))
            _stop = null;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await AddAsync();
    }

    private async Task AddAsync()
    {
        if (!CanAdd)
            return;

        string login = _login.Trim().ToLowerInvariant();
        _adding = true;
        _addError = null;
        try
        {
            await Channels.AddAsync(login, CancellationToken.None);
            _login = "";
            Snackbars.Show("Channel added");
            Refresh();
        }
        catch (Exception ex)
        {
            _addError = AddErrorMessage(ex, login);
        }
        finally
        {
            _adding = false;
        }

        await _input.FocusAsync();
    }

    /// <summary>User-safe text for an add failure. The control surface's messages are user-safe.</summary>
    internal string AddErrorMessage(Exception ex, string login)
    {
        switch (ex)
        {
            case UnknownChannelException:
                return $"No Twitch channel is named “{login}”.";
            case ArgumentException:
                return "That is not a valid Twitch login.";
            case InvalidOperationException:
                return ex.Message;
            case UnauthorizedAccessException:
                return SessionEnded;
            default:
                Logger.LogWarning(ex, "Adding channel {Login} failed.", login);
                return "Could not reach Twitch. Try again.";
        }
    }

    private void AskRemove(ChannelView channel)
    {
        _rowErrors.Remove(channel.Login);
        _confirm = channel;
    }

    private void CancelRemove() => _confirm = null;

    private void OnConfirmOpenChanged(bool open)
    {
        if (!open)
            _confirm = null;
    }

    private async Task ConfirmRemoveAsync()
    {
        if (_confirm is not { } channel)
            return;

        _confirm = null;
        _removing.Add(channel.Login);
        StateHasChanged();
        try
        {
            // No client timeout: the recorder's stop budget bounds how long finalizing takes,
            // and abandoning the wait would report a failure for a removal that still lands.
            await Channels.RemoveAsync(channel.Login, CancellationToken.None);
            Snackbars.Show("Channel removed");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Removing channel {Login} failed.", channel.Login);
            _rowErrors[channel.Login] = ex is UnauthorizedAccessException
                ? SessionEnded
                : $"Could not remove {channel.DisplayName}. Try again.";
        }
        finally
        {
            _removing.Remove(channel.Login);
            Refresh();
        }
    }


    private void AskStop(ChannelView channel)
    {
        _rowErrors.Remove(channel.Login);
        _stop = channel;
    }

    private void CancelStop() => _stop = null;

    private void OnStopOpenChanged(bool open)
    {
        if (!open)
            _stop = null;
    }

    private async Task ConfirmStopAsync()
    {
        if (_stop is not { } channel)
            return;

        _stop = null;
        _stopping.Add(channel.Login);
        try
        {
            // The channel is paused immediately; the coordinator finalizes in its queue.
            await Channels.StopAsync(channel.Login, CancellationToken.None);
            Snackbars.Show("Channel paused");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stopping channel {Login} failed.", channel.Login);
            _rowErrors[channel.Login] = ex is UnauthorizedAccessException
                ? SessionEnded
                : $"Could not stop {channel.DisplayName}. Try again.";
        }
        finally
        {
            _stopping.Remove(channel.Login);
            Refresh();
        }
    }

    private async Task ResumeAsync(ChannelView channel)
    {
        if (IsBusy(channel.Login) || _removing.Contains(channel.Login))
            return;

        _rowErrors.Remove(channel.Login);
        _resuming.Add(channel.Login);
        try
        {
            await Channels.ResumeAsync(channel.Login, CancellationToken.None);
            Snackbars.Show("Recording resumed");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Resuming channel {Login} failed.", channel.Login);
            _rowErrors[channel.Login] = ex is UnauthorizedAccessException
                ? SessionEnded
                : $"Could not resume {channel.DisplayName}. Try again.";
        }
        finally
        {
            _resuming.Remove(channel.Login);
            Refresh();
        }
    }

    private void OnChannelsChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    public void Dispose() => Channels.Changed -= OnChannelsChanged;
}
