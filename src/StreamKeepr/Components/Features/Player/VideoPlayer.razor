@using System.Globalization
@using StreamKeepr.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UiPreferences Preferences
@inject PlayerBridge Bridge
@inject StreamKeepr.Infrastructure.Storage.IProgressStore Progress
@inject ILogger<VideoPlayer> Logger

@* Rendered once. VideoPlayer.razor.js owns hls.js, every control, and all dynamic player DOM;
   Blazor never re-renders this markup, so it cannot overwrite JS-owned attributes or text.
   Hooks are data-sk attributes (see the HOOKS list in the module). No MudBlazor components:
   icons are inline Material Rounded SVG (IslandIcon) and colours come from the player-* tokens. *@
<div class="sk-player"
     data-sk-player
     role="region"
     aria-label="Video player"
     tabindex="0"
     aria-busy="true"
     @ref="_root">
    <video data-sk="video"
           playsinline
           preload="metadata"
           poster="@Recording.ThumbnailUrl"
           aria-label="@Recording.Title"></video>

    <div class="sk-player-top">
        <div class="t">
            <b data-sk="title">@Recording.Title</b>
            <span class="meta">
                <span data-sk="streamer">@Recording.StreamerLogin</span>
                @* The module names the chapter under the playhead; hidden until it has one. *@
                <span class="chapter" data-sk="chapter" hidden>
                    @IslandIcon.Svg("Toc")
                    <span class="sk-visually-hidden">Chapter </span>
                    <span data-sk="chapter-title"></span>
                </span>
            </span>
        </div>
        <span data-sk="chip"></span>
    </div>

    <button type="button" class="sk-player-center" data-sk="center" aria-label="Play">@IslandIcon.Svg("PlayArrow")</button>

    <div class="sk-player-spinner" data-sk="spinner" hidden>
        <span class="sk-spin" data-spinner aria-hidden="true"></span>
        <span class="sk-visually-hidden" data-sk="spinner-text">Loading video</span>
        @* The module owns this text: first-segment wait or reconnect (contract §13). *@
        <p class="sk-player-waiting" data-sk="waiting" role="status" hidden></p>
    </div>

    <div class="sk-player-overlay" data-sk="overlay" role="alert" hidden>
        @IslandIcon.Svg("Error")
        <p data-sk="overlay-message"></p>
        <div class="actions">
            <button type="button" class="sk-player-action filled" data-sk="retry">Retry</button>
            <a class="sk-player-action text" href="/">Back to library</a>
        </div>
    </div>

    @* The Statistics overlay (design system: StatsPanel): inside the frame, so it shows in
       theater and fullscreen; above the title strip and controls, below the menus. *@
    <StatsPanel @ref="_stats" Recording="Recording" />

    <div class="sk-player-bottom" data-sk="bottom-bar">
        <div class="sk-seek"
             data-sk="seek"
             role="slider"
             tabindex="0"
             aria-label="Seek"
             aria-valuemin="0"
             aria-valuemax="@Max"
             aria-valuenow="0"
             aria-valuetext="0:00 of @Format.Timecode(Recording.DurationSec)"
             aria-disabled="true">
            <div class="track">
                <div class="buf" data-sk="buffered"></div>
                <div class="played" data-sk="played"></div>
            </div>
            <div class="ticks" data-sk="ticks" aria-hidden="true"></div>
            <div class="knob" data-sk="knob"></div>
            <span class="edge" data-sk="edge" aria-hidden="true" hidden></span>
            <span class="hover-time" data-sk="hover-time" aria-hidden="true">0:00</span>
        </div>

        <div class="sk-controls">
            <button type="button" class="sk-player-btn" data-sk="play" aria-label="Play">@IslandIcon.Svg("PlayArrow")</button>
            <button type="button" class="sk-player-btn" data-sk="back" data-skip="-10" aria-label="Back 10 seconds" disabled>@IslandIcon.Svg("Replay10")</button>
            <button type="button" class="sk-player-btn" data-sk="forward" data-skip="10" aria-label="Forward 10 seconds" disabled>@IslandIcon.Svg("Forward10")</button>
            <div class="sk-vol">
                <button type="button" class="sk-player-btn" data-sk="mute" aria-label="Mute">@IslandIcon.Svg("VolumeUp")</button>
                <div class="bar"
                     data-sk="volume"
                     role="slider"
                     tabindex="0"
                     aria-label="Volume"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="100"
                     aria-valuetext="100%"><i data-sk="volume-level" style="width:100%"></i></div>
            </div>
            <span class="sk-time">
                <span data-sk="current">0:00</span>
                <span class="dim">/ <span data-sk="duration">@Format.Timecode(Recording.DurationSec)</span></span>
            </span>
            <button type="button" class="sk-golive" data-sk="live" aria-label="Jump to live edge" hidden>
                <span class="dot" aria-hidden="true"></span>
                <span class="lbl-long">Jump to live</span>
                <span class="lbl-short">Live</span>
            </button>
            <span class="grow"></span>
            <div class="sk-player-menu-anchor">
                <button type="button"
                        class="sk-pill"
                        data-sk="speed"
                        data-menu="m-speed"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-controls="@SpeedMenuId"
                        aria-label="Playback speed: 1×">1×</button>
                <div class="sk-player-menu" id="@SpeedMenuId" data-sk="speed-menu" role="menu" aria-label="Playback speed" hidden>
                    @foreach (double rate in Speeds)
                    {
                        <button type="button"
                                role="menuitemradio"
                                tabindex="-1"
                                data-rate="@rate.ToString(CultureInfo.InvariantCulture)"
                                aria-checked="@(rate == 1 ? "true" : "false")">
                            @IslandIcon.Svg("Check")
                            <span class="sp">@(rate == 1 ? "Normal" : $"{rate.ToString(CultureInfo.InvariantCulture)}×")</span>
                        </button>
                    }
                </div>
            </div>
            <button type="button"
                    class="sk-player-btn"
                    data-sk="stats"
                    aria-label="Statistics"
                    aria-keyshortcuts="I"
                    aria-pressed="@(StatsOpen ? "true" : "false")">@IslandIcon.Svg("QueryStats")</button>
            @* Shown by the module once a chat pane announces itself (sk:chat); mirrors the C key. *@
            <button type="button"
                    class="sk-player-btn"
                    data-sk="chat"
                    aria-label="Chat"
                    aria-keyshortcuts="C"
                    aria-pressed="false"
                    hidden>@IslandIcon.Svg("Chat")</button>
            <button type="button" class="sk-player-btn" data-sk="pip" data-pip aria-label="Picture in picture" hidden>@IslandIcon.Svg("PictureInPictureAlt")</button>
            <button type="button"
                    class="sk-player-btn"
                    data-sk="theater"
                    data-theater
                    aria-label="Theater mode"
                    aria-pressed="@(Preferences.Theater ? "true" : "false")">@IslandIcon.Svg("WidthWide")</button>
            <button type="button" class="sk-player-btn" data-sk="fullscreen" aria-label="Full screen">@IslandIcon.Svg("Fullscreen")</button>
        </div>
    </div>
</div>

@code {
    private const string ModulePath = "./Components/Features/Player/VideoPlayer.razor.js";
    private static readonly double[] Speeds = [0.5, 1, 1.5, 2];

    private readonly string SpeedMenuId = $"sk-speed-{Guid.NewGuid():N}";
    private ElementReference _root;
    private StatsPanel? _stats;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VideoPlayer>? _self;
    private RecordingView? _loaded;
    private bool _ready;
    private bool _theater;
    private bool _theaterAvailable = true;
    private bool _disposed;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    /// <summary>Initial sk-ui stats state; the player and panel modules toggle it.</summary>
    [Parameter] public bool StatsOpen { get; set; }

    /// <summary>False below <c>Breakpoint.Md</c>: theater has no meaning there.</summary>
    [Parameter] public bool TheaterAvailable { get; set; } = true;

    /// <summary>
    /// One-shot player-open intent from a library selection. It reaches only the load payload,
    /// so a same-recording update never starts playback again.
    /// </summary>
    [Parameter] public bool Autoplay { get; set; }

    private string Max => Math.Max(0, Recording.DurationSec).ToString("0.###", CultureInfo.InvariantCulture);

    // The skeleton renders once; afterwards only the JS module changes the player DOM.
    protected override bool ShouldRender() => !_ready;

    protected override void OnInitialized()
    {
        _theater = Preferences.Theater;
        _theaterAvailable = TheaterAvailable;
        Preferences.Changed += OnPreferencesChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_module is null || _loaded is null)
        {
            _theaterAvailable = TheaterAvailable;
            return;
        }

        if (_theaterAvailable != TheaterAvailable)
        {
            _theaterAvailable = TheaterAvailable;
            await InvokeAsync("setTheaterAvailable", _root, _theaterAvailable);
        }

        if (ReferenceEquals(_loaded, Recording))
            return;

        string identifier = string.Equals(_loaded.Id, Recording.Id, StringComparison.Ordinal)
            ? "update"
            : "load";
        _loaded = Recording;
        await InvokeAsync(identifier, _root, ToPayload(Recording));
        // This component never re-renders, so the overlay inside it gets the recording here.
        if (_stats is not null)
            await _stats.SetRecordingAsync(Recording);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _ready = true;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _loaded = Recording;
            if (_disposed)
            {
                // DisposeAsync ran during the import: release the module, never attach listeners.
                await _module.DisposeAsync();
                return;
            }
            await _module.InvokeVoidAsync("init", _root, _self, ToPayload(Recording));
            if (_disposed)
            {
                // DisposeAsync ran while init was in flight; it already detached the bridge
                // and released the module, so do not attach a callback into disposed state.
                _module = null;
                return;
            }

            Bridge.Attach(SeekAsync, PlayAsync);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to initialize.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The video player module could not be initialized.");
        }
    }

    private async Task InvokeAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Video player call {Identifier} failed.", identifier);
        }
    }

    internal object ToPayload(RecordingView recording) => new
    {
        recordingId = recording.Id,
        playlistUrl = recording.PlaylistUrl,
        title = recording.Title,
        streamerLogin = recording.StreamerLogin,
        thumbnailUrl = recording.ThumbnailUrl,
        state = recording.State switch
        {
            RecordingState.Recording => "recording",
            RecordingState.Reconnecting => "reconnecting",
            RecordingState.Partial => "partial",
            _ => "saved",
        },
        durationSec = recording.DurationSec,
        resumeSec = recording.ResumeSec,
        autoplay = Autoplay,
        statsOpen = StatsOpen,
        theater = Preferences.Theater,
        theaterAvailable = TheaterAvailable,
        chapters = recording.Chapters.Select(chapter => new
        {
            startSeconds = chapter.StartSeconds,
            title = chapter.Title,
            game = chapter.Game,
        }).ToArray(),
    };

    /// <summary>Persists a stats toggle made from the player-owned stats button.</summary>
    [JSInvokable]
    public async Task SetStatsOpen(bool open)
    {
        Preferences.SetStatsOpen(open);
        await Preferences.PersistAsync();
    }

    /// <summary>
    /// The player's 15 s and on-pause saves. The id travels with the call so a save that was
    /// already in flight when the recording changed lands on the recording it belongs to.
    /// </summary>
    [JSInvokable]
    public Task SaveProgress(string recordingId, double positionSec) =>
        Progress.SetAsync(recordingId, positionSec, CancellationToken.None);

    /// <summary>Ended, replay, or a position near the end: drop the stored position.</summary>
    [JSInvokable]
    public Task ClearProgress(string recordingId) =>
        Progress.ClearAsync(recordingId, CancellationToken.None);

    /// <summary>Persists a theater toggle made from the player button or the T shortcut.</summary>
    [JSInvokable]
    public async Task SetTheater(bool theater)
    {
        Preferences.SetTheater(theater);
        await Preferences.PersistAsync();
    }

    // UiPreferences is the one theater state; mirror it into the JS-owned button.
    private void OnPreferencesChanged()
    {
        if (_theater == Preferences.Theater)
            return;

        _theater = Preferences.Theater;
        _ = InvokeAsync(() => InvokeAsync("setTheater", _root, _theater));
    }

    private async ValueTask SeekAsync(double seconds)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("seek", _root, seconds);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to seek.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "A player seek failed.");
        }
    }

    private async ValueTask PlayAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("play", _root);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to play.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "A player play request failed.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Preferences.Changed -= OnPreferencesChanged;
        Bridge.Detach();
        if (_module is not null)
        {
            await InvokeAsync("dispose", _root);
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no module left to release.
            }
        }

        _self?.Dispose();
    }
}
