@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PlayerBridge Bridge
@inject ILogger<ViewerChart> Logger

@* Rendered once. ViewerChart.razor.js fetches the viewer samples, draws the tile and chart, its
   labels, playhead and tooltip, fills the screen-reader table, writes the panel header's hint,
   and shares the samples with the Statistics overlay (viewer-store.js). *@
<div class="sk-viewers" data-sk-viewers @ref="_root">
    <div class="sk-tile sk-viewer-tile" data-sk="viewer-tile">
        <div class="lbl" data-sk="viewer-at">Viewers at 0:00</div>
        <div class="val" data-sk="viewer-count">—</div>
        <dl class="sk-kv">
            <dt>Now</dt>
            <dd data-sk="viewer-now">—</dd>
            <dt>Peak</dt>
            <dd data-sk="viewer-peak">—</dd>
            <dt>Average</dt>
            <dd data-sk="viewer-average">—</dd>
        </dl>
    </div>
    <div class="sk-vchart">
        <div class="plot"
             data-sk="viewer-chart"
             role="img"
             aria-label="No viewer data for this recording.">
            <svg data-sk="viewer-svg"
                 viewBox="0 0 1000 100"
                 preserveAspectRatio="none"
                 aria-hidden="true"
                 focusable="false"></svg>
            <span class="tip" data-sk="tip-viewers" aria-hidden="true"></span>
        </div>
        <table class="sk-visually-hidden" data-sr-only data-sk="table-viewers">
            <caption>Viewer count samples</caption>
            <thead>
                <tr><th scope="col">Time</th><th scope="col">Viewers</th></tr>
            </thead>
            <tbody data-sk="rows-viewers"></tbody>
        </table>
    </div>
</div>

@code {
    private const string ModulePath = "./Components/Features/Player/ViewerChart.razor.js";

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ViewerChart>? _self;
    private RecordingView? _loaded;
    private bool _ready;
    private bool _disposed;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    /// <summary>Raised when the recording turns out to have viewer samples, or no longer has.</summary>
    [Parameter] public EventCallback<bool> HasSamplesChanged { get; set; }

    // The skeleton renders once; afterwards the module changes every dynamic part.
    protected override bool ShouldRender() => !_ready;

    protected override async Task OnParametersSetAsync()
    {
        if (_module is null || _loaded is null || ReferenceEquals(_loaded, Recording))
            return;

        _loaded = Recording;
        await InvokeModuleAsync("update", _root, ToPayload(Recording));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _ready = true;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _loaded = Recording;
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            await _module.InvokeVoidAsync("init", _root, _self, ToPayload(Recording));
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The viewer chart module could not be initialized.");
        }
    }

    /// <summary>The module found samples for this recording, or found none.</summary>
    [JSInvokable]
    public Task SetHasSamples(bool hasSamples) => HasSamplesChanged.InvokeAsync(hasSamples);

    /// <summary>Seeks the player to a recording time picked on the chart.</summary>
    [JSInvokable]
    public Task Seek(double seconds) => Bridge.SeekAsync(seconds).AsTask();

    internal static object ToPayload(RecordingView recording) => new
    {
        recordingId = recording.Id,
        state = recording.State switch
        {
            RecordingState.Recording => "recording",
            RecordingState.Reconnecting => "reconnecting",
            RecordingState.Partial => "partial",
            _ => "saved",
        },
    };

    private async Task InvokeModuleAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Viewer chart call {Identifier} failed.", identifier);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        if (_module is not null)
        {
            await InvokeModuleAsync("dispose", _root);
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no module left to release.
            }
        }

        _self?.Dispose();
    }
}
