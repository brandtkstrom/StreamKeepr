@implements IAsyncDisposable
@inject ILibraryView Library
@inject ViewerClock Clock
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<HomeRows> Logger

@* Home at "/" with no recording open (design system: Home): every open session in the first row,
   the 20 newest complete sessions in the second, both newest first. The rows are the library's
   Recording and Saved filters, so a session moves rows on the Changed that completes it. *@
@if (!Library.IsLoaded || _open.Count > 0 || _recent.Count > 0)
{
    <div class="sk-home" data-home-rows>
        <section class="sk-shelf" aria-labelledby="@NowHeadingId">
            <div class="sk-shelf-head">
                <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Sensors" Class="sk-shelf-icon rec" aria-hidden="true" />
                <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h2" id="@NowHeadingId">Recording now</MudBlazor.MudText>
                @if (Library.IsLoaded)
                {
                    <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="sk-shelf-caption" data-row-count>@_open.Count</MudBlazor.MudText>
                }
            </div>
            @if (!Library.IsLoaded)
            {
                <RecordingCardSkeletons Size="RecordingCardSize.Large" />
            }
            else if (_open.Count == 0)
            {
                <p class="sk-shelf-note" data-nothing-recording>
                    Nothing is recording right now. A watched channel starts recording when it goes live.
                </p>
            }
            else
            {
                <ul class="sk-shelf-row large" aria-labelledby="@NowHeadingId">
                    @foreach (RecordingView recording in _open)
                    {
                        <li @key="recording.Id">@Card(recording, RecordingCardSize.Large)</li>
                    }
                </ul>
            }
        </section>

        <section class="sk-shelf" aria-labelledby="@RecentHeadingId">
            <div class="sk-shelf-head">
                <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.History" Class="sk-shelf-icon" aria-hidden="true" />
                <MudBlazor.MudText Typo="MudBlazor.Typo.h6" HtmlTag="h2" id="@RecentHeadingId">Recent recordings</MudBlazor.MudText>
                <MudBlazor.MudText Typo="MudBlazor.Typo.caption" HtmlTag="span" Class="sk-shelf-caption">Newest first</MudBlazor.MudText>
                <MudBlazor.MudSpacer />
                <MudBlazor.MudButton Variant="MudBlazor.Variant.Text" Size="MudBlazor.Size.Small" OnClick="ShowAllSavedAsync">Show all</MudBlazor.MudButton>
                @if (Library.IsLoaded)
                {
                    @* Mouse only: hidden from assistive technology and out of the tab order. *@
                    <span class="sk-shelf-chevrons">
                        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.ChevronLeft"
                                                 Size="MudBlazor.Size.Small"
                                                 aria-hidden="true"
                                                 tabindex="-1"
                                                 data-row-scroll="-1"
                                                 OnClick="() => ScrollRecentAsync(-1)" />
                        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.ChevronRight"
                                                 Size="MudBlazor.Size.Small"
                                                 aria-hidden="true"
                                                 tabindex="-1"
                                                 data-row-scroll="1"
                                                 OnClick="() => ScrollRecentAsync(1)" />
                    </span>
                }
            </div>
            @if (!Library.IsLoaded)
            {
                <RecordingCardSkeletons Size="RecordingCardSize.Default" />
            }
            else
            {
                <ul class="sk-shelf-row" aria-labelledby="@RecentHeadingId" @ref="_recentRow">
                    @foreach (RecordingView recording in _recent)
                    {
                        <li @key="recording.Id">@Card(recording, RecordingCardSize.Default)</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    /// <summary>How many complete sessions the Recent recordings row holds.</summary>
    private const int RecentLimit = 20;

    private const string Module = "./Components/Features/Home/HomeRows.razor.js";

    private const string NowHeadingId = "sk-now";
    private const string RecentHeadingId = "sk-recent";

    private static readonly LibraryQuery OpenSessions = new(State: "recording");
    private static readonly LibraryQuery CompleteSessions = new(State: "saved");

    private IReadOnlyList<RecordingView> _open = [];
    private IReadOnlyList<RecordingView> _recent = [];
    private Dictionary<string, StreamerView> _streamers = new(StringComparer.Ordinal);
    private ElementReference _recentRow;
    private IJSObjectReference? _module;

    /// <summary>The shell, when Home renders inside it: it owns the drawer that "Show all" opens.</summary>
    [CascadingParameter] public AppShell? Shell { get; set; }

    protected override void OnInitialized()
    {
        Library.Changed += OnLibraryChanged;
        Clock.Changed += OnClockChanged;
        Refresh();
    }

    private void Refresh()
    {
        _open = Library.AllRecordings(OpenSessions);
        _recent = [.. Library.AllRecordings(CompleteSessions).Take(RecentLimit)];
        _streamers = Library.Streamers(new LibraryQuery())
            .ToDictionary(streamer => streamer.Login, StringComparer.Ordinal);
    }

    private RenderFragment Card(RecordingView recording, RecordingCardSize size) => __builder =>
    {
        StreamerView? streamer = _streamers.GetValueOrDefault(recording.StreamerLogin);
        <RecordingCard Recording="recording"
                       StreamerName="@(streamer?.DisplayName ?? recording.StreamerLogin)"
                       AvatarUrl="@streamer?.AvatarUrl"
                       Size="size"
                       TimeZone="@Clock.TimeZone"
                       Now="@Clock.Now" />
    };

    private async Task ShowAllSavedAsync()
    {
        string url = LibraryUrl.With("/", CompleteSessions);
        if (Shell is null)
            Navigation.NavigateTo(url);
        else
            await Shell.ShowLibraryAsync(url);
    }

    private async Task ScrollRecentAsync(int direction)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", Module);
            await _module.InvokeVoidAsync("scrollRow", _recentRow, direction);
        }
        catch (JSException ex)
        {
            // The row still scrolls by wheel, trackpad, touch and focus; only the chevron is lost.
            Logger.LogDebug(ex, "The Home rows module could not scroll a row.");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no row left to scroll.
        }
    }

    private void OnLibraryChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void OnClockChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Library.Changed -= OnLibraryChanged;
        Clock.Changed -= OnClockChanged;

        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no module left to release.
        }
    }
}
