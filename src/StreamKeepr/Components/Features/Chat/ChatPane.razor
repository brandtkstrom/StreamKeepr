@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UiPreferences Preferences
@inject ILogger<ChatPane> Logger
@inject IEnumerable<IEmoteProvider> EmoteProviders
@using System.Globalization
@using StreamKeepr.Hosting
@using StreamKeepr.Infrastructure.Emotes
@using StreamKeepr.Infrastructure.Storage

@* Rendered once. ChatPane.razor.js owns the log, polling, sync controls, and auto-scroll;
   Blazor never re-renders the pane after init. The toggle is JS-owned for the same reason.
   No MudBlazor components: it is drawn like an outlined MudPaper with plain markup.
   HideHeader renders the phone Chat tab (#175): the tab owns the disclosure, so the pane is
   always open and the header's toggle and state are left out. *@
<aside class="sk-chat"
       data-sk-chat
       data-open="@(_open ? "true" : "false")"
       aria-label="Chat replay"
       @ref="_root">
    @if (!HideHeader)
    {
        <header class="sk-chat-head">
            <button type="button"
                    class="sk-chat-toggle"
                    data-sk="chat-toggle"
                    aria-expanded="@(Open ? "true" : "false")"
                    aria-keyshortcuts="C"
                    aria-controls="@_bodyId"
                    aria-label="@(Open ? "Collapse chat" : "Open chat")">
                @IslandIcon.Svg("Chat")
                <span class="sk-chat-title" aria-hidden="true">Chat</span>
            </button>
            <span class="sk-chat-state" data-sk="chat-state" role="status" aria-live="polite">Loading chat…</span>
        </header>
    }

    <div id="@_bodyId" class="sk-chat-body" data-sk="chat-body" inert="@(_open ? null : "inert")">
        <div class="sk-chat-log"
             data-sk="chat-log"
             role="log"
             aria-live="off"
             aria-label="Chat replay"
             tabindex="0"></div>

        <div class="sk-chat-footer" data-sk="chat-footer">
            @* A native range styled like MudSlider Color.Primary: chat is a JS-owned island. The
               module draws the readout, aria-valuetext and fill, and applies the offset on change.
               The readout repeats the slider's value text, so it is hidden from assistive tech. *@
            <div class="sk-chat-sync" data-sk="chat-sync" hidden>
                <div class="sk-chat-sync-head">
                    @IslandIcon.Svg("Tune")
                    <label class="sk-chat-sync-label" for="@SyncId">Chat sync</label>
                    <span class="sk-chat-sync-value" data-sk="chat-sync-value" data-zero="true" aria-hidden="true">0.0 s</span>
                    <button type="button" class="sk-chat-sync-reset" data-sk="chat-sync-reset" aria-label="Reset chat sync to 0">
                        @IslandIcon.Svg("RestartAlt")
                    </button>
                </div>
                <div class="sk-chat-sync-slider">
                    <input id="@SyncId"
                           class="sk-chat-sync-range"
                           data-sk="chat-sync-range"
                           type="range"
                           min="@SyncMin"
                           max="@SyncMax"
                           step="@SyncStep"
                           value="0"
                           aria-valuetext="0 seconds" />
                </div>
                <div class="sk-chat-sync-ends" aria-hidden="true">
                    <span>Earlier</span>
                    <span>Later</span>
                </div>
            </div>
            <button type="button" class="sk-chat-jump" data-sk="chat-jump" hidden>Jump to current time</button>
            <span class="sk-chat-notice" data-sk="chat-notice" role="status" aria-live="polite"></span>
        </div>
    </div>
</aside>

@code {
    private const string ModulePath = "./Components/Features/Chat/ChatPane.razor.js";

    private readonly string _bodyId = $"sk-chat-{Guid.NewGuid():N}";
    private string SyncId => $"{_bodyId}-sync";

    // The endpoint's limit bounds the slider. Invariant culture keeps the attributes "-30" and
    // "30" whatever the server locale. The module reads the step back from the input.
    private static readonly string SyncMax = ChatReader.MaxSyncOffsetSeconds.ToString(CultureInfo.InvariantCulture);
    private static readonly string SyncMin = (-ChatReader.MaxSyncOffsetSeconds).ToString(CultureInfo.InvariantCulture);
    private const string SyncStep = "0.5";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChatPane>? _self;
    private RecordingView? _loaded;
    private bool _open;
    private bool _ready;
    private bool _disposed;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    [Parameter] public bool Open { get; set; }

    /// <summary>Below <c>Breakpoint.Md</c>: the Chat tab owns the disclosure, so the pane is
    /// always open and its header toggle and state are not rendered.</summary>
    [Parameter] public bool HideHeader { get; set; }

    protected override bool ShouldRender() => !_ready;

    protected override void OnInitialized() => _open = WantsOpen;

    private bool WantsOpen => HideHeader || Open;

    protected override async Task OnParametersSetAsync()
    {
        if (_module is null || _loaded is null)
            return;

        // A live library rebuild creates a new RecordingView on every throttled tick because
        // DurationSec changes. Loading the module on every instance would reapply the stale
        // summary HasChat (false until the library is resummarized) over the API's live value,
        // making the status and sync controls flap. Reload only when a meaningful field changes.
        if (!string.Equals(_loaded.Id, Recording.Id, StringComparison.Ordinal) ||
            _loaded.State != Recording.State ||
            _loaded.HasChat != Recording.HasChat)
        {
            _loaded = Recording;
            _open = WantsOpen;
            await InvokeModuleAsync("load", _root, ToPayload(Recording, _open));
            return;
        }

        if (_open != WantsOpen)
        {
            _open = WantsOpen;
            await InvokeModuleAsync("setOpen", _root, _open);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _ready = true;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _loaded = Recording;
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            await _module.InvokeVoidAsync("init", _root, _self, ToPayload(Recording, _open));
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The chat pane module could not be initialized.");
        }
    }

    /// <summary>Persists a toggle already applied by the JS module.</summary>
    [JSInvokable]
    public async Task SetChatOpen(bool open)
    {
        _open = open;
        Preferences.SetChatOpen(open);
        await Preferences.PersistAsync();
    }

    // Provider registration is the single source of truth, so adding 7TV needs no pane change.
    private bool EmotesEnabled => EmoteProviders.Any(provider => provider.Enabled);

    private object ToPayload(RecordingView recording, bool open) => new
    {
        recordingId = recording.Id,
        open,
        fixedOpen = HideHeader,
        emotesEnabled = EmotesEnabled,
        state = recording.State switch
        {
            RecordingState.Recording => ChatStates.Recording,
            RecordingState.Reconnecting => ChatStates.Reconnecting,
            _ => ChatStates.Complete,
        },
        hasChat = recording.HasChat,
        // The streamer's own messages take the channel colour the drawer shows; .NET owns the
        // hash (ChannelColor), so the module never computes a second copy.
        channelLogin = recording.StreamerLogin,
        channelColor = ChannelColor.For(recording.StreamerLogin),
        // The endpoint's limits are the source of truth; the module only applies them.
        limit = ChatEndpoint.DefaultLimit,
        maxSyncOffsetSec = ChatReader.MaxSyncOffsetSeconds,
    };

    private async Task InvokeModuleAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Chat pane call {Identifier} failed.", identifier);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        if (_module is not null)
        {
            await InvokeModuleAsync("dispose", _root);
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no module left to release.
            }
        }

        _self?.Dispose();
    }
}
