@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UiPreferences Preferences
@inject ILogger<ChatPane> Logger
@inject IEnumerable<IEmoteProvider> EmoteProviders
@inject IEnumerable<IBadgeSource> BadgeSources
@using StreamKeepr.Hosting
@using StreamKeepr.Infrastructure.Badges
@using StreamKeepr.Infrastructure.Emotes
@using StreamKeepr.Infrastructure.Storage

@* Rendered once. ChatPane.razor.js owns the log, polling, and auto-scroll, and applies the viewer's
   chat sync offset from Settings › Chat (UiPreferences); the root's data-open, data-badges,
   font attributes and font custom properties are painted here for the first frame, and the
   module owns them afterwards because Blazor never re-renders the pane once it is ready.
   The pane has no toggle of its own: the player's Chat button and C open and close it
   (sk:chat-toggle), the header's Close control closes it (#333), and closed it is not shown
   at all. There is no autofocus and no focus trap.
   No MudBlazor components: it is drawn like an outlined MudPaper with plain markup.
   HideHeader renders the phone Chat tab (#175): the tab owns the disclosure, so the pane is
   always open, the header is left out, and it has no Close control. *@
<aside class="sk-chat"
       data-sk-chat
       data-open="@(_open ? "true" : "false")"
       data-badges="@(_showBadges ? "true" : "false")"
       data-font-scale="@_fontScale.ToString(CultureInfo.InvariantCulture)"
       data-font-weight="@_fontWeight.ToString(CultureInfo.InvariantCulture)"
       style="@TypographyStyle"
       aria-label="Chat replay"
       @ref="_root">
    @if (!HideHeader)
    {
        <header class="sk-chat-head">
            @IslandIcon.Svg("Chat")
            <span class="sk-chat-title" data-sk="chat-title">Chat replay</span>
            @* The state is a decorative icon plus a visually hidden label and a title, so no state
               depends on colour alone. The module swaps both once it loads; this initial loading
               state keeps the header populated before then. Its glyph and wording mirror
               CHAT_STATES.loading in ChatPane.razor.js, so keep the two in step. *@
            <span class="sk-chat-state" data-sk="chat-state" data-state="loading" role="status" aria-live="polite" title="Loading chat…">
                @IslandIcon.Svg("HourglassEmpty")
                <span class="sk-visually-hidden" data-sk="chat-state-label">Loading chat…</span>
            </span>
            @* A close control, not a toggle (#333): the module closes the pane and persists the
               closed state, then returns focus to the player's Chat button when focus was inside
               the pane. Escape does the same; the phone tab renders no header. *@
            <button type="button"
                    class="sk-chat-close"
                    data-sk="chat-close"
                    aria-label="Close chat"
                    aria-keyshortcuts="Escape">@IslandIcon.Svg("Close")</button>
        </header>
    }

    <div id="@_bodyId" class="sk-chat-body" data-sk="chat-body" inert="@(_open ? null : "inert")">
        <div class="sk-chat-log"
             data-sk="chat-log"
             role="log"
             aria-live="off"
             aria-label="Chat replay"
             tabindex="0"></div>

        @* Outside the footer: a load error must not keep the footer, its border or its padding
           alive while the viewer is at the current time. This row is also the only visible
           error surface below Md, where the pane hides its header. *@
        <span class="sk-chat-notice" data-sk="chat-notice" role="status" aria-live="polite" hidden></span>

        @* JS owns this footer's presence: no footer is rendered while following; the node is
           reattached from here when the viewer is behind. *@
        <div class="sk-chat-footer" data-sk="chat-footer" hidden>
            <button type="button" class="sk-chat-jump" data-sk="chat-jump">Jump to current time</button>
        </div>
    </div>
</aside>

@code {
    private const string ModulePath = "./Components/Features/Chat/ChatPane.razor.js";

    private readonly string _bodyId = $"sk-chat-{Guid.NewGuid():N}";

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChatPane>? _self;
    private RecordingView? _loaded;
    private bool _open;
    private bool _ready;
    private bool _disposed;

    [Parameter, EditorRequired] public RecordingView Recording { get; set; } = null!;

    [Parameter] public bool Open { get; set; }

    /// <summary>Below <c>Breakpoint.Md</c>: the Chat tab owns the disclosure, so the pane is
    /// always open and its header toggle and state are not rendered.</summary>
    [Parameter] public bool HideHeader { get; set; }

    protected override bool ShouldRender() => !_ready;

    private double _syncOffset;
    private bool _showBadges;
    private int _fontScale;
    private int _fontWeight;

    protected override void OnInitialized()
    {
        _open = WantsOpen;
        _syncOffset = Preferences.ChatSyncOffset;
        _showBadges = Preferences.ChatShowBadges;
        _fontScale = Preferences.ChatFontScale;
        _fontWeight = Preferences.ChatFontWeight;
        Preferences.Changed += OnPreferencesChanged;
    }

    // Settings › Chat changes the one offset every recording uses; the Settings sheet opens over
    // a playing recording, so apply it to this pane at once (the module refetches).
    private void OnPreferencesChanged()
    {
        double offset = Preferences.ChatSyncOffset;
        if (offset != _syncOffset)
        {
            _syncOffset = offset;
            _ = InvokeAsync(() => InvokeModuleAsync("setSyncOffset", _root, offset));
        }

        // Badges are a separate preference: a change to one must not swallow the other.
        bool showBadges = Preferences.ChatShowBadges;
        if (showBadges != _showBadges)
        {
            _showBadges = showBadges;
            _ = InvokeAsync(() => InvokeModuleAsync("setShowBadges", _root, showBadges));
        }

        // Font size and weight are one preference pair for the log: apply both when either
        // changes, and never touch the sync offset or the badges.
        int fontScale = Preferences.ChatFontScale;
        int fontWeight = Preferences.ChatFontWeight;
        if (fontScale != _fontScale || fontWeight != _fontWeight)
        {
            _fontScale = fontScale;
            _fontWeight = fontWeight;
            _ = InvokeAsync(() => InvokeModuleAsync("setTypography", _root, fontScale, fontWeight));
        }
    }

    private bool WantsOpen => HideHeader || Open;

    protected override async Task OnParametersSetAsync()
    {
        if (_module is null || _loaded is null)
            return;

        // A live library rebuild creates a new RecordingView on every throttled tick because
        // DurationSec changes. Loading the module on every instance would reapply the stale
        // summary HasChat (false until the library is resummarized) over the API's live value,
        // making the status and sync controls flap. Reload only when a meaningful field changes.
        if (!string.Equals(_loaded.Id, Recording.Id, StringComparison.Ordinal) ||
            _loaded.State != Recording.State ||
            _loaded.HasChat != Recording.HasChat)
        {
            _loaded = Recording;
            _open = WantsOpen;
            await InvokeModuleAsync("load", _root, ToPayload(Recording, _open));
            return;
        }

        if (_open != WantsOpen)
        {
            _open = WantsOpen;
            await InvokeModuleAsync("setOpen", _root, _open);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _ready = true;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _loaded = Recording;
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            await _module.InvokeVoidAsync("init", _root, _self, ToPayload(Recording, _open));
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The chat pane module could not be initialized.");
        }
    }

    /// <summary>Persists a toggle already applied by the JS module.</summary>
    [JSInvokable]
    public async Task SetChatOpen(bool open)
    {
        _open = open;
        Preferences.SetChatOpen(open);
        await Preferences.PersistAsync();
    }

    // Provider registration is the single source of truth, so adding 7TV needs no pane change.
    private bool EmotesEnabled => EmoteProviders.Any(provider => provider.Enabled);

    // A badge source is registered per profile (Twitch or Mock); the pane fetches only when one is.
    private bool BadgesEnabled => BadgeSources.Any();

    // Painted for the first frame; the module owns the attributes and properties after it loads.
    private string TypographyStyle => string.Create(CultureInfo.InvariantCulture,
        $"--sk-chat-font-scale: {_fontScale}; --sk-chat-font-weight: {_fontWeight}");

    private object ToPayload(RecordingView recording, bool open) => new
    {
        recordingId = recording.Id,
        open,
        fixedOpen = HideHeader,
        emotesEnabled = EmotesEnabled,
        badgesEnabled = BadgesEnabled,
        state = recording.State switch
        {
            RecordingState.Recording => ChatStates.Recording,
            RecordingState.Reconnecting => ChatStates.Reconnecting,
            _ => ChatStates.Complete,
        },
        hasChat = recording.HasChat,
        // The streamer's own messages take the channel colour the drawer shows; .NET owns the
        // hash (ChannelColor), so the module never computes a second copy.
        channelLogin = recording.StreamerLogin,
        channelColor = ChannelColor.For(recording.StreamerLogin),
        // The endpoint's limits are the source of truth; the module only applies them.
        limit = ChatEndpoint.DefaultLimit,
        maxSyncOffsetSec = ChatReader.MaxSyncOffsetSeconds,
        // The viewer's one offset from Settings › Chat (UiPreferences), for every recording.
        syncOffsetSec = _syncOffset,
        // Badge images and their text-chip fallback; the module and CSS own the visibility.
        showBadges = _showBadges,
        // The chat log's font size and weight; the root carries them for the first frame.
        fontScale = _fontScale,
        fontWeight = _fontWeight,
    };

    private async Task InvokeModuleAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Chat pane call {Identifier} failed.", identifier);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Preferences.Changed -= OnPreferencesChanged;
        if (_module is not null)
        {
            await InvokeModuleAsync("dispose", _root);
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no module left to release.
            }
        }

        _self?.Dispose();
    }
}
