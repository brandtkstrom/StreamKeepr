@* Streamer avatar: image when available, otherwise initials. The ring marks an active recording. *@
<span class="@CssClass" role="img" aria-label="@Name" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="" />
    }
    else
    {
        @Initials
    }
    @if (Recording)
    {
        <span class="sk-live-ring" title="Recording now" aria-hidden="true"></span>
    }
</span>

@code {
    /// <summary>Display name used for the accessible label and generated initials.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "?";

    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public bool Recording { get; set; }

    [Parameter] public bool Large { get; set; }

    [Parameter] public AvatarTone Tone { get; set; } = AvatarTone.Default;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var tone = Tone switch
            {
                AvatarTone.Primary => " c1",
                AvatarTone.Tertiary => " c2",
                AvatarTone.Secondary => " c3",
                _ => "",
            };

            return Large ? $"sk-avatar lg{tone}" : $"sk-avatar{tone}";
        }
    }

    private string Initials
    {
        get
        {
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length >= 2)
                return string.Concat(parts[0][0], parts[1][0]);

            var name = parts.Length == 1 ? parts[0] : Name.Trim();
            return name.Length >= 2 ? name[..2] : name.Length == 1 ? name : "?";
        }
    }
}
