@implements IDisposable

<button type="button"
        role="menuitem"
        tabindex="-1"
        class="sk-menu-item"
        disabled="@Disabled"
        @onclick="SelectAsync"
        @ref="_element">
    @if (Icon is not null)
    {
        <span class="sk-icon" aria-hidden="true">@Icon</span>
    }
    <span class="sp">@ChildContent</span>
    @if (Selected)
    {
        <span class="sk-icon" aria-hidden="true">check</span>
    }
</button>

@code {
    private ElementReference _element;

    [CascadingParameter] private MenuContext? Context { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public bool Selected { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    protected override void OnInitialized() => Context?.Register(this);

    internal ValueTask FocusAsync() => _element.FocusAsync();

    private async Task SelectAsync()
    {
        if (Disabled)
            return;

        // Close first so a callback that opens a dialog captures the trigger as
        // the element to return focus to when that dialog closes.
        if (Context is not null)
            await Context.CloseAsync(returnFocus: true);

        await OnClick.InvokeAsync();
    }

    public void Dispose() => Context?.Unregister(this);
}
