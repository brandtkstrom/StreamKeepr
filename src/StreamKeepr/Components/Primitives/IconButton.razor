@* 40px icon target with a 24px glyph; the label is the accessible name. *@
<button type="button"
        class="sk-icon-btn @(Active ? "on" : null)"
        aria-label="@Label"
        aria-pressed="@(Toggle ? (Active ? "true" : "false") : null)"
        disabled="@Disabled"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    <Icon Name="@Icon" />
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Accessible name for the button.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Active { get; set; }

    /// <summary>Set when the button is a two-state control so it exposes <c>aria-pressed</c>.</summary>
    [Parameter] public bool Toggle { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
