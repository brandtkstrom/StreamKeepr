@* Small uppercase state chip; text carries the meaning and colour is the second cue. *@
<span class="sk-status @CssClass" @attributes="AdditionalAttributes">
    @if (Status == StatusChipKind.Rec)
    {
        <span class="dot" aria-hidden="true"></span>
    }
    else if (IconName is not null)
    {
        <Icon Name="@IconName" />
    }
    @Text
</span>

@code {
    [Parameter] public StatusChipKind Status { get; set; } = StatusChipKind.Saved;

    /// <summary>Overrides the default state text, e.g. “Twitch session expired”.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Status switch
    {
        StatusChipKind.Rec => "rec",
        StatusChipKind.Processing => "processing",
        StatusChipKind.Partial => "partial",
        StatusChipKind.Reconnecting => "partial",
        StatusChipKind.Error => "failed",
        _ => "saved",
    };

    private string? IconName => Status switch
    {
        StatusChipKind.Processing => "hourglass_top",
        StatusChipKind.Partial => "warning",
        StatusChipKind.Reconnecting => "sync",
        StatusChipKind.Saved => "check",
        StatusChipKind.Error => "warning",
        _ => null,
    };

    private string Text => Label ?? Status switch
    {
        StatusChipKind.Rec => "Rec",
        StatusChipKind.Reconnecting => "Reconnecting",
        StatusChipKind.Processing => "Processing",
        StatusChipKind.Partial => "Partial",
        StatusChipKind.Error => "Error",
        _ => "Saved",
    };
}
