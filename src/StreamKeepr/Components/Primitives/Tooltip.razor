@* A MudTooltip (design system Feedback card) around a wrapper that is also the element the
   text describes. MudTooltip renders its bubble only while shown, so the wrapper is described
   by a visually hidden copy that is always present for assistive technology. Additional
   attributes (tabindex, data hooks) apply to the wrapper. No interactive content inside. *@
<MudBlazor.MudTooltip Text="@Text" Placement="MudBlazor.Placement.Top" RootClass="sk-tooltip-root">
    <span class="sk-tooltip-wrap" aria-describedby="@_tooltipId" @attributes="AdditionalAttributes">
        @ChildContent
        <span id="@_tooltipId" class="sk-visually-hidden" role="tooltip">@Text</span>
    </span>
</MudBlazor.MudTooltip>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _tooltipId = $"sk-tooltip-{Guid.NewGuid():N}";
}
