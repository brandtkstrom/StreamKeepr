@* Material Symbols Rounded glyph. Decorative unless a label makes it meaningful. *@
<span class="@CssClass"
      data-icon="@Name"
      data-size="@SizeName"
      data-fill="@(Fill ? "" : null)"
      role="@(Label is null ? null : "img")"
      aria-hidden="@(Label is null ? "true" : null)"
      aria-label="@Label"
      @attributes="AdditionalAttributes">@Name</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public IconSize Size { get; set; } = IconSize.Large;

    [Parameter] public bool Fill { get; set; }

    /// <summary>Accessible label. Leave null for a decorative glyph.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>One map from size to its hook name and its design-system class suffix.</summary>
    private (string Name, string Class) SizeStyle => Size switch
    {
        IconSize.Small => ("small", " xs"),
        IconSize.Medium => ("medium", " sm"),
        _ => ("large", ""),
    };

    private string SizeName => SizeStyle.Name;

    private string CssClass => Fill ? $"sk-icon fill{SizeStyle.Class}" : $"sk-icon{SizeStyle.Class}";
}
