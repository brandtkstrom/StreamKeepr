@* A destructive confirmation (design system Dialog card): an inline MudDialog that the
   MudDialogProvider renders while the owner keeps its state. The h6 title names the dialog;
   Cancel (text) comes first and the filled Error confirm, which repeats the verb, last.
   MudDialog applies its own attributes only when it opens, so the data hooks and aria-busy
   sit on a wrapper inside the content, where they follow every render. *@
<MudBlazor.MudDialog Visible="@Visible"
                     VisibleChanged="VisibleChanged"
                     Options="@ConfirmDialogs.Options(Busy)">
    <TitleContent>
        <MudBlazor.MudText Typo="MudBlazor.Typo.h6">@Title</MudBlazor.MudText>
    </TitleContent>
    <DialogContent>
        <div aria-busy="@(Busy ? "true" : null)" @attributes="DialogHook">
            @ChildContent
        </div>
    </DialogContent>
    <DialogActions>
        <MudBlazor.MudButton Disabled="@Busy"
                             OnClick="OnCancel"
                             @attributes="CancelHook">Cancel</MudBlazor.MudButton>
        <MudBlazor.MudButton Variant="MudBlazor.Variant.Filled"
                             Color="MudBlazor.Color.Error"
                             Disabled="@(Busy || ConfirmDisabled)"
                             OnClick="OnConfirm"
                             @attributes="ConfirmHook">@ConfirmLabel</MudBlazor.MudButton>
    </DialogActions>
</MudBlazor.MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }

    /// <summary>Raised when Escape or the backdrop closes the dialog (only while idle).</summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>A question naming the thing ("Delete recording?").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The confirm button's text, repeating the verb.</summary>
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = "";

    /// <summary>
    /// The data hook prefix: <c>delete</c> gives <c>data-delete-dialog</c> (the content),
    /// <c>data-delete-cancel</c> and <c>data-delete-confirm</c>.
    /// </summary>
    [Parameter, EditorRequired] public string HookPrefix { get; set; } = "";

    /// <summary>A server call is in flight: both buttons are disabled and the content is <c>aria-busy</c>.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>The confirm is unavailable for a reason other than <see cref="Busy"/>.</summary>
    [Parameter] public bool ConfirmDisabled { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>The consequence, in <c>body1</c>, and any error banner.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Dictionary<string, object> DialogHook => Hook("dialog");

    private Dictionary<string, object> CancelHook => Hook("cancel");

    private Dictionary<string, object> ConfirmHook => Hook("confirm");

    private Dictionary<string, object> Hook(string part) =>
        new() { [$"data-{HookPrefix}-{part}"] = true };
}
