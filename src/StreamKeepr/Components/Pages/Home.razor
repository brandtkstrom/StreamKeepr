@page "/"
@page "/r/{RecordingId}"
@implements IDisposable
@inject ILibraryView Library

<PageTitle>@(RecordingId is null ? "Stream Keepr" : $"{RecordingId} · Stream Keepr")</PageTitle>

@if (RecordingId is null)
{
    <h1 class="sk-visually-hidden">Stream Keepr library</h1>
}
else if (!Library.IsLoaded)
{
    <h1 class="sk-visually-hidden">Recording</h1>
    <p class="body-medium" data-recording-loading>Loading recording…</p>
}
else if (Library.Find(RecordingId) is { } recording)
{
    <h1 class="sk-visually-hidden">@recording.Title</h1>
    <p class="body-medium" data-selected-recording="@RecordingId">@recording.Title</p>
}
else
{
    <section data-unknown-recording>
        <h1>Recording not found</h1>
        <p class="body-medium">
            That recording is not in the library.
            <a href="/">Back to library</a>
        </p>
    </section>
}

<div data-slot="player"></div>
<div data-slot="stats"></div>
<div data-slot="details"></div>

@code {
    [Parameter] public string? RecordingId { get; set; }

    protected override void OnInitialized() => Library.Changed += OnLibraryChanged;

    private void OnLibraryChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}
