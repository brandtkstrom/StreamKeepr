@page "/"
@page "/r/{RecordingId}"
@implements IDisposable
@using Microsoft.Extensions.Options
@using StreamKeepr.Configuration
@inject ILibraryView Library
@inject UiPreferences Preferences
@inject MudBlazor.ISnackbar Snackbars
@inject NavigationManager Navigation
@inject IOptions<ChatOptions> ChatOptions

<PageTitle>@(RecordingId is null ? "Stream Keepr" : $"{RecordingId} · Stream Keepr")</PageTitle>

@if (RecordingId is null)
{
    <h1 class="sk-visually-hidden">Stream Keepr library</h1>
    @* HomeRows renders nothing for a loaded, empty library; the empty state covers it. *@
    @if (Library.IsLoaded && Library.Streamers(new LibraryQuery()).Count == 0)
    {
        <LibraryEmptyState />
    }
    <HomeRows />
}
else if (!Library.IsLoaded)
{
    <h1 class="sk-visually-hidden">Recording</h1>
    <p class="body-medium" data-recording-loading>Loading recording…</p>
}
else if (Selected is { } recording)
{
    <h1 class="sk-visually-hidden">@recording.Title</h1>
}
else
{
    @* Design system: EmptyStates, recording not found. It leads with Search. *@
    <section class="sk-empty-state sk-empty-state-page" data-unknown-recording data-empty-icon="search">
        <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Search" Class="sk-empty-icon" aria-hidden="true" />
        <MudBlazor.MudText Typo="MudBlazor.Typo.h4" HtmlTag="h1">Recording not found</MudBlazor.MudText>
        <MudBlazor.MudText Typo="MudBlazor.Typo.body1">
            That recording is not in the library.
            <a href="/">Back to library</a>
        </MudBlazor.MudText>
    </section>
}

@* The watch view (player contract §2a, #175; design system: AppShell, TheaterMode, PhoneLayout).
   Md and up the first row is the player plus the chat sidecar, with details and stats below;
   theater moves the chat and details under the full-width player. Below Md the player is edge
   to edge above a summary and the Chat/Details/Stats tabs, so the title and actions stay put
   while a tab scrolls. The VideoPlayer stays the first child of the top row at every width, so
   a breakpoint change never reloads it. *@
@if (RecordingId is not null)
{
    <div class="sk-watch" data-watch>
        <div class="sk-watch-top" data-watch-top>
            <div class="sk-watch-player" data-slot="player" data-selected-recording="@Selected?.Id">
                @if (Selected is { } playing)
                {
                    <VideoPlayer Recording="playing"
                                 StatsOpen="@Preferences.StatsOpen"
                                 TheaterAvailable="@(!Compact)" />
                }
            </div>

            @if (!Compact && Selected is { } chatRecording && ShowChat)
            {
                <div class="sk-watch-chat" data-watch-chat>
                    <ChatPane Recording="chatRecording" Open="@Preferences.ChatOpen" />
                </div>
            }
        </div>

        @if (Compact)
        {
            @if (Selected is { } phone)
            {
                <div class="sk-watch-summary" data-watch-summary>
                    <RecordingDetailsSummary Recording="phone" Compact="true" AvatarUrl="@AvatarUrlFor(phone)" />
                </div>

                <MudBlazor.MudTabs Class="sk-watch-tabs"
                                   Color="MudBlazor.Color.Primary"
                                   MinimumTabWidth="0"
                                   KeepPanelsAlive="true">
                    @if (ShowChat)
                    {
                        <MudBlazor.MudTabPanel @key="@("chat")"
                                               Text="Chat"
                                               Icon="@MudBlazor.Icons.Material.Rounded.Chat">
                            <div class="sk-watch-tab-panel">
                                <ChatPane Recording="phone" Open="true" HideHeader="true" />
                            </div>
                        </MudBlazor.MudTabPanel>
                    }
                    <MudBlazor.MudTabPanel @key="@("details")"
                                           Text="Details"
                                           Icon="@MudBlazor.Icons.Material.Rounded.Info">
                        <div class="sk-watch-tab-panel">
                            <RecordingDetailsBody Recording="phone" />
                        </div>
                    </MudBlazor.MudTabPanel>
                    <MudBlazor.MudTabPanel @key="@("stats")"
                                           Text="Stats"
                                           Icon="@MudBlazor.Icons.Material.Rounded.QueryStats">
                        <div class="sk-watch-tab-panel">
                            <StatsPanel Recording="phone" Tab="true" />
                        </div>
                    </MudBlazor.MudTabPanel>
                </MudBlazor.MudTabs>
            }
        }
        else
        {
            <div data-slot="details">
                @if (Selected is { } detailed)
                {
                    <RecordingDetails Recording="detailed" AvatarUrl="@AvatarUrlFor(detailed)" />
                }
            </div>

            <div data-slot="stats">
                @if (Selected is { } statRecording)
                {
                    <StatsPanel Recording="statRecording" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? RecordingId { get; set; }

    // Md and up keep the desktop watch layout; below Md the shell reports compact (#175).
    [CascadingParameter(Name = AppShell.CompactCascade)]
    private bool Compact { get; set; }

    private string? _lastRecordingId;
    private bool _resolved;
    private bool _theaterResetPending;

    private RecordingView? Selected =>
        RecordingId is not null && Library.IsLoaded ? Library.Find(RecordingId) : null;

    // The channel's Twitch profile image for the title block, the same one the drawer shows.
    private string? AvatarUrlFor(RecordingView recording) =>
        Library.Streamers(new LibraryQuery())
            .FirstOrDefault(streamer => streamer.Login == recording.StreamerLogin)?.AvatarUrl;

    // Captured chat always replays; a live recording only waits for chat while capture is on.
    private bool ShowChat => Selected is { } recording &&
        (recording.HasChat ||
         (ChatOptions.Value.Enabled &&
          recording.State is RecordingState.Recording or RecordingState.Reconnecting));

    protected override void OnInitialized()
    {
        Library.Changed += OnLibraryChanged;
        Preferences.Changed += OnPreferencesChanged;
    }

    protected override void OnParametersSet()
    {
        // Theater hides the drawer and the empty home has no player, so leaving it
        // on would show a blank main column. The layout preference is not useful here.
        if (RecordingId is null && Preferences.Theater)
        {
            Preferences.SetTheater(false);
            _theaterResetPending = true;
        }

        if (!string.Equals(_lastRecordingId, RecordingId, StringComparison.Ordinal))
        {
            _lastRecordingId = RecordingId;
            _resolved = Selected is not null;
        }
        else if (Selected is not null)
        {
            _resolved = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_theaterResetPending)
            return;

        _theaterResetPending = false;
        await Preferences.PersistAsync();
    }

    private void OnLibraryChanged() => _ = InvokeAsync(ReactToLibraryChange);

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private void ReactToLibraryChange()
    {
        if (Selected is not null)
        {
            _resolved = true;
            StateHasChanged();
            return;
        }

        // An id that never resolved is the unknown-recording message, not a deletion.
        if (!_resolved || !Library.IsLoaded)
        {
            StateHasChanged();
            return;
        }

        _resolved = false;
        Snackbars.Show("Recording deleted");

        string? next = NextRecordingId();
        string target = next is null
            ? "/"
            : LibraryUrl.With(
                $"/r/{Uri.EscapeDataString(next)}",
                LibraryUrl.Parse(Navigation.Uri));
        Navigation.NavigateTo(target, replace: true);
    }

    private string? NextRecordingId()
    {
        LibraryQuery query = LibraryUrl.Parse(Navigation.Uri);
        foreach (StreamerView streamer in Library.Streamers(query))
        {
            if (Library.Recordings(streamer.Login, query).FirstOrDefault() is { } next)
                return next.Id;
        }

        return null;
    }

    public void Dispose()
    {
        Library.Changed -= OnLibraryChanged;
        Preferences.Changed -= OnPreferencesChanged;
    }
}
