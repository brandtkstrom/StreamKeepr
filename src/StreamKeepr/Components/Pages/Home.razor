@page "/"
@page "/r/{RecordingId}"
@implements IDisposable
@inject ILibraryView Library
@inject UiPreferences Preferences
@inject SnackbarService Snackbars
@inject NavigationManager Navigation

<PageTitle>@(RecordingId is null ? "Stream Keepr" : $"{RecordingId} · Stream Keepr")</PageTitle>

@if (RecordingId is null)
{
    <h1 class="sk-visually-hidden">Stream Keepr library</h1>
}
else if (!Library.IsLoaded)
{
    <h1 class="sk-visually-hidden">Recording</h1>
    <p class="body-medium" data-recording-loading>Loading recording…</p>
}
else if (Selected is { } recording)
{
    <h1 class="sk-visually-hidden">@recording.Title</h1>
}
else
{
    <section data-unknown-recording>
        <h1>Recording not found</h1>
        <p class="body-medium">
            That recording is not in the library.
            <a href="/">Back to library</a>
        </p>
    </section>
}

@* The player column keeps its fixed order. The same VideoPlayer instance survives recording
   changes and swaps the source in JS. *@
<div data-slot="player" data-selected-recording="@Selected?.Id">
    @if (Selected is { } playing)
    {
        <VideoPlayer Recording="playing" StatsOpen="@Preferences.StatsOpen" />
    }
</div>

<div data-slot="details">
    @if (Selected is { } detailed)
    {
        <RecordingDetails Recording="detailed" />
    }
</div>

<div data-slot="stats">
    @if (Selected is { } statRecording)
    {
        <StatsPanel Recording="statRecording"/>
    }
</div>

@code {
    [Parameter] public string? RecordingId { get; set; }

    private string? _lastRecordingId;
    private bool _resolved;
    private bool _theaterResetPending;

    private RecordingView? Selected =>
        RecordingId is not null && Library.IsLoaded ? Library.Find(RecordingId) : null;

    protected override void OnInitialized() => Library.Changed += OnLibraryChanged;

    protected override void OnParametersSet()
    {
        // Theater hides the drawer and the empty home has no player, so leaving it
        // on would show a blank main column. The layout preference is not useful here.
        if (RecordingId is null && Preferences.Theater)
        {
            Preferences.SetTheater(false);
            _theaterResetPending = true;
        }

        if (!string.Equals(_lastRecordingId, RecordingId, StringComparison.Ordinal))
        {
            _lastRecordingId = RecordingId;
            _resolved = Selected is not null;
        }
        else if (Selected is not null)
        {
            _resolved = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_theaterResetPending)
            return;

        _theaterResetPending = false;
        await Preferences.PersistAsync();
    }

    private void OnLibraryChanged() => _ = InvokeAsync(ReactToLibraryChange);

    private void ReactToLibraryChange()
    {
        if (Selected is not null)
        {
            _resolved = true;
            StateHasChanged();
            return;
        }

        // An id that never resolved is the unknown-recording message, not a deletion.
        if (!_resolved || !Library.IsLoaded)
        {
            StateHasChanged();
            return;
        }

        _resolved = false;
        Snackbars.Show("Recording deleted");

        string? next = NextRecordingId();
        string target = next is null
            ? "/"
            : LibraryUrl.With(
                $"/r/{Uri.EscapeDataString(next)}",
                LibraryUrl.Parse(Navigation.Uri));
        Navigation.NavigateTo(target, replace: true);
    }

    private string? NextRecordingId()
    {
        LibraryQuery query = LibraryUrl.Parse(Navigation.Uri);
        foreach (StreamerView streamer in Library.Streamers(query))
        {
            if (Library.Recordings(streamer.Login, query).FirstOrDefault() is { } next)
                return next.Id;
        }

        return null;
    }

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}