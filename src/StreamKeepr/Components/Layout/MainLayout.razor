@inherits LayoutComponentBase
@implements IDisposable
@inject ILibraryView Library
@inject NavigationManager Navigation

<AppShell RecordingActive="@_recordingActive"
          WatchTitle="@_watchTitle"
          FreeBytes="@_storage.FreeBytes"
          TotalBytes="@_storage.TotalBytes">
    <Drawer>
        <LibraryDrawer />
    </Drawer>
    <SearchSlot>
        <SearchField />
    </SearchSlot>
    <AuthSlot>
        <TwitchAccount />
    </AuthSlot>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>
<AuthErrorNotifier />

<div id="blazor-error-ui" role="alert" aria-label="Application error" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _recordingActive;
    private StorageView _storage = new(0, 0);
    private string? _watchTitle;

    protected override void OnInitialized()
    {
        Library.Changed += OnLibraryChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Refresh();
    }

    private void Refresh()
    {
        _storage = Library.Storage;
        _watchTitle = LibraryUrl.RecordingId(Navigation.Uri) is { } id ? Library.Find(id)?.Title : null;
        _recordingActive = Library.Streamers(new LibraryQuery())
            .Any(streamer => streamer.IsRecording);
    }

    private void OnLibraryChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => OnLibraryChanged();

    public void Dispose()
    {
        Library.Changed -= OnLibraryChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
