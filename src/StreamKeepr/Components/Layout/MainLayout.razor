@using StreamKeepr.Components.Features.Settings
@inherits LayoutComponentBase
@implements IDisposable
@inject ILibraryView Library
@inject NavigationManager Navigation

<AppShell RecordingActive="@_recordingActive"
          WatchTitle="@_nowPlaying?.Title"
          NowPlaying="@_nowPlaying">
    <Drawer>
        <LibraryDrawer />
    </Drawer>
    <SearchSlot>
        <SearchField />
    </SearchSlot>
    <AuthSlot>
        <TwitchAccount />
    </AuthSlot>
    <SettingsContent>
        <SettingsSections />
    </SettingsContent>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>
<AuthErrorNotifier />

<div id="blazor-error-ui" role="alert" aria-label="Application error" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _recordingActive;
    private RecordingView? _nowPlaying;

    protected override void OnInitialized()
    {
        Library.Changed += OnLibraryChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Refresh();
    }

    private void Refresh()
    {
        _nowPlaying = LibraryUrl.RecordingId(Navigation.Uri) is { } id ? Library.Find(id) : null;
        _recordingActive = Library.Streamers(new LibraryQuery())
            .Any(streamer => streamer.IsRecording);
    }

    private void OnLibraryChanged() => RefreshAndRender();

    private void RefreshAndRender() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    // The watch title follows the route as well as the library.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => RefreshAndRender();

    public void Dispose()
    {
        Library.Changed -= OnLibraryChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
