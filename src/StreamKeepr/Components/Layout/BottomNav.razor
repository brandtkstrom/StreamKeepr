@* The bottom app bar below Breakpoint.Md (design system: BottomNav). Home and Settings are real
   links, so they work before the circuit connects; Library opens the temporary drawer. *@
<MudBlazor.MudAppBar Bottom="true" Fixed="true" Elevation="0" Class="sk-bottombar" data-bottom-nav>
    <nav class="sk-bottomnav" aria-label="Main">
        <a class="sk-bottomnav-item" href="/" aria-current="@(Current == BottomNavItem.Home ? "page" : null)">
            <span class="pill" aria-hidden="true"><MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Home" /></span>
            <span class="lbl">Home</span>
        </a>
        <button type="button"
                class="sk-bottomnav-item"
                aria-controls="@DrawerId"
                aria-expanded="@(LibraryOpen ? "true" : "false")"
                aria-current="@(Current == BottomNavItem.Library ? "page" : null)"
                @onclick="OnLibrary">
            <span class="pill" aria-hidden="true">
                <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.VideoLibrary" />
                @if (RecordingActive)
                {
                    <span class="rec-dot" data-library-rec></span>
                }
            </span>
            <span class="lbl">Library</span>
        </button>
        <a class="sk-bottomnav-item" href="/settings" aria-current="@(Current == BottomNavItem.Settings ? "page" : null)">
            <span class="pill" aria-hidden="true"><MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Settings" /></span>
            <span class="lbl">Settings</span>
        </a>
    </nav>
</MudBlazor.MudAppBar>

@code {
    /// <summary>The destination marked <c>aria-current="page"</c>.</summary>
    [Parameter] public BottomNavItem? Current { get; set; }

    /// <summary>Whether the temporary library drawer is open.</summary>
    [Parameter] public bool LibraryOpen { get; set; }

    /// <summary>Shows the <c>rec</c> dot on Library while anything is recording.</summary>
    [Parameter] public bool RecordingActive { get; set; }

    /// <summary>The id of the drawer that Library controls.</summary>
    [Parameter, EditorRequired] public string DrawerId { get; set; } = "";

    [Parameter] public EventCallback OnLibrary { get; set; }
}
