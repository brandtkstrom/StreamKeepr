@using Microsoft.Extensions.Options
@using StreamKeepr.Configuration
@implements IAsyncDisposable
@inject UiPreferences Preferences
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IOptions<LinksOptions> Links
@inject ILogger<AppShell> Logger

@* MudBlazor's Layout 2 wireframe (design system: AppShell, TopAppBar, BottomNav, PhoneLayout):
   an app bar with the library drawer clipped beneath it. Md and up, the drawer is the mini rail
   or the full library; below Md it is a temporary drawer opened from the bottom bar. The wide
   layout is the server-rendered default; components.css hides the wide-only controls below
   960px, so a phone's first paint already fits before the breakpoint is known. *@
<MudBlazor.MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <div class="sk-shell"
         data-shell
         data-layout="@(_compact ? "compact" : "wide")"
         data-breakpoint-known="@(_breakpointKnown ? "" : null)"
         data-watching="@(Watching ? "" : null)"
         data-theater-mode="@(Preferences.Theater ? "" : null)"
         data-drawer-frame="@(DrawerFrameHidden ? "hidden" : null)"
         data-drawer-modal-open="@(_modalOpen ? "" : null)">
        <MudBlazor.MudLayout>
            <MudBlazor.MudAppBar Elevation="0" Fixed="true" Dense="_compact" Gutters="false" Class="sk-appbar">
                <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Menu"
                                         Class="sk-appbar-menu"
                                         data-drawer-toggle
                                         aria-label="@MenuLabel"
                                         aria-controls="@DrawerId"
                                         aria-expanded="@(MenuExpanded ? "true" : "false")"
                                         Disabled="@Preferences.Theater"
                                         OnClick="OnMenuClickedAsync" />

                @if (_compact && Watching)
                {
                    <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.ArrowBack"
                                             Href="/"
                                             aria-label="Back to Home" />
                    <span class="sk-watch-title" data-watch-title>@(WatchTitle ?? "Recording")</span>
                }
                else
                {
                    <a class="sk-wordmark" href="/" aria-label="StreamKeepr home">
                        <span class="sk-logo">
                            <img src="img/streamkeepr-mark.svg" alt="" width="28" height="28" />
                            @if (RecordingActive)
                            {
                                <span class="rec-dot" data-rec-dot aria-hidden="true"></span>
                            }
                        </span>
                        <span>Stream<b>Keepr</b></span>
                    </a>
                }

                <div class="sk-search" id="sk-search" data-search-open="@(_searchOpen ? "" : null)">
                    <label class="sk-search-field">
                        <MudBlazor.MudIcon Icon="@MudBlazor.Icons.Material.Rounded.Search" Size="MudBlazor.Size.Small" />
                        @if (SearchSlot is null)
                        {
                            <input type="search"
                                   placeholder="Search recordings, streamers, categories"
                                   aria-label="Search recordings" />
                        }
                        else
                        {
                            @SearchSlot
                        }
                    </label>
                </div>

                <div class="sk-appbar-actions">
                    <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Search"
                                             Class="sk-appbar-search"
                                             aria-label="Search"
                                             aria-controls="sk-search"
                                             aria-expanded="@(_searchOpen ? "true" : "false")"
                                             OnClick="ToggleSearch" />

                    <MudBlazor.MudTooltip Text="StreamKeepr on GitHub" RootClass="sk-appbar-link">
                        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Custom.Brands.GitHub"
                                                 Href="@Links.Value.GitHub"
                                                 Target="_blank"
                                                 Rel="noopener"
                                                 aria-label="StreamKeepr on GitHub (opens in a new tab)" />
                    </MudBlazor.MudTooltip>

                    @* MudBlazor has no Twitch icon. LiveTv stands in until Twitch's official Glitch
                       mark is added from its brand assets; the mark is never redrawn. *@
                    <MudBlazor.MudTooltip Text="Twitch" RootClass="sk-appbar-link">
                        <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.LiveTv"
                                                 Href="@Links.Value.Twitch"
                                                 Target="_blank"
                                                 Rel="noopener"
                                                 aria-label="Twitch (opens in a new tab)" />
                    </MudBlazor.MudTooltip>

                    <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Settings"
                                             Class="sk-appbar-settings"
                                             Href="/settings"
                                             aria-label="Settings" />

                    @if (AuthSlot is null)
                    {
                        <span class="sk-twitch sk-auth-placeholder" data-auth-placeholder aria-disabled="true">
                            <span class="sk-icon" aria-hidden="true">link</span>
                            <span class="lbl">Connect with Twitch</span>
                        </span>
                    }
                    else
                    {
                        @AuthSlot
                    }
                </div>
            </MudBlazor.MudAppBar>

            @* Breakpoint.Always: the shell picks the variant itself. A Mini drawer with
               Breakpoint.None closes itself on load and ignores Open="true". *@
            <MudBlazor.MudDrawer Open="@DrawerOpen"
                                 OpenChanged="OnDrawerOpenChanged"
                                 Variant="@(_compact ? MudBlazor.DrawerVariant.Temporary : MudBlazor.DrawerVariant.Mini)"
                                 Breakpoint="MudBlazor.Breakpoint.Always"
                                 ClipMode="MudBlazor.DrawerClipMode.Always"
                                 Elevation="@(_compact ? 4 : 0)"
                                 Class="sk-drawer-frame">
                <nav id="@DrawerId"
                     class="sk-drawer @DrawerClass"
                     data-drawer="@DrawerMode.ToString().ToLowerInvariant()"
                     aria-label="Library">
                    @if (Drawer is null)
                    {
                        <div class="sk-drawer-head">
                            <h2>Library</h2>
                        </div>
                        <div class="sk-drawer-list"></div>
                    }
                    else
                    {
                        @* The drawer's contents differ in the rail (avatars, the storage icon, a
                           rightward sort menu), so they learn the mode from the shell. *@
                        <CascadingValue Name="LibraryRail" Value="@(!_compact && DrawerMode == DrawerMode.Rail)">
                            @Drawer
                        </CascadingValue>
                    }
                </nav>
            </MudBlazor.MudDrawer>

            <MudBlazor.MudMainContent Class="sk-main-frame">
                <ReconnectNotice Visible="@_updatesPaused"
                                 ModalVisible="@_reconnectModalVisible" />
                <main class="sk-main">
                    <div class="sk-main-inner">
                        @* Pages reach the shell for actions that need its drawer, such as Home's "Show all". *@
                        <CascadingValue Value="this" IsFixed="true">
                            @ChildContent
                        </CascadingValue>
                    </div>
                </main>
            </MudBlazor.MudMainContent>

            @* Not MudHidden: it renders nothing until its breakpoint is known, which would leave a
               phone without these links before the circuit connects. The bar renders until the
               provider reports a wide breakpoint, and components.css hides it at 960px and up. *@
            @if (!Watching && !_wideKnown)
            {
                <BottomNav Current="@BottomNavCurrent"
                           LibraryOpen="@_modalOpen"
                           RecordingActive="@RecordingActive"
                           DrawerId="@DrawerId"
                           OnLibrary="ToggleModalDrawer" />
            }
        </MudBlazor.MudLayout>

        <ViewerClockSync />
    </div>
</MudBlazor.MudBreakpointProvider>

@code {
    /// <summary>The library drawer's id, named by the menu and Library buttons' <c>aria-controls</c>.</summary>
    public const string DrawerId = "sk-drawer";

    private IJSObjectReference? _module;
    private DotNetObjectReference<AppShell>? _self;
    private bool _compact;
    private bool _wideKnown;
    private bool _breakpointKnown;
    private bool _modalOpen;
    private bool _modalRendered;
    private string? _openModalOnArrivalAt;
    private bool _searchOpen;
    private bool _updatesPaused;
    private bool _reconnectModalVisible;
    private bool _disposed;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Drawer { get; set; }

    [Parameter] public RenderFragment? SearchSlot { get; set; }

    [Parameter] public RenderFragment? AuthSlot { get; set; }

    [Parameter] public bool RecordingActive { get; set; }

    /// <summary>The open recording's title, shown in the dense top bar of a phone's watch page.</summary>
    [Parameter] public string? WatchTitle { get; set; }

    private bool Watching => LibraryUrl.RecordingId(Navigation.Uri) is not null;

    private DrawerMode DrawerMode => Preferences.DrawerFor(Watching);

    // Theater mode and the saved "hidden" mode both take the drawer out of the wide layout.
    private bool DrawerFrameHidden =>
        !_compact && (Preferences.Theater || DrawerMode == DrawerMode.Hidden);

    private bool DrawerOpen => _compact ? _modalOpen : DrawerMode == DrawerMode.Expanded;

    private bool MenuExpanded => !Preferences.Theater && DrawerMode == DrawerMode.Expanded;

    private string MenuLabel => Preferences.Theater
        ? "Menu: library hidden in theater mode"
        : DrawerMode switch
        {
            DrawerMode.Expanded => "Menu: collapse library",
            DrawerMode.Rail => "Menu: expand library",
            _ => "Menu: open library",
        };

    // A temporary drawer is always the full library, whatever the saved desktop mode.
    private string DrawerClass => _compact
        ? ""
        : DrawerMode switch
        {
            DrawerMode.Rail => "rail",
            DrawerMode.Hidden => "hidden",
            _ => "",
        };

    private BottomNavItem? BottomNavCurrent
    {
        get
        {
            if (_modalOpen)
                return BottomNavItem.Library;

            string path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
            return path switch
            {
                "/" => BottomNavItem.Home,
                "/settings" => BottomNavItem.Settings,
                _ => null,
            };
        }
    }

    protected override void OnInitialized()
    {
        _searchOpen = LibraryUrl.Parse(Navigation.Uri).Search is not null;
        Preferences.Changed += OnPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Layout/AppShell.razor.js");
                await _module.InvokeVoidAsync("init", _self);
            }
            catch (JSException ex)
            {
                // The shell still works without the module: the temporary drawer opens and
                // closes, but without the focus trap, and the app bar never shows it scrolled.
                Logger.LogDebug(ex, "The app shell JavaScript module could not be initialized.");
            }
        }

        if (_modalRendered != _modalOpen)
        {
            _modalRendered = _modalOpen;
            await InvokeModuleAsync("setModalDrawer", _modalOpen);
        }
    }

    private void OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        bool compact = breakpoint is MudBlazor.Breakpoint.Xs or MudBlazor.Breakpoint.Sm;
        _wideKnown = !compact && breakpoint is not MudBlazor.Breakpoint.None;
        _breakpointKnown = breakpoint is not MudBlazor.Breakpoint.None;
        if (compact == _compact)
            return;

        _compact = compact;
        if (!compact)
        {
            _modalOpen = false;
            _searchOpen = false;
        }
    }

    private async Task OnMenuClickedAsync()
    {
        if (Preferences.Theater)
            return;

        if (_compact)
        {
            ToggleModalDrawer();
            return;
        }

        Preferences.ToggleDrawer(Watching);
        await Preferences.PersistAsync();
    }

    private void ToggleModalDrawer()
    {
        if (_compact)
            _modalOpen = !_modalOpen;
    }

    // MudDrawer reports the overlay click (and nothing else) through OpenChanged.
    private void OnDrawerOpenChanged(bool open)
    {
        if (_compact)
            _modalOpen = open;
    }

    private void ToggleSearch() => _searchOpen = !_searchOpen;

    /// <summary>
    /// Navigates to a library view (such as <c>/?state=saved</c>) and shows the library: the
    /// full drawer Md and up, saved like the menu's choice, or the temporary drawer below Md.
    /// </summary>
    public async Task ShowLibraryAsync(string url)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(url);

        if (_compact)
        {
            // Navigating closes the temporary drawer, so open it once this navigation lands, and
            // only there: any other location change clears the request. An unchanged URL raises
            // no location change, so open it now instead.
            Uri target = Navigation.ToAbsoluteUri(url);
            if (target == new Uri(Navigation.Uri))
            {
                _modalOpen = true;
                StateHasChanged();
                return;
            }

            _openModalOnArrivalAt = target.AbsoluteUri;
            Navigation.NavigateTo(url);
            return;
        }

        bool watching = LibraryUrl.RecordingId(Navigation.ToAbsoluteUri(url).ToString()) is not null;
        if (Preferences.DrawerFor(watching) != DrawerMode.Expanded)
        {
            Preferences.SetDrawer(DrawerMode.Expanded, watching);
            await Preferences.PersistAsync();
        }

        Navigation.NavigateTo(url);
    }

    /// <summary>Closes the temporary drawer; the module calls it on Escape.</summary>
    [JSInvokable]
    public Task CloseModalDrawer()
    {
        if (!_modalOpen)
            return Task.CompletedTask;

        _modalOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SetUpdatesPaused(bool paused)
    {
        if (_updatesPaused == paused)
            return Task.CompletedTask;

        _updatesPaused = paused;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SetReconnectModalVisible(bool visible)
    {
        if (_reconnectModalVisible == visible)
            return Task.CompletedTask;

        _reconnectModalVisible = visible;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InvokeModuleAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "App shell call {Identifier} failed.", identifier);
        }
    }

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    // Picking a recording closes the temporary drawer, and the page kind decides the drawer.
    // ShowLibraryAsync's own navigation opens it instead.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        _modalOpen = _compact && string.Equals(
            new Uri(e.Location).AbsoluteUri, _openModalOnArrivalAt, StringComparison.Ordinal);
        _openModalOnArrivalAt = null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Preferences.Changed -= OnPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            await InvokeModuleAsync("dispose");
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no browser state left to release.
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "The app shell JavaScript module was already disconnected.");
            }
        }

        _self?.Dispose();
    }
}
