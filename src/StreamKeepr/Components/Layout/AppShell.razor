@using StreamKeepr.Components.Features.Settings
@implements IAsyncDisposable
@inject UiPreferences Preferences
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<AppShell> Logger

@* MudBlazor's Layout 2 wireframe (design system: AppShell, TopAppBar, BottomNav, PhoneLayout):
   an app bar with the library drawer clipped beneath it. Md and up, the drawer is the 72px rail,
   and the menu (or a rail avatar) opens the full library over the page, so the page never
   reflows; below Md it is a temporary drawer opened from the bottom bar. Either way the open
   library is temporary: it closes on Escape, a click outside, or going to another page. The wide
   layout is the server-rendered default; components.css hides the wide-only controls below
   960px, so a phone's first paint already fits before the breakpoint is known. *@
<MudBlazor.MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <div class="sk-shell"
         data-shell
         data-layout="@(_compact ? "compact" : "wide")"
         data-breakpoint-known="@(_breakpointKnown ? "" : null)"
         data-watching="@(Watching ? "" : null)"
         data-theater-mode="@(Preferences.Theater ? "" : null)"
         data-drawer-frame="@(DrawerFrameHidden ? "hidden" : null)"
         data-shell-ready="@(_shellReady ? "" : null)"
         data-drawer-modal-open="@(_compact && _modalOpen ? "" : null)"
         data-library-open="@(_modalOpen ? "" : null)">
        <MudBlazor.MudLayout>
            <MudBlazor.MudAppBar Elevation="0" Fixed="true" Dense="_compact" Gutters="false" Class="sk-appbar">
                @* A labeled toggle, not a hamburger: its purpose and state are legible before the
                   circuit connects. Below Md the bottom bar opens the library instead. *@
                <MudBlazor.MudTooltip Text="@(MenuExpanded ? "Close library" : "Open library")">
                    <MudBlazor.MudButton Variant="MudBlazor.Variant.Text"
                                         StartIcon="@MudBlazor.Icons.Material.Rounded.VideoLibrary"
                                         Class="@(MenuExpanded ? "sk-appbar-library sk-pressed" : "sk-appbar-library")"
                                         data-drawer-toggle
                                         aria-controls="@DrawerId"
                                         aria-expanded="@(MenuExpanded ? "true" : "false")"
                                         Disabled="@Preferences.Theater"
                                         OnClick="OnMenuClickedAsync">Library</MudBlazor.MudButton>
                </MudBlazor.MudTooltip>

                @if (_compact && Watching)
                {
                    <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.ArrowBack"
                                             Href="/"
                                             aria-label="Back to Home" />
                    <span class="sk-watch-title" data-watch-title>@(WatchTitle ?? "Recording")</span>
                }
                else
                {
                    <a class="sk-wordmark" href="/" aria-label="StreamKeepr home">
                        <span class="sk-logo">
                            <img src="img/streamkeepr-mark.svg" alt="" width="28" height="28" />
                        </span>
                        <span>Stream<b>Keepr</b></span>
                    </a>
                }

                <div class="sk-appbar-actions">
                    @* The tally is the one loud element: the only app-bar item that says the deck is
                       writing. Wide only; below Md the bottom bar's Library dot carries the state. *@
                    @if (RecordingCount > 0)
                    {
                        @if (Preferences.Theater)
                        {
                            <span class="sk-tally sk-tally-status" data-recording-tally role="status">
                                <span class="sk-tally-dot" data-rec-dot aria-hidden="true"></span>
                                <span class="sk-tally-label">@TallyLabel</span>
                            </span>
                        }
                        else
                        {
                            <MudBlazor.MudTooltip Text="Open the library filtered to recording">
                                <button type="button"
                                        class="sk-tally"
                                        data-recording-tally
                                        aria-label="@TallyAria"
                                        aria-controls="@DrawerId"
                                        @onclick="OpenRecordingLibraryAsync">
                                    <span class="sk-tally-dot" data-rec-dot aria-hidden="true"></span>
                                    <span class="sk-tally-label">@TallyLabel</span>
                                </button>
                            </MudBlazor.MudTooltip>
                        }
                    }

                    @if (!Preferences.Theater)
                    {
                        <MudBlazor.MudTooltip Text="Search library (/)">
                            <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Search"
                                                     data-library-search
                                                     aria-label="Search library"
                                                     aria-keyshortcuts="/"
                                                     aria-controls="@DrawerId"
                                                     OnClick="OpenSearchAsync" />
                        </MudBlazor.MudTooltip>
                    }

                    @* A real link to the page, so it works before the circuit connects. With the
                       circuit, AppShell.razor.js turns the click into the sheet's toggle. *@
                    <MudBlazor.MudIconButton Icon="@MudBlazor.Icons.Material.Rounded.Settings"
                                             Class="@(SettingsOpen ? "sk-appbar-settings sk-pressed" : "sk-appbar-settings")"
                                             Href="@SettingsSheetUrl.PagePath"
                                             aria-label="Settings"
                                             aria-controls="@(SettingsOpen ? SettingsSheet.Id : null)"
                                             aria-expanded="@Aria.Bool(SettingsExpanded)"
                                             data-settings-toggle />

                    @if (AuthSlot is null)
                    {
                        <span class="sk-twitch sk-auth-placeholder" data-auth-placeholder aria-disabled="true">
                            <TwitchConnectLabel />
                        </span>
                    }
                    else
                    {
                        @AuthSlot
                    }
                </div>
            </MudBlazor.MudAppBar>

            @* Breakpoint.Xs: the shell picks the variant itself. Always and None are sentinels
               that force the drawer open or closed on the first viewport report; Xs is the lowest
               real breakpoint, so a Mini drawer keeps Open and never becomes temporary. *@
            <MudBlazor.MudDrawer Open="@DrawerOpen"
                                 OpenChanged="OnDrawerOpenChanged"
                                 Variant="@(_compact ? MudBlazor.DrawerVariant.Temporary : MudBlazor.DrawerVariant.Mini)"
                                 Breakpoint="MudBlazor.Breakpoint.Xs"
                                 ClipMode="MudBlazor.DrawerClipMode.Always"
                                 Elevation="@(_compact ? 4 : 0)"
                                 Class="sk-drawer-frame">
                <nav id="@DrawerId"
                     class="sk-drawer @DrawerClass"
                     data-drawer="@(DrawerOpen ? "expanded" : "rail")"
                     aria-label="Library">
                    @if (Drawer is null)
                    {
                        <div class="sk-drawer-head">
                            <h2>Library</h2>
                        </div>
                        <div class="sk-drawer-list"></div>
                    }
                    else
                    {
                        @* The drawer's contents differ in the rail (avatars, the storage icon, a
                           rightward sort menu), so they learn the mode from the shell. *@
                        <CascadingValue Name="LibraryRail" Value="@(!_compact && !_modalOpen)">
                        <CascadingValue Name="@LibraryOpenCascade" Value="_modalOpen">
                        <CascadingValue Name="@CompactCascade" Value="_compact">
                        @* The drawer asks the shell to open the library (a rail avatar, the storage icon). *@
                        <CascadingValue Value="this" IsFixed="true">
                            @Drawer
                        </CascadingValue>
                        </CascadingValue>
                        </CascadingValue>
                        </CascadingValue>
                    }
                </nav>
            </MudBlazor.MudDrawer>

            <MudBlazor.MudMainContent Class="sk-main-frame">
                <ReconnectNotice Visible="@_updatesPaused"
                                 ModalVisible="@_reconnectModalVisible" />
                <main class="sk-main">
                    <div class="sk-main-inner">
                        @* Pages reach the shell for actions that need its drawer, such as Home's "Show all". *@
                        <CascadingValue Name="@CompactCascade" Value="_compact">
                            <CascadingValue Value="this" IsFixed="true">
                                @* Settings' exit asks whether there is a StreamKeepr page to go back to. *@
                                <CascadingValue Value="_history" IsFixed="true">
                                    @ChildContent
                                </CascadingValue>
                            </CascadingValue>
                        </CascadingValue>
                    </div>
                </main>
            </MudBlazor.MudMainContent>

            <SettingsSheet Open="@SettingsOpen"
                           Compact="@_compact"
                           NowPlaying="@NowPlaying"
                           OnClose="CloseSettingsAsync">
                @SettingsContent
            </SettingsSheet>

            @* Not MudHidden: it renders nothing until its breakpoint is known, which would leave a
               phone without these links before the circuit connects. The bar renders until the
               provider reports a wide breakpoint, and components.css hides it at 960px and up. *@
            @if (!Watching && !_wideKnown)
            {
                <BottomNav Current="@BottomNavCurrent"
                           LibraryOpen="@_modalOpen"
                           SettingsExpanded="@SettingsExpanded"
                           RecordingActive="@RecordingActive"
                           DrawerId="@DrawerId"
                           OnLibrary="ToggleModalDrawer" />
            }
        </MudBlazor.MudLayout>

        <ViewerClockSync />
    </div>
</MudBlazor.MudBreakpointProvider>

@code {
    /// <summary>The library drawer's id, named by the menu and Library buttons' <c>aria-controls</c>.</summary>
    public const string DrawerId = "sk-drawer";

    /// <summary>The cascade carrying <c>_compact</c> to pages such as the watch layout.</summary>
    public const string CompactCascade = "ShellCompact";

    /// <summary>The library is open: the overlay Md and up, the temporary drawer below Md.</summary>
    public const string LibraryOpenCascade = "LibraryOpen";

    private IJSObjectReference? _module;
    private DotNetObjectReference<AppShell>? _self;
    private bool _compact;
    private bool _wideKnown;
    private bool _breakpointKnown;
    private bool _shellReady;
    private bool _modalOpen;
    private bool _modalRendered;
    private string? _openModalOnArrivalAt;
    private bool _focusSearch;
    private NavigationHistory _history = null!;
    private bool _updatesPaused;
    private bool _reconnectModalVisible;
    private bool _disposed;
    private string? _pushedSettingsUri;
    private bool _closingSettings;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Drawer { get; set; }

    [Parameter] public RenderFragment? AuthSlot { get; set; }

    [Parameter] public bool RecordingActive { get; set; }

    /// <summary>Channels recording now, shown in the app bar's tally on wide screens.</summary>
    [Parameter] public int RecordingCount { get; set; }

    /// <summary>The open recording's title, shown in the dense top bar of a phone's watch page.</summary>
    [Parameter] public string? WatchTitle { get; set; }

    /// <summary>The settings sheet's sections (design system: SettingsSheet).</summary>
    [Parameter] public RenderFragment? SettingsContent { get; set; }

    /// <summary>The recording on this page, for the phone sheet's now-playing strip.</summary>
    [Parameter] public RecordingView? NowPlaying { get; set; }

    private bool SettingsOpen => SettingsSheetUrl.IsOpen(Navigation.Uri);

    private bool OnSettingsPage => SettingsSheetUrl.IsSettingsPage(Navigation.Uri);

    // The Settings controls toggle the sheet everywhere but the page itself, where they are links.
    private bool? SettingsExpanded => OnSettingsPage ? null : SettingsOpen;

    private bool Watching => LibraryUrl.RecordingId(Navigation.Uri) is not null;

    // Theater mode takes the drawer, rail included, out of the wide layout.
    // The page the library was last shown on, to tell a new page from a query change.
    private string _location = "";

    private bool DrawerFrameHidden => !_compact && Preferences.Theater;

    // The library is open (_modalOpen) or not, at every width; Md and up, closed is the rail.
    private bool DrawerOpen => _modalOpen;

    private bool MenuExpanded => !Preferences.Theater && _modalOpen;

    private string TallyLabel => RecordingCount == 1 ? "1 channel recording" : $"{RecordingCount} channels recording";

    private string TallyAria => $"{TallyLabel}. Open the library filtered to recording.";

    private string DrawerClass => !_compact && !_modalOpen ? "rail" : "";

    private BottomNavItem? BottomNavCurrent
    {
        get
        {
            if (_modalOpen)
                return BottomNavItem.Library;
            if (SettingsOpen)
                return BottomNavItem.Settings;

            string path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
            return path switch
            {
                "/" => BottomNavItem.Home,
                SettingsSheetUrl.PagePath => BottomNavItem.Settings,
                _ => null,
            };
        }
    }

    protected override void OnInitialized()
    {
        _history = new NavigationHistory(Navigation.Uri);
        _location = Navigation.Uri;
        Preferences.Changed += OnPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Layout/AppShell.razor.js");
                await _module.InvokeVoidAsync("init", _self);
            }
            catch (JSException ex)
            {
                // The shell still works without the module: the temporary drawer opens and
                // closes, but without the focus trap, and the app bar never shows it scrolled.
                Logger.LogDebug(ex, "The app shell JavaScript module could not be initialized.");
            }

            // The app is interactive whether or not the module loaded. E2E waits on this rather
            // than on the search field, which now lives in the (sometimes unmounted) drawer.
            _shellReady = true;
            StateHasChanged();
        }

        if (_modalRendered != _modalOpen)
        {
            _modalRendered = _modalOpen;
            // Below Md the drawer is modal and traps focus; Md and up it is not.
            await InvokeModuleAsync("setModalDrawer", _modalOpen, _compact);
        }

        if (_focusSearch)
        {
            _focusSearch = false;
            // After setModalDrawer: opening moves focus, and the search shortcut must win.
            await InvokeModuleAsync("focusSearch");
        }
    }

    private void OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        bool compact = breakpoint is MudBlazor.Breakpoint.Xs or MudBlazor.Breakpoint.Sm;
        _wideKnown = !compact && breakpoint is not MudBlazor.Breakpoint.None;
        _breakpointKnown = breakpoint is not MudBlazor.Breakpoint.None;
        if (compact == _compact)
            return;

        _compact = compact;
        _modalOpen = false;
    }

    private async Task OnMenuClickedAsync()
    {
        if (Preferences.Theater)
            return;

        ToggleModalDrawer();
        await Task.CompletedTask;
    }

    private void ToggleModalDrawer() => _modalOpen = !_modalOpen;

    /// <summary>Opens the library: over the page Md and up, the temporary drawer below Md.</summary>
    public void OpenLibrary()
    {
        if (_modalOpen || (!_compact && Preferences.Theater))
            return;

        _modalOpen = true;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the library with its search field focused. The app-bar search button and the
    /// <c>/</c> shortcut use this; the field lives in the drawer, where the results are.
    /// </summary>
    public void OpenSearch()
    {
        if (Preferences.Theater)
            return;

        _modalOpen = true;
        _focusSearch = true;
        StateHasChanged();
    }

    private Task OpenSearchAsync()
    {
        OpenSearch();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Opens the library filtered to channels that are recording, without leaving the page
    /// the tally was pressed on.
    /// </summary>
    public Task OpenRecordingLibraryAsync()
    {
        if (Preferences.Theater)
            return Task.CompletedTask;

        // The tally is a global "what is recording": drop any search that would hide channels.
        LibraryQuery query = LibraryUrl.Parse(Navigation.Uri) with { State = "recording", Search = null };
        return ShowLibraryAsync(LibraryUrl.With(Navigation.Uri, query));
    }

    // MudDrawer reports the overlay click (and nothing else) through OpenChanged.
    private void OnDrawerOpenChanged(bool open) => _modalOpen = open;

    /// <summary>
    /// Navigates to a library view (such as <c>/?state=saved</c>) and opens the library: over
    /// the page Md and up, the temporary drawer below Md.
    /// </summary>
    public Task ShowLibraryAsync(string url)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(url);

        // Navigating may close the library, so open it once this navigation lands, and only
        // there: any other location change clears the request. An unchanged URL raises no
        // location change, so open it now instead.
        Uri target = Navigation.ToAbsoluteUri(url);
        if (target == new Uri(Navigation.Uri))
        {
            OpenLibrary();
            return Task.CompletedTask;
        }

        _openModalOnArrivalAt = target.AbsoluteUri;
        Navigation.NavigateTo(url);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Opens the settings sheet over this page, or closes it when open (design system:
    /// SettingsSheet). Opening writes <c>?settings=open</c> as a new history entry on the same
    /// page, so Back closes it and the page and its player stay. The module calls it for a clicked
    /// link to the plain <c>/settings</c> page (the app bar, the bottom bar, the account menu).
    /// </summary>
    [JSInvokable]
    public Task ToggleSettingsAsync()
    {
        if (SettingsOpen)
            return CloseSettingsAsync();

        if (OnSettingsPage)
            return Task.CompletedTask;

        string target = SettingsSheetUrl.Open(Navigation.Uri);
        _pushedSettingsUri = Navigation.ToAbsoluteUri(target).AbsoluteUri;
        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Closes the sheet once. An entry this circuit pushed is undone with a step back through
    /// history, so Back never reopens it; a shared or reloaded <c>?settings=open</c> is replaced.
    /// </summary>
    private async Task CloseSettingsAsync()
    {
        if (!SettingsOpen || _closingSettings)
            return;

        _closingSettings = true;
        if (string.Equals(new Uri(Navigation.Uri).AbsoluteUri, _pushedSettingsUri, StringComparison.Ordinal))
        {
            try
            {
                await JS.InvokeVoidAsync("history.back");
                return;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                Logger.LogDebug(ex, "Could not go back to close the settings sheet.");
            }
        }

        Navigation.NavigateTo(SettingsSheetUrl.Close(Navigation.Uri), replace: true);
    }

    /// <summary>Closes the temporary drawer; the module calls it on Escape.</summary>
    [JSInvokable]
    public Task CloseModalDrawer()
    {
        if (!_modalOpen)
            return Task.CompletedTask;

        _modalOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SetUpdatesPaused(bool paused)
    {
        if (_updatesPaused == paused)
            return Task.CompletedTask;

        _updatesPaused = paused;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SetReconnectModalVisible(bool visible)
    {
        if (_reconnectModalVisible == visible)
            return Task.CompletedTask;

        _reconnectModalVisible = visible;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InvokeModuleAsync(string identifier, params object[] args)
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so there is no browser state left to update.
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "App shell call {Identifier} failed.", identifier);
        }
    }

    private void OnPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    // Picking a recording closes the open library, and ShowLibraryAsync's own navigation opens
    // it. Below Md any navigation closes the temporary drawer; Md and up the overlay stays open
    // while only the query changes (a filter chip, the search, the sort), so the library can be
    // filtered while it is open.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        string previous = _location;
        _location = e.Location;
        _history.Visit(e.Location);
        _closingSettings = false;
        bool arrived = string.Equals(
            new Uri(e.Location).AbsoluteUri, _openModalOnArrivalAt, StringComparison.Ordinal);
        // A query-only change is a view change (search, filter, sort), not a new page: keep the
        // library open at every width. On a phone it is now where the search field lives, so
        // closing it on the first keystroke would make search impossible. A path change
        // (picking a recording, Settings) still closes it.
        bool samePage = string.Equals(
            new Uri(previous).AbsolutePath, new Uri(e.Location).AbsolutePath, StringComparison.Ordinal);
        _modalOpen = arrived || (_modalOpen && samePage);
        _openModalOnArrivalAt = null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        Preferences.Changed -= OnPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            await InvokeModuleAsync("dispose");
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, so there is no browser state left to release.
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "The app shell JavaScript module was already disconnected.");
            }
        }

        _self?.Dispose();
    }
}
