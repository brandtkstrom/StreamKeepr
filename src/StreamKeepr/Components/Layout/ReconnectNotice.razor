@* "Live updates paused" outside the drawer, for a paused library feed while the circuit is up
   (sk:updates-paused). The same MudAlert as the drawer's note (design system Feedback card);
   its Retry is served by reconnect.js like every reconnect action. Never shown together with
   the reconnect modal. *@
@if (Visible && !ModalVisible)
{
    <MudBlazor.MudAlert Severity="MudBlazor.Severity.Warning"
                        Variant="MudBlazor.Variant.Text"
                        Dense="true"
                        Icon="@MudBlazor.Icons.Material.Rounded.CloudOff"
                        Class="sk-reconnect-notice sk-alert-action"
                        role="status"
                        data-reconnect-notice>
        <span class="msg">@Message</span>
        <MudBlazor.MudButton Variant="MudBlazor.Variant.Text"
                             Size="MudBlazor.Size.Small"
                             Color="MudBlazor.Color.Inherit"
                             data-reconnect-retry>Retry</MudBlazor.MudButton>
    </MudBlazor.MudAlert>
}

@code {
    [Parameter] public bool Visible { get; set; }

    /// <summary>The template reconnect modal owns the hard-disconnect state.</summary>
    [Parameter] public bool ModalVisible { get; set; }

    [Parameter] public string Message { get; set; } = "Live updates paused.";
}
