<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamKeepr</RootNamespace>
    <UserSecretsId>stream-keepr</UserSecretsId>
    <!--
      Temporary Debug-only workaround: SDK 10.0.201 emits gzip static-asset endpoints that
      MapStaticAssets serves with an empty body in Debug builds. Release/publish compression is
      unchanged. Remove when the SDK serves compressed build assets correctly.
    -->
    <DisableBuildCompression Condition="'$(Configuration)' == 'Debug'">true</DisableBuildCompression>
    <!--
      The Web SDK infers this from .razor Content items, but the Dockerfile restores with only
      this file copied, so restore saw none and skipped the package that ships
      _framework/blazor.web.js. Without it the published app 404s that script and never goes
      interactive. Set explicitly so restore does not depend on which sources are present.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Twitch" Version="11.0.0" />
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <!-- The record store (ADR-0014). Design is for `dotnet ef` at build time and never flows on. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="MudBlazor" Version="[9.12.0]" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamKeepr.Tests" />
  </ItemGroup>

</Project>
