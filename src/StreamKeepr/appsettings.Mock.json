{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Twitch": {
    "ClientId": "mock-client-id",
    "ClientSecret": "mock-client-secret",
    "Channels": [],
    "PollIntervalSeconds": 10,
    "PollIntervalWithEventSubSeconds": 300
  },
  "Recorder": {
    "Quality": "best",
    "SegmentSeconds": 2,
    "HealthyPartSeconds": 5
  },
  "Storage": {
    "MinFreeGb": 1
  },
  "Auth": {
    "AllowedTwitchLogins": []
  },
  "Mock": {
    "Auth": {
      "SignedIn": true
    },
    "Seed": {
      "Enabled": true,
      "ResetOnStart": true
    },
    "Feed": {
      "Enabled": true,
      "TickSeconds": 5,
      "StartSeconds": 30,
      "EndSeconds": 60,
      "DeleteSeconds": 90
    }
  }
}
