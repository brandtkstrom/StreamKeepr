# Build output
**/bin/
**/obj/

# Version control and CI
.git/
.github/

# IDE and agent state
.vs/
.vscode/
.idea/
.agents/
.claude/
.serena/
.opencode/
**/*.user
*.sln.DotSettings.user

# Non-runtime projects and assets
StreamCaptureService/
StreamCaptureService.Tests/
design-system/
tests/
docs/

# Secrets and local data
**/secrets/
**/.env
**/.env.*
recordings/
.streamkeepr/
**/*.pem
**/*.key
**/*.pfx

# Compose and container descriptors are not build inputs
compose*.yaml
compose*.yml
Dockerfile*

# Repository metadata
*.md
AGENTS.md
GLOSSARY.md
LICENSE
.gitignore
.editorconfig
*.sln
*.slnx
*.binlog
TestResults/
**/TestResults/
**/node_modules/

# MonoLisa woff2 files are git-ignored but included when present in a private
# working-tree build. Never publish an image built from a checkout that contains
# them; a fresh clone has no MonoLisa binaries.
