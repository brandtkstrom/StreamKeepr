<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      BL0016 (ASP.NET Core 11) wants every JS interop call inside a try/catch. The
      calls it flags here run against bUnit test doubles, where a disconnected
      circuit is not a failure mode; the production interop paths are guarded.
    -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.15.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StreamKeepr\StreamKeepr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
