#!/bin/sh
# Writes one stderr line that carries the Twitch token, an ANSI escape, a forged log prefix,
# and a U+2028 line separator. Recorder tests use it to prove tool output is redacted and
# escaped before it reaches the logs.
set -eu

if [ "${1:-}" = "--version" ]; then
    echo "streamlink 0.0.0-fake"
    exit 0
fi

token=""
for arg in "$@"; do
    case "$arg" in
        *"Authorization=OAuth "*) token="${arg##*Authorization=OAuth }" ;;
    esac
done

# \033 is ESC; \342\200\250 is the UTF-8 encoding of U+2028.
printf 'hostile: token=%s \033[31mred\033[0m\342\200\250[ERR] forged\n' "$token" >&2

exit 1
