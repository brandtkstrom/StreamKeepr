#!/bin/sh
# Answers --version so startup preflight passes, then fails every recording with a clear error.
# Recorder tests use it to prove a broken Streamlink surfaces in RecorderExited.Detail.
set -eu

if [ "${1:-}" = "--version" ]; then
    echo "streamlink 0.0.0-broken"
    exit 0
fi

echo "fake-streamlink-broken: simulated streamlink failure" >&2
exit 1
