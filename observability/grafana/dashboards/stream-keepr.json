{
  "uid": "streamkeepr-overview",
  "title": "Stream Keepr",
  "tags": [
    "streamkeepr"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "description": "service is StreamKeeprTelemetry.ServiceName; keep it in step with observability/otel-collector.yaml.",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "constant",
        "hide": 2,
        "query": "streamkeepr",
        "description": "StreamKeeprTelemetry.ServiceName",
        "current": {
          "text": "streamkeepr",
          "value": "streamkeepr"
        }
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "Verbose,Debug,Information,Warning,Error,Fatal",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [],
  "annotations": {
    "list": [
      {
        "name": "App start and stop",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{service_name=\"$service\"} | SourceContext=\"StreamKeepr.Hosting.HostLifecycleLog\""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Liveness (/health/live)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(httpcheck_status{http_url=\"http://stream-keepr:8080/health/live\",http_status_class=\"2xx\"}) or vector(-1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "-1": {
                  "text": "NO DATA",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Collector http_check probe every 15 s. NO DATA: no probe result in the last 5 minutes (collector or app down). Readiness stays UP while a check is Degraded; see 'Degraded or unhealthy health checks'."
    },
    {
      "id": 3,
      "title": "Readiness (/health/ready)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(httpcheck_status{http_url=\"http://stream-keepr:8080/health/ready\",http_status_class=\"2xx\"}) or vector(-1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "-1": {
                  "text": "NO DATA",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Collector http_check probe every 15 s. NO DATA: no probe result in the last 5 minutes (collector or app down). Readiness stays UP while a check is Degraded; see 'Degraded or unhealthy health checks'."
    },
    {
      "id": 4,
      "title": "Free recording space",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(streamkeepr_storage_free_bytes{service_name=\"$service\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10737418240
              },
              {
                "color": "green",
                "value": 21474836480
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Red below 10 GiB (Storage:MinFreeGb default: recording is refused), orange below 20 GiB (2 x MinFreeGb: the disk health check is Degraded). Adjust if MinFreeGb changes."
    },
    {
      "id": 5,
      "title": "Twitch poll age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(streamkeepr_twitch_poll_age_seconds{service_name=\"$service\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 330
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Seconds since the last Helix poll. Polls run every 30 s while recording or without full EventSub coverage, and every 300 s with it. Orange past 330 s, red past 600 s."
    },
    {
      "id": 6,
      "title": "Degraded or unhealthy health checks",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (HealthCheckName, HealthStatus) (count_over_time({service_name=\"$service\"} | EventId_Name=\"HealthCheckEnd\" | HealthStatus!=\"Healthy\" [$__auto]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{HealthCheckName}}: {{HealthStatus}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "description": "From DefaultHealthCheckService log events, one per failing check per probe. /health/ready answers 200 while a check is Degraded, so the probe tiles cannot show this.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 6
      }
    },
    {
      "id": 7,
      "title": "Health probe latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "max by (http_url) (httpcheck_duration_milliseconds)",
          "legendFormat": "{{http_url}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Twitch",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "EventSub push coverage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "max(streamkeepr_twitch_push_coverage_ratio{service_name=\"$service\"})",
          "legendFormat": "covered",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "EventSub connected",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "max(streamkeepr_eventsub_connected_ratio{service_name=\"$service\"})",
          "legendFormat": "connected",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "EventSub reconnects (per hour)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (eventsub_transport) (increase(streamkeepr_eventsub_reconnects_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "{{eventsub_transport}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "EventSub and chat connection events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"$service\"} | SourceContext=~\"StreamKeepr\\\\.Infrastructure\\\\.Twitch\\\\.(EventSubClient|PollSchedule|WebSocketEventSubBinding|ConduitEventSubBinding|Chat\\\\.IrcChatClient|Chat\\\\.ChatCaptureService)\" | severity_number >= 9",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Information and above. The line is the message template; expand a line for its values (Reason, State, Transport).",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Recorder",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "title": "Channels by DVR state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (dvr_state) (streamkeepr_dvr_channels{service_name=\"$service\"})",
          "legendFormat": "{{dvr_state}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Recorder events (per hour)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (recorder_exit_kind) (increase(streamkeepr_recorder_parts_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "parts: {{recorder_exit_kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(streamkeepr_recorder_stalls_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "stalls",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(streamkeepr_recorder_force_kills_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "force kills",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 16,
      "title": "Part duration p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(streamkeepr_recorder_part_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streamkeepr_recorder_part_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Part size p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(streamkeepr_recorder_part_size_bytes_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streamkeepr_recorder_part_size_bytes_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Chat drops and export jobs (per hour)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(streamkeepr_chat_dropped_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "chat messages dropped",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (export_outcome) (increase(streamkeepr_export_jobs_total{service_name=\"$service\"}[1h]))",
          "legendFormat": "exports: {{export_outcome}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 19,
      "title": "Channel state changes",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"$service\"} | SourceContext=~\"StreamKeepr\\\\.Channel\\\\..+\" | line_format \"{{.Channel}}: {{.From}} -> {{.To}} on {{.Event}}\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "DVR transitions per channel, rendered from the event's From/To/Event values. Channel logins stay out of metric labels by design, so this is the per-channel view.",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 20,
      "title": "Recorder parts",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"$service\"} | SourceContext=\"StreamKeepr.Infrastructure.Media.RecorderJob\" | severity_number >= 9 | line_format \"{{ if .Kind }}{{.Job}} finished ({{.Kind}}) with {{.Bytes}} bytes: {{.Detail}}{{ else if .Part }}{{.Job}} started part {{.Part}} for {{.Channel}}{{ else }}{{__line__}}{{ end }}\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Part starts and finishes, and recorder warnings (shown as their message template). Debug progress and tool output are excluded. Expand a line for every value.",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 22,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\",http_route!~\"_framework/.*|_content/.*|.*\\\\.(js|mjs|css|map|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|woff|woff2|ttf|otf)\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{http_route}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Static assets are excluded: their fingerprinted routes change with every build. /health, /media and /_blazor are not measured at all (TelemetryPaths)."
    },
    {
      "id": 23,
      "title": "Request latency p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",http_route!~\"_framework/.*|_content/.*|.*\\\\.(js|mjs|css|map|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|woff|woff2|ttf|otf)\"}[$__rate_interval])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",http_route!~\"_framework/.*|_content/.*|.*\\\\.(js|mjs|css|map|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|woff|woff2|ttf|otf)\"}[$__rate_interval])))",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Static assets are excluded: their fingerprinted routes change with every build. /health, /media and /_blazor are not measured at all (TelemetryPaths)."
    },
    {
      "id": 24,
      "title": "Outbound HTTP calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (server_address, http_response_status_code) (rate(http_client_request_duration_seconds_count{service_name=\"$service\",server_address!=\"otel-collector\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{server_address}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Twitch Helix, OAuth, EventSub and IRC WebSocket upgrades (101), and emote providers. The app's own OTLP exports to otel-collector are excluded."
    },
    {
      "id": 25,
      "title": "Connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(aspnetcore_components_circuit_active{service_name=\"$service\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Blazor circuits"
        },
        {
          "expr": "sum(signalr_server_active_connections{service_name=\"$service\"})",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "SignalR connections"
        },
        {
          "expr": "sum(kestrel_active_connections{service_name=\"$service\"})",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Kestrel connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Open browser sessions (Blazor circuits) and the connections that carry them.",
      "gridPos": {
        "x": 12,
        "y": 61,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 26,
      "type": "row",
      "title": ".NET runtime",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 27,
      "title": ".NET runtime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(dotnet_process_memory_working_set_bytes{service_name=\"$service\"})",
          "legendFormat": "working set",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(dotnet_gc_last_collection_heap_size_bytes{service_name=\"$service\"})",
          "legendFormat": "GC heap",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 28,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(dotnet_process_cpu_time_seconds_total{service_name=\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "app process"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "CPU cores used by the .NET process (user + system). Streamlink and FFmpeg are child processes and are not included.",
      "gridPos": {
        "x": 8,
        "y": 70,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 29,
      "title": "Exceptions by type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(dotnet_exceptions_total{service_name=\"$service\"}[$__rate_interval]) * 60)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "First-chance exceptions per minute, handled ones included. A steady baseline of IOException and OperationCanceledException is cancelled I/O; look for new types or jumps.",
      "gridPos": {
        "x": 16,
        "y": 70,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Logs and traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 78,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "title": "Warnings and errors",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (severity_text, SourceContext) (count_over_time({service_name=\"$service\"} | severity_text=~\"Warning|Error|Fatal\" [$__auto]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{severity_text}} {{SourceContext}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "description": "Split by logger, so a repeating warning (for example a Degraded health check on every probe) names its source."
    },
    {
      "id": 32,
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 85,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "{service_name=\"$service\"} | severity_text=~\"$level\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 33,
      "title": "Errored traces",
      "type": "table",
      "datasource": {
