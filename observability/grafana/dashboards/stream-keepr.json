          "limit": 20,
          "tableType": "traces",
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 97,
        "w": 12,
        "h": 10
      }
    },
