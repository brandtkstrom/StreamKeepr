# Optional. Copy to .env next to compose.yaml; Docker Compose reads it automatically.
# Do not put secrets here: the Twitch client ID, secret, and token go in ./secrets.

# Image tag to run: a release such as 1.0.0, or "latest" to follow main.
STREAMKEEP_VERSION=1.0.0

# Host port for the web UI (container port 8080).
STREAMKEEP_PORT=8080

# Time zone for log timestamps, e.g. Europe/Berlin or America/New_York.
TZ=UTC
